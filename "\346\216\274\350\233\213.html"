  if(ctx.oppRemain !== undefined && ctx.oppRemain <= 6)
    return {t:'进攻 —— 对手牌少，用最省的牌型压住，别给他垫牌的机会', cls:'atk'};
  return {t:'进攻 —— 用最小的牌型压住，保留逢人配和炸弹做后手', cls:'atk'};
}
function situationText(st, seat, ctx, threat, race, memo){
  var partner = partnerOf(seat), lines = [];
  if(st.phase !== 'play'){
    lines.push({k:'局面', v:'本局已结束，等待升级结算', cls:''});
  }else if(race.leader){
    lines.push({
      k:'头游争夺',
      v: seatName(race.leader.seat) + ' 剩 ' + race.leader.left + ' 张，领先',
      cls: teamOf(race.leader.seat) === teamOf(seat) ? 'good' : 'bad'
    });
  }
  var pt;
  if(st.phase !== 'play') pt = '看升级结算与下一局级牌';
  else if(st.trick && st.trick.seat === partner && ctx.partnerRemain <= 6 &&
          !p15PartnerHandoff(st, seat, legalMoves(st, seat), ctx))
    pt = '对家正在压牌且只剩 ' + ctx.partnerRemain + ' 张 → 别抢，送他走完，他出头游你就有二游';
  else if(st.trick && st.trick.seat === partner &&
          p15PartnerHandoff(st, seat, legalMoves(st, seat), ctx))
    pt = '对家正在压牌，但他还剩 ' + ctx.partnerRemain + ' 张、你只有 ' +
         (st.hands[seat] || []).length + ' 张 → 这轮该你接，牌权在你手里才推得动';
  else if(st.trick && st.trick.seat === partner)
    pt = '对家正在压牌（剩 ' + ctx.partnerRemain + ' 张）→ 不压自己人，把出牌权留给他';
  else if(!st.trick && ctx.partnerRemain <= 4)
    pt = '对家只剩 ' + ctx.partnerRemain + ' 张 → 领出时挑小牌，把出牌权让给他';
  else if(!st.trick && ctx.minOpp <= 3)
    pt = '对手最少只剩 ' + ctx.minOpp + ' 张 → 别大炮打蚊子，留大牌收尾';
  else pt = '暂无特殊配合，按常规牌型推进';
  lines.push({k:'队友配合', v:pt, cls:''});
  /* 炸弹存量：只报总量 + 最多 3 个重点点数，避免刷屏 */
  var tl = threat.list, tTxt;
  if(!tl.length) tTxt = '未知牌里凑不出炸弹，放心推进';
  else{
    var names = tl.map(function(t){ return t.rank === '王' ? '天王炸' : rankLabel(t.rank); });
    tTxt = '约 ' + threat.total + ' 个潜在炸弹';
    tTxt += names.length > 3 ? '（重点防 ' + names.slice(0,3).join('、') + '）' : '（' + names.join('、') + '）';
  }
  lines.push({
    k:'炸弹存量', v:tTxt,
    cls: threat.total >= 3 ? 'bad' : threat.total >= 1 ? 'warn' : 'good'
  });
  lines.push({
    k:'记牌器要点',
    v:'大王未知 ' + memo[0].unknown + ' 张，逢人配未知 ' + memo[2].unknown + ' 张',
    cls: memo[2].unknown === 0 ? 'good' : 'warn'
  });
  return {lines:lines, strategy:strategyLine(st, seat, ctx, race)};
}
/** 建议里提到逢人配时，把「花得值不值」说清楚。
 *  旧文案写的是「能用但这轮没必要」，一边说没必要，一边又把它排第一，自己打自己脸。 */
function wildNote(hand, level, ctx, n){
  var f = (ctx && ctx.flushes) || [], i, cnt = {}, r, need = false;
  for(i=0;i<f.length;i++) if(f[i].wilds > 0){ need = true; break; }
  if(!need){
    for(i=0;i<hand.length;i++){
      var c = hand[i];
      if(c.joker || isWild(c, level)) continue;
      cnt[c.rank] = (cnt[c.rank] || 0) + 1;
    }
    for(r in cnt) if(cnt[r] === 3){ need = true; break; }
  }
  return need
    ? '（这手要用 ' + n + ' 张逢人配，它本来还能补炸弹或同花顺，用之前想清楚）'
    : '（用掉 ' + n + ' 张逢人配，这手牌里没有靠它能补成的炸弹或同花顺，花得值）';
}
/** 生成 1~3 条带理由的出牌方案（全部依据当前真实牌局动态计算） */
function buildPlans(st, seat, hand, moves, ctx, groups){
  var level = st.level, partner = partnerOf(seat), plans = [], i;
  if(st.phase !== 'play')
    return [{rank:1, title:'本局已结束', action:'none', reason:'等升级结算，看下一局级牌。', cards:[]}];

  var bestOut = null;
  for(i=0;i<moves.length;i++) if(moves[i].cards.length === hand.length){ bestOut = moves[i]; break; }
  if(bestOut){
    plans.push({
      rank:1, title:'一把走完：' + infoLabel(bestOut.info, level), action:'play', cards:bestOut.cards,
      reason:'你手上 ' + hand.length + ' 张正好是一副合法的 ' + TYPE_NAME[bestOut.info.type] +
             '。出完就是头游，别再想拆牌换牌型 —— 掼蛋里能一把走的机会不多，遇到了就果断。'
    });
    return plans;
  }
  var bombs   = groups.filter(function(g){ return g.type === 'BOMB'; }).length;
  var singles = groups.filter(function(g){ return g.type === 'SINGLE'; })[0];
  var wildN   = hand.filter(function(c){ return isWild(c, level); }).length;

  if(!st.trick){
    /* ---- 领出阶段 ---- */
    var scored = moves.map(function(mv){ return {m:mv, s:leadScore(mv, hand, level, ctx)}; })
                      .sort(function(a,b){ return b.s - a.s; });
    var top = scored[0], why;
    if(top){
      if(top.m.info.type === 'BOMB' || top.m.info.type === 'STRAIGHT_FLUSH' || top.m.info.type === 'JOKER_BOMB'){
        why = '两家对手最少只剩 ' + ctx.minOpp + ' 张，这时 ' + TYPE_NAME[top.m.info.type] + '（' +
              top.m.info.len + ' 张）能一次封住所有普通牌型，对手只能过，你就重新拿回出牌权收尾。';
      }else if(top.m.info.type === 'SINGLE'){
        why = '领出单张 ' + cardsLabel(top.m.cards, level) + '：按已出的牌挑一张不喂下家小牌、' +
              '也不浪费最大守关牌的（口诀「哪张牌先下，倒数第二大」），把 ' + bombs +
              ' 个炸弹和大牌留在手里做回手。' + (wildN ? '手上还有 ' + wildN + ' 张逢人配，更不能单打出去。' : '');
      }else{
        why = '领出阶段优先走 ' + TYPE_NAME[top.m.info.type] + '，把 ' + top.m.cards.length +
              ' 张小牌一次性走掉，手里剩 ' + (hand.length - top.m.cards.length) + ' 张；' +
              '保留 ' + bombs + ' 个炸弹控场' +
              (top.m.wilds ? wildNote(hand, level, ctx, top.m.wilds) : '') + '。';
      }
      plans.push({rank:1, title:'领出：' + infoLabel(top.m.info, level), action:'play', cards:top.m.cards, reason:why});
    }
    if(scored[1] && top && top.s - scored[1].s < 14 && scored[1].m.info.type !== top.m.info.type){
      plans.push({
        rank:2, title:'备选：' + infoLabel(scored[1].m.info, level), action:'play', cards:scored[1].m.cards,
        reason:'和首选强度接近。若你想把 ' + TYPE_NAME[top.m.info.type] + ' 留到后面控场，可以先用这手把手牌摊开。'
      });
    }
    if(ctx.partnerRemain <= 5 && ctx.partnerRemain <= ctx.minOpp){
      var feed = pickFeedPartner(st, seat, moves);
      if(feed && feed.ok){
        plans.push({
          rank:3, title:'送对家：出小牌 ' + cardsLabel(feed.cards, level),
          action:'play', cards:feed.cards,
          reason:'对家只剩 ' + ctx.partnerRemain + ' 张、而且领先，他出头游你稳拿二游。' +
                 '按已出过的牌算，外面比这张大的还有 ' + feed.bigger + ' 张，摊到他手里大约 ' +
                 feed.expect.toFixed(1) + ' 张，接得住的把握不小，他接过去就能一口气走完。' +
                 '这个判断只看桌面公开信息和他剩几张，<b>没看他的牌</b>，你自己打牌时也能这么估。'
        });
      }else if(feed && !feed.ok){
        /* 领出阶段不能过牌，所以给"出最小牌探路"而不是"不要" */
        var probe = null;
        for(i=0;i<moves.length;i++){
          if(moves[i].info.type !== 'SINGLE') continue;
          if(!probe || moves[i].info.key < probe.info.key) probe = moves[i];
        }
        if(probe) plans.push({
          rank:3, title:'不送对家，出最小的 ' + cardsLabel(probe.cards, level) + ' 探路',
          action:'play', cards:probe.cards,
          reason:'对家剩 ' + ctx.partnerRemain + ' 张想走头游，但按已出的牌算，外面比最小牌大的只剩 ' +
                 feed.bigger + ' 张，他未必接得住。' +
                 '硬塞小牌等于让他白拿一轮、主动权反而落到对手手里。注意<b>领出阶段不能过牌</b>，' +
                 '所以改为出最小的一张探路，等对手先动再决定怎么压。'
        });
      }
    }
    if(!plans.length) plans.push({rank:1, title:'不要，等下一轮', action:'pass', reason:'当前没有合适的出牌方案。', cards:[]});
    return plans.slice(0,3);
  }

  if(st.trick.seat === partner){
    /* ---- 队友压着：默认送对家，但我才是主攻的时候要接 ---- */
    var hf = p15PartnerHandoff(st, seat, moves, ctx);
    var hfRank = 1;
    if(hf){
      plans.push({
        rank:1, title:'接过来：这轮该我走', action:'play', cards:hf.cards, reason:hf.reason
      });
      hfRank = 2;
    }
    plans.push({
      rank:hfRank, title:'不要，让对家继续压', action:'pass', cards:[],
      reason:'压自己人只会抢掉队友的出牌权，而且他只剩 ' + ctx.partnerRemain + ' 张，比你更需要这轮主动权。' +
             (ctx.partnerRemain <= 6 ? '他已经接近走完，本轮一定要过。' : '你有 ' + hand.length + ' 张，有的是机会重新领出。')
    });
    if(!hf){
      var cheap = null;
      for(i=0;i<moves.length;i++){
        var t = moves[i].info.type;
        if(t !== 'SINGLE' && t !== 'PAIR') continue;
        if(!cheap || moves[i].info.key < cheap.info.key) cheap = moves[i];
      }
      if(cheap) plans.push({
        rank:2, title:'例外：用 ' + infoLabel(cheap.info, level) + ' 顶一下',
        action:'play', cards:cheap.cards,
        reason:'只有在队友明显走不动、或他这手牌小到需要你顶（比如他出了单张 3）时才考虑。正常对局里，队友压牌你就过。'
      });
    }
    return plans.slice(0,3);
  }

  /* ---- 对手压着 ---- */
  var oppRemain = st.hands[st.trick.seat].length;
  ctx.oppRemain = oppRemain;
  var sc = moves.map(function(mv){ return {m:mv, s:followScore(mv, hand, level, ctx)}; })
                 .sort(function(a,b){ return b.s - a.s; });
  if(!sc.length){
    plans.push({
      rank:1, title:'压不过，不要', action:'pass', cards:[],
      reason:'上家这手是 ' + TYPE_NAME[st.trick.info.type] + '，你手上没有能压的牌型（本轮过牌不扣牌）。留好 ' +
             bombs + ' 个炸弹和 ' + wildN + ' 张逢人配，等下一轮。'
    });
    return plans;
  }
  var b = sc[0].m;
  /* 只有 4/5 张炸弹和同花顺属于"值得留的威慑"；
     6 张及以上大炸和王炸是顶级牌，关键时刻该用就用，不能一味藏着。 */
  var bHeavy = (b.info.type === 'BOMB' && b.info.len <= 5) || b.info.type === 'STRAIGHT_FLUSH';
  if(bHeavy && !mustBlock(st, oppRemain)){
    plans.push({
      rank:1, title:'不要，留炸控尾', action:'pass', cards:[],
      reason:'上家剩 ' + oppRemain + ' 张，还不危险。现在用 ' + TYPE_NAME[b.info.type] + '（'+ b.info.len +
             ' 张）去压，等于把最大的威慑提前打掉。这轮先过，等他剩 5 张、7 张或打出长牌冲刺时再拦，' +
             '炸弹要炸在关键节点上。'
    });
    if(sc[1]) plans.push({
      rank:2, title:'如果必须压：' + infoLabel(sc[1].m.info, level), action:'play', cards:sc[1].m.cards,
      reason:'这是除炸之外最省的一手，只在担心他这轮直接走完时使用。'
    });
  }else{
    var why2;
    if(oppRemain <= 6){
      why2 = '对手只剩 ' + oppRemain + ' 张。本轮不要拆顺子去压、留炸控尾；但他这手牌便宜的话，用最小的 ' +
             TYPE_NAME[b.info.type] + ' 顶回去，逼他再出一手，反而能拖住他。';
    }else{
      why2 = '按「出完这手后余牌整不整齐」挑了 ' + TYPE_NAME[b.info.type] + '（' +
             cardsLabel(b.cards, level) + '）压住，保住 ' + bombs + ' 个炸弹和 ' + wildN +
             ' 张逢人配做后手。对手还早时不必逢牌就压，大牌留着卡他冲刺那一手。';
    }
    plans.push({rank:1, title:'按余牌结构挑一手 ' + TYPE_NAME[b.info.type] + ' 压住', action:'play', cards:b.cards, reason:why2});
    if(oppRemain <= 6 && sc[1] && sc[1].m.info.type !== b.info.type){
      plans.push({
        rank:2, title:'不要，让这轮过去', action:'pass', cards:[],
        reason:'他只剩 ' + oppRemain + ' 张，你出牌只会帮他缩小范围 —— 他要的就是有人给他垫牌。本轮过，等他领出时再用大牌一次收。'
      });
    }
  }
  if(!plans.length) plans.push({rank:1, title:'不要，等下一轮', action:'pass', cards:[], reason:'当前没有合适的出牌方案，本轮过牌保留手牌结构。'});
  return plans.slice(0,3);
}
/** 教学面板主入口：手牌解析 + 出牌建议 + 局势分析 */
function teach(st, seat){
  seat = seat === undefined ? 0 : seat;
  var hand = st.hands[seat], partner = partnerOf(seat);
  var groups = decomposeHand(hand, st.level);
  var usage  = wildUsage(hand, st.level);
  var moves  = legalMoves(st, seat);
  var ctx = makeCtx(st, seat);   /* 教学建议与 AI 用同一套公开信息，口径不打架 */
  var memo   = memoRows(st, seat);
  var threat = bombThreat(st, seat);
  var race   = raceInfo(st, seat);
  var plans  = buildPlans(st, seat, hand, moves, ctx, groups);
  /* P15 策略层的全部输出：牌力分档、角色、记牌（谁出的）、上限推断、
     下家防守点位、同花顺组不组、残局原则命中。教学面板直接读这里。 */
  var oppSeats = [(seat + 1) % 4, (seat + 3) % 4];
  var p15 = {
    power: ctx.ps, score: ctx.score, raw: ctx.roleInfo.raw, cut: ctx.roleInfo.cut,
    band: ctx.band, role: ctx.roleInfo.role, roleWhy: ctx.roleInfo.why,
    fit: ctx.fit, who: bigMemoWho(st, seat), ceil: ctx.ceil,
    def: ctx.def, readRoles: ctx.readRoles,
    flush: flushVerdict(hand, st.level),
    late: lateHits(st, seat, ctx),
    infer: oppSeats.map(function(s){
      var rr = ctx.readRoles[s] || {role:'unknown'};
      var hasBomb = ctx.ceil.maxBomb > 0 && st.hands[s].length <= 10;
      return {seat:s, remain:st.hands[s].length, hasBomb:hasBomb, role:rr.role,
              roleWhy:rr.why, shape:inferShape(st.hands[s].length, rr.role, hasBomb)};
    })
  };
  return {
    level:st.level, playing:st.phase === 'play',
    groups:groups, usage:usage, plans:plans, memo:memo, threat:threat, race:race,
    situation:situationText(st, seat, ctx, threat, race, memo),
    p15:p15
  };
}

