}
function groupLabelOf(cards){
  var info = R.identify(cards, st.level);
  var wildN = cards.filter(function(c){ return R.isWild(c, st.level); }).length;
  var base = (info && info.type !== 'SINGLE' && info.type !== 'NONE')
    ? R.infoLabel(info, st.level) : '自定 ' + cards.length + ' 张';
  /* 自己分的摞里若有配牌，组名上标出来，别让两张红桃配看着像普通对子 */
  if(wildN && !(info && (info.type === 'BOMB' || info.type === 'STRAIGHT_FLUSH')))
    return base + ' · 含 ' + wildN + ' 张配牌';
  return base;
}
/* 第一次手动改牌，只把开关打开，不再把程序自动拆的摞接过来当底稿。
   老板原话：他自己组的才算他组的，没组的一律按点数摆着等他处理。
   替他预拆一遍，等于把他没同意过的连对、对子、钢板硬塞成「自己分的摞」。 */
function ensureCustom(){
  customMode = true;
}
function handGroupsOf(hand){
  var groups = [], i;
  pruneGroups();
  if(customMode){
    var used = {};
    for(i=0;i<myGroups.length;i++){
      var ids = myGroups[i].ids, cards = hand.filter(function(c){ return ids.indexOf(c.id) >= 0; });
      cards.forEach(function(c){ used[c.id] = 1; });
      var info = R.identify(cards, st.level);
      /* gidx = 这一组在 myGroups 里的下标。未分组那块会插到数组最前面，
         data-hg 是显示顺序（含未分组），两者从此不是同一个数，必须分开记。 */
      groups.push({type:(info && info.type !== 'SINGLE') ? info.type : 'NONE',
                   label:groupLabelOf(cards), cards:cards, custom:true, gidx:i});
    }
    var loose = hand.filter(function(c){ return !used[c.id]; });
    if(loose.length){
      /* 没组的牌不再交给 decomposeHand 拆牌型，按点数从大到小一张张摊开。
         放在数组最前面（不是最后）：摞数一多，最后那块正好被手牌区高度裁掉，
         老板 2026-11-06 提的「一眼看不到没分组的牌」就是这么来的。 */
      groups.unshift({type:'NONE', custom:true, raw:true,
                   label:'未分组 ' + loose.length + ' 张 · 按点数摆着，等你组或不组',
                   cards:R.sortHand(loose, st.level, 'power')});
    }
  }else{
    groups = R.decomposeHand(hand, st.level) || [];
    var seen = {};
    groups.forEach(function(g){ (g.cards || []).forEach(function(c){ seen[c.id] = 1; }); });
    var rest = hand.filter(function(c){ return !seen[c.id]; });
    if(rest.length) groups = groups.concat([{type:'NONE', label:'散牌', cards:rest}]);
  }
  handGroupsCache = groups.map(function(g){
    return {type:g.type, label:g.label || R.TYPE_NAME[g.type] || '散牌',
            cards:(g.cards || []).slice(), custom:!!g.custom, raw:!!g.raw,
            gidx:g.gidx};
  });
  return handGroupsCache;
}
/* 分组视图：一组一块，块内牌全部摊开。
