  /* 2026-11-06 修：上一局的名次必须在清空 st.finished 之前留一份。
     旧版先把它清空、再在下面读 st.finished[3] 找末游，
     结果永远读到 -1，整块进贡还贡代码一次都没执行过。 */
  var prevFinished = (st.finished || []).slice();
  var hasPrev = (prevFinished.length === 4);
  st.roundNo++;
  /* 本局级牌归谁（庄家）：上一局头游那一方。首局双方都是 2，取谁都一样。
     2026-11-07 修：旧版拿「先出的那家」当庄家，可先出的人经常是进贡方（输家），
     一改按进贡规矩放人先出，级牌就会取成输家的，等于整局打错了级牌。
     庄家和先出是两件事，分开记。 */
  var levelHost = hasPrev ? prevFinished[0]
                : (opt.leadSeat !== undefined ? opt.leadSeat
                   : (st.leadSeat !== undefined ? st.leadSeat : 0));
  /* 先出默认：上一局头游。有进贡的话在下面改成进贡方，抗贡则仍由头游先出。
     首局没有名次，就用 newGame 随机定的那家。 */
  var leader = hasPrev ? prevFinished[0] : levelHost;
  if(!st.lv) st.lv = [2,2];
  st.level = st.lv[teamOf(levelHost)];
  st.levelOwner = levelHost;
  st.tribute = null;
  st.trick = null; st.trickHistory = []; st.passes = 0; st.trickNo = 0;
  st.finished = []; st.finishMeta = {}; st.played = [];
  st.moves = []; st.decisions = [];            /* 新一局，复盘记录清零（上一局已存快照） */
  st.phase = 'play';

  if(opt.firstDeal){
    st.hands = dealEven(shuffle(buildDeck(), st.rng));
  }else{
    var s;
    /* 收齐上一局全部 108 张（手上的 + 打出去的） */
    var pool = st.played.slice();
    for(s=0;s<4;s++) pool = pool.concat(st.hands[s]);
    if(pool.length !== 108) pool = buildDeck();           /* 兜底：局数异常时重发整副 */
    /* 2026-11-06 修：必须先洗完发下去，再在发好的牌上进贡还贡。
       旧版先按上一局的残牌算进贡、算完又把 108 张重洗一遍，
       贡出去的那张牌被洗回牌堆，头游一张也没拿到，进贡等于白做。 */
    st.hands = dealEven(shuffle(pool, st.rng));

    if(prevFinished.length === 4){
      var first  = prevFinished[0], second = prevFinished[1];
      var third  = prevFinished[2], last   = prevFinished[3];
      /* 三、四名是同一队 = 双下，两家都要进贡：末游贡头游，三游贡二游 */
      var isDouble = (teamOf(third) === teamOf(last));
      var pairs = isDouble
        ? [{from:last, to:first}, {from:third, to:second}]
        : [{from:last, to:first}];
      /* 抗贡：进贡方合计握两张大王就免贡。单贡看末游一家，双贡看两家合计。 */
      var bigJokers = 0;
      pairs.forEach(function(pr){
        bigJokers += st.hands[pr.from].filter(function(c){ return c.rank === 17; }).length;
      });
      if(bigJokers >= 2){
        st.tribute = {anti:true, from:last, to:first, items:[], leadWho:first,
          note:'进贡方握两张大王，抗贡，本局免贡，由头游先出'};
      }else{
        var items = [], nm = ['你','下家','对家','上家'];
        pairs.forEach(function(pr){
          var give = tributeCardOf(st.hands[pr.from], st.level);
          if(!give) return;
          st.hands[pr.from] = st.hands[pr.from].filter(function(c){ return c.id !== give.id; });
          st.hands[pr.to]   = st.hands[pr.to].concat([give]);
          var back = backCardOf(st.hands[pr.to], st.level, give.id);
          if(back && back.id !== give.id){
            st.hands[pr.to]   = st.hands[pr.to].filter(function(c){ return c.id !== back.id; });
            st.hands[pr.from] = st.hands[pr.from].concat([back]);
          }
          items.push({from:pr.from, to:pr.to, card:give, back:back});
        });
        /* 先出：抗贡由头游领出；单贡由进贡方先出；双贡由贡牌大的那家先出。
           官方原文只写了「抗贡则首圈由上游领出」，其余按民间主流打法。 */
        var leadWho = first;
        if(items.length === 1) leadWho = items[0].from;
        else if(items.length === 2){
          leadWho = items.slice().sort(function(a, b){
            return cardPower(b.card, st.level) - cardPower(a.card, st.level);
          })[0].from;
        }
        var noteParts = items.map(function(it){
          return nm[it.from] + ' 贡 ' + cardLabel(it.card, st.level) + ' 给 ' + nm[it.to] +
                 (it.back ? '（' + nm[it.to] + ' 还 ' + cardLabel(it.back, st.level) + '）' : '');
        });
        st.tribute = {
          anti:false, isDouble:isDouble,
          from:last, to:first,
          card:items[0] ? items[0].card : null,
          back:items[0] ? items[0].back : null,
          items:items,
          leadWho:leadWho,
          note:(isDouble ? '双下两家进贡：' : '') + noteParts.join('；')
        };
        /* 只有没被人为指定先手时才按进贡规矩来（测试与复盘会显式传 leadSeat） */
        if(opt.leadSeat === undefined) leader = leadWho;
      }
    }
  }
  /* 显式指定的先手优先级最高：测试用例、复盘重放要能钉死谁先出，
     不能被进贡规矩或上局名次改掉。界面正常打牌不传这个参数。 */
  if(opt.leadSeat !== undefined) leader = opt.leadSeat;
  st.turn = leader;
  st.leadSeat = leader;
}
function legalMoves(st, seat){
  var all = genMoves(st.hands[seat], st.level);
  if(!st.trick) return all;
  var t = st.trick.info;
  return all.filter(function(m){ return beats(m.info, t); });
}
/** 明牌复盘用的牌面快照：这一手决策之前，四家手里各有什么。
    只拷贝数组，不复制牌对象；牌对象整局里不会被改写，这样够用也省内存。
    2026-11-06 新增，之前打过的局没有这份数据，补不回来。 */
function handsSnap(st){
  return [st.hands[0].slice(), st.hands[1].slice(), st.hands[2].slice(), st.hands[3].slice()];
}
/** 尝试出牌 */
function tryPlay(st, seat, cards, reason){
  if(st.finished.indexOf(seat) >= 0) return {ok:false, why:'该玩家已出完'};
  if(st.turn !== seat) return {ok:false, why:'还没轮到该玩家'};
  var info = identify(cards, st.level);
  if(!info){
    /* 2026-11-07 对王改成同色口径之后，老板手选两张王可能一大一小。
       这类误选太容易发生，单独给一句能看懂的提示，不要只说「不是合法牌型」。 */
    if(cards.length === 2 && cards[0] && cards[1] && cards[0].joker && cards[1].joker &&
       cards[0].rank !== cards[1].rank)
      return {ok:false, why:'大小王各一张不成对，对王要两张同色（两小王或两大王）'};
    return {ok:false, why:'不是合法牌型'};
  }
  if(st.trick && !beats(info, st.trick.info))
    return {ok:false, why:'压不过当前的 ' + TYPE_NAME[st.trick.info.type]};
  var hand = st.hands[seat], ids = {}, i;
  var snap = handsSnap(st);          /* 必须在扣牌之前抓，回放要看的是出牌前的四家手牌 */
  for(i=0;i<cards.length;i++) ids[cards[i].id] = 1;
  for(i=0;i<cards.length;i++){
    if(!hand.some(function(c){ return c.id === cards[i].id; })) return {ok:false, why:'手牌里没有这张牌'};
  }
  st.hands[seat] = hand.filter(function(c){ return !ids[c.id]; });
  st.played = st.played.concat(cards);
  st.trick = {seat:seat, cards:cards, info:info};
  st.trickHistory.push({seat:seat, cards:cards, info:info});
  /* 复盘牌谱：记下这一手是谁、出的什么、出完还剩几张。
     reason 是 AI 当时的判断依据，2026-11-06 18:05 老板要求「把每一步的逻辑整理出来」才加的字段。
     不写进牌谱的话，复盘时只能看到出了什么，看不到为什么，等于没法验收 AI 的思路。 */
  if(st.moves && !st.noLog)
    st.moves.push({seat:seat, type:'play', cards:cards, info:info,
                   trickNo:st.trickNo, handLeft:st.hands[seat].length, hands:snap,
                   reason: reason || ''});
  st.passes = 0;
  if(st.hands[seat].length === 0){
    st.finished.push(seat);
    st.finishMeta[seat] = {cards:cards, info:info};
  }
  return {ok:true, info:info};
}
/** 推进到下一位需要出牌的人；一轮打完自动由最大者重新领出 */
function rotate(st, seat){
  /* 双下立即收局（老板 2026-11-06 21:38 第一局第 100 手）。
     我方两家（0 号本人 + 2 号对家）先后走完，剩下两家全是对手，
     名次已经定死：我方头游二游、对方三游末游，这就是双下。
     旧版只认 finished.length >= 3，双下之后还要让剩下两家硬打两轮，
     白出十几手牌才收局，属于流程错，不是牌理错。
     补齐三游、末游按「手上剩几张」排，少的在前；结算只看头游二游是否同队，
     所以这个排序不影响升级，只影响展示和进贡对象。 */
  if(st.finished.length >= 2 && st.finished.length < 3){
    var t0 = teamOf(st.finished[0]), allSame = true, q, rem;
    for(q = 1; q < st.finished.length; q++)
      if(teamOf(st.finished[q]) !== t0) allSame = false;
    if(allSame){
      rem = [];
      for(q = 0; q < 4; q++) if(st.finished.indexOf(q) < 0) rem.push(q);
      rem.sort(function(a,b){ return st.hands[a].length - st.hands[b].length; });
      for(q = 0; q < rem.length; q++){
        st.finished.push(rem[q]);
        st.finishMeta[rem[q]] = {auto:true, doubleDown:true};
      }
      st.phase = 'roundEnd';
      st.turn = -1;
      return;
    }
  }
  if(st.finished.length >= 3){
    var rest = -1, s;
    for(s=0;s<4;s++) if(st.finished.indexOf(s) < 0) rest = s;
    if(rest >= 0){ st.finished.push(rest); st.finishMeta[rest] = {auto:true}; }
    st.phase = 'roundEnd';
    st.turn = -1;
    return;
  }
  var active = 4 - st.finished.length;
  /* 这一轮要几家人点头才算打完，不能一律 active - 1。
     老板 2026-11-06 第 95 手抓的硬错误：本人出完最后一张 4，在场只剩 1/2/3 三家，
     active = 3，active - 1 = 2，于是下家过、对家过就算过完，
     上家一次都没被问过就被接风跳过去了。他手里有 J 能压，本该他出。
     根子在于：active 是「还在场的人数」，不含已经走完的出牌那家。
     出牌那家走完了，他本来就不表态，所以在场的每一家都要问，要 active 个；
     出牌那家还在场，他自己不用问自己，才要 active - 1 个。 */
  var needPass = active - 1;
  if(st.trick && st.finished.indexOf(st.trick.seat) >= 0) needPass = active;
  if(st.trick && st.passes >= needPass){
    var leader = st.trick.seat;
    st.trick = null; st.passes = 0; st.trickHistory = []; st.trickNo++;
    /* 接风：本轮最大的一家如果已经出完牌，领出权交给他的同伴（对家），不是交给下家。
       旧版这里写的是 nextActiveSeat(leader)，等于把出牌权白送给对手，
       跟掼蛋「搭档接风」的规矩正好相反。同伴也走完了才顺延到下一位。 */
    if(st.finished.indexOf(leader) >= 0){
      var mate = partnerOf(leader);
      leader = (st.finished.indexOf(mate) < 0) ? mate : nextActiveSeat(st, mate);
    }
    st.turn = leader;
    st.leadSeat = leader;
    return;
  }
  st.turn = nextActiveSeat(st, seat);
}
function tryPass(st, seat, reason){
  if(st.finished.indexOf(seat) >= 0) return {ok:false, why:'该玩家已出完'};
  if(st.turn !== seat) return {ok:false, why:'还没轮到该玩家'};
  if(!st.trick) return {ok:false, why:'本轮由你领出，必须出牌'};
  st.passes++;
  if(st.moves && !st.noLog)
    st.moves.push({seat:seat, type:'pass', cards:[], info:null,
                   trickNo:st.trickNo, handLeft:st.hands[seat].length, hands:handsSnap(st),
                   reason: reason || ''});
  return {ok:true};
}
/** 升级结算：只有头游那一方升，输的那一方一级都不动。
 *
 *  老板 2026-11-07 抓的错：我方打出对手双下（头游 对家、二游 你），
 *  结算卡上写着「我方升 3 级　对方升 1 级」，对方明明垫底还跟着升了一级。
 *  查下来是老代码对两队各算一次名次，输方 places 是 {3,4}，落进
 *  中间那条 (has(2)&&has(3)) 之外的分支拿了默认 1 级，等于每局双方都升。
 *
 *  真实规则（掼蛋通行口径）：一局只有头游那一方升级，级数看搭档名次——
 *    搭档二游（对手双下，两个名次都被一方包了）→ 升 3 级
 *    搭档三游                                    → 升 2 级
 *    搭档末游                                    → 升 1 级
 *  输的一方本局不升、也不掉级，级牌停在原处，等下一局再打。
 */
function settleRound(st){
  var f = st.finished, res = {order:f.slice(), teams:[0,0], meta:[]};
  if(!f.length) return res;
  var firstTeam = teamOf(f[0]);                 /* 头游方，只有这一方能升 */
  for(var t=0;t<2;t++){
    var places = [], i, up = 0;
    for(i=0;i<f.length;i++) if(teamOf(f[i]) === t) places.push(i+1);
    var has = function(p){ return places.indexOf(p) >= 0; };
    if(t === firstTeam){
      up = 1;
      if(has(2)) up = 3;                        /* 头游+二游：对手双下 */
      else if(has(3)) up = 2;                   /* 头游+三游 */
    }
    res.teams[t] = up;
    res.meta.push({team:t, places:places, up:up});
  }
  return res;
}
/**
 * 局末升级：两队各记各的级牌（真实掼蛋打法），并处理「打 A 过 A」。
 *
 * 旧版是两队共用一个级牌，谁赢都往上加，对方赢也等于帮你升级；
 * 而且 wrapLevel 满圈直接回 2，从 Q 双下升 3 级会越过 A 直接跳回 2，永远到不了 A。
 * 这里改成：
 *   · st.lv[0] / st.lv[1] 两队各自的级牌，最高停在 A(14)，不会越界
 *   · 每局用谁的级牌：上局头游那一方（st.leadSeat 的队伍）
 *   · 本局打的就是 A 时：级牌拥有方一家头游、且搭档不是末游 → 过 A，通关结束
 *                        （官方口径：搭档垫底不算过）
 *                        没过 → 记一次失败，级牌留在 A；连续三次不过退回 2 重打
 *   · 另一方照常按名次升级，不受影响
 */
function applyLevel(st, res){
  var owner     = teamOf(st.levelOwner !== undefined && st.levelOwner !== null
                         ? st.levelOwner : st.leadSeat);   /* 本局级牌归谁（看头游，不看谁先出） */
  var firstTeam = teamOf(res.order[0]);       /* 本局头游方 */
  var playedA   = st.level >= 14;
  if(!st.lv) st.lv = [st.level || 2, st.level || 2];
  var out = {from:st.level, owner:owner, up:res.teams.slice(),
             matchOver:false, winner:-1, note:'', lv:[0,0], nextLevel:st.level};
  for(var t=0;t<2;t++) st.lv[t] = Math.min(14, st.lv[t] + res.teams[t]);
  if(playedA){
    if(!st.tryA) st.tryA = [0, 0];
    /* 官方口径：打 A 时本方一家是头游、且搭档不是末游，才算过 A。
       旧版只看「本方有人头游」，搭档垫底也照样通关，那是宽松版。 */
    var mateSeat = (owner === 0) ? 2 : 1;
    var matePlace = res.order.indexOf(mateSeat) + 1;      /* 0 表示没找到 */
    var mateLast = (matePlace === 4);
    if(firstTeam === owner && !mateLast){
      out.matchOver = true; out.winner = owner;
      out.note = '打 A 成功（头游 + 搭档第 ' + matePlace + ' 名）→ ' +
                 (owner === 0 ? '我方' : '对方') + '过 A 通关';
    }else{
      st.tryA[owner] = (st.tryA[owner] || 0) + 1;
      if(st.tryA[owner] >= 3){
        st.lv[owner] = 2;
        out.note = '打 A 连续三次没过（' +
                   (firstTeam === owner ? '搭档垫底' : '头游不在本方') +
                   '）→ ' + (owner === 0 ? '我方' : '对方') + '退回 2 重打';
      }else{
        st.lv[owner] = 14;
        out.note = '打 A 没过（' +
                   (firstTeam === owner ? '搭档垫底' : '头游不在本方') +
                   '）· 第 ' + st.tryA[owner] + ' 次，满三次退回 2';
      }
    }
  }else if(st.lv[owner] >= 14){
    out.note = (owner === 0 ? '我方' : '对方') + '已升到 A，下次他领出时打 A，赢一局即通关';
  }
  out.lv = [st.lv[0], st.lv[1]];
