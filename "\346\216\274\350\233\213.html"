  for(i = 0; i < hand.length; i++) if(!hand[i].joker) cnt[hand[i].rank] = (cnt[hand[i].rank] || 0) + 1;
  var baseBurden = powerDetail(hand, level).burden;
  for(i = 0; i < list.length; i++){
