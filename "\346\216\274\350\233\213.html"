/* ---------- 行动记录 ---------- */
function pushLog(msg){
  if(!st.log) st.log = [];
  st.log.push([(st.trickNo || 0) + 1, msg]);
  if(st.log.length > 40) st.log.shift();
}
function setIntent(seat, act){
  st.intentLog[seat] = act.type === 'pass'
    ? '不要 · ' + act.reason
    : R.TYPE_NAME[act.info.type] + ' · ' + act.reason;
}

/* ---------- AI 调度 ---------- */
function aiStep(){
  /* 验收脚本按住 AI 时，连已经排上号的那一手也不许走。
     只在 scheduleAi 里拦是不够的：开局 newGame() 里就排过一个 620ms 的定时器，
     脚本把开关置 true 时它已经在倒计时，到点照样落子。 */
  if(window.__gdTestHold) return;
  if(st.phase !== 'play'){ endRound(); return; }
  var seat = st.turn, act = R.chooseAction(st, seat), res;
  setIntent(seat, act);
  if(act.type === 'play'){
    res = R.tryPlay(st, seat, act.cards, act.reason);
    if(res.ok) pushLog(SEAT_NAME[seat] + ' 出 ' + R.infoLabel(res.info, st.level) + ' — ' + act.reason);
  }else{
    res = R.tryPass(st, seat, act.reason);
    if(res.ok) pushLog(SEAT_NAME[seat] + ' 不要 — ' + act.reason);
  }
  if(!res.ok) toast(res.why);
  R.rotate(st, seat);
  if(st.phase !== 'play'){ renderAll(); endRound(); return; }
  renderAll();
  if(st.turn !== 0) scheduleAi();
}
function scheduleAi(){
  clearTimeout(timer);
  /* 复盘弹层开着就一手都不走。
     牌谱是在弹层里逐手看的东西，后台还在长，看的人就会被自己没出的牌带着跑。 */
  if(reviewPaused) return;
  /* 验收脚本专用：页面一加载就把 AI 按住。
     2026-11-07 先出改成随机之后，靠「开局轮到你」写死的排版脚本会先在
     AI 手里把牌打掉，再点就点不动了。这个开关只在脚本里被置 true，
     正常打开页面永远是 undefined，不影响任何真实对局。 */
  if(window.__gdTestHold) return;
  var wait = 620;
  if(panelOpen){
    var remain = pauseUntil - Date.now();
    if(remain > 0) wait = Math.max(wait, remain);
  }
  timer = setTimeout(aiStep, wait);
}
function endRound(){
  if(st.phase !== 'roundEnd') return;          /* 只在结算那一刻做一次，防止重复记账 */
  var res = R.settleRound(st);
  st.roundResult = res;
  var lvRes = R.applyLevel(st, res);
  st.matchOver = lvRes.matchOver;
  st.matchWinner = lvRes.winner;
  /* 本局打完先把复盘存成快照：下一局发牌会清空 st.moves，不清空就看不到了 */
  lastReview = {live:false, roundNo:st.roundNo, level:st.level,
                moves:(st.moves || []).slice(), decisions:(st.decisions || []).slice(), result:res};
  var orderTxt = res.order.map(function(s,i){ return ['头游','二游','三游','末游'][i] + ' ' + SEAT_NAME[s]; }).join('　');
  pushLog('结算：' + orderTxt + '　我方' + (res.teams[0] ? '升 ' + res.teams[0] + ' 级（现在打 ' + R.rankLabel(lvRes.lv[0]) + '）' : '不升（仍打 ' + R.rankLabel(lvRes.lv[0]) + '）') +
          '　对方' + (res.teams[1] ? '升 ' + res.teams[1] + ' 级（现在打 ' + R.rankLabel(lvRes.lv[1]) + '）' : '不升（仍打 ' + R.rankLabel(lvRes.lv[1]) + '）'));
  if(lvRes.note) pushLog(lvRes.note);
  /* 局末主动提一句，提醒去看复盘 */
  var decN = (st.decisions || []).length,
      diffN = (st.decisions || []).filter(function(d){ return d.verdict !== 'same'; }).length;
  var reviewTip = decN ? ('本局你出了 ' + decN + ' 手，' +
      (diffN ? diffN + ' 手跟建议不同' : '全部跟建议一致') + '，点【复盘】可看细节') : '';
  clearTimeout(timer);
  if(st.matchOver){
    st.phase = 'matchOver';
    renderAll();
    toast(lvRes.note + (reviewTip ? '。' + reviewTip : '') + '，点「重新开局」再来一盘');
    return;
  }
  /* 结算参数留给中央那张结算卡用（下一局打几、本局你跟建议差几手，卡上都要写） */
  st.roundResult.lvRes = lvRes;
  st.roundResult.reviewTip = reviewTip;
  renderAll();
  /* 不再另弹 toast：卡片已经把有名次、升级、两个按钮、复盘提示，
     多弹一条只会压在顶栏上挡住「难度 / 理牌」那几个按钮。 */
  /* 2026-11-07 老板：「一局结束后，要让我选择继续下一局，还是先复盘」。
     原来这里定时 2.2 秒自动发下一局，想复盘经常来不及点。现在停下来等选择。 */
}
/* 继续下一局：由中央结算卡的按钮触发，也是「复盘看完回来」的出口 */
function startNextRound(){
  if(!st || st.phase !== 'roundEnd' || !st.roundResult) return;
  clearTimeout(timer);
  /* 2026-11-07 改：不再硬把「上局头游」当先手传进去。
     掼蛋下一局谁先出，看的是进贡：末游（双下时两家）先贡，贡完由进贡方先出，
     贡牌一样大看花色，对手抗贡才轮到头游先出。
     旧版在这里传 leadSeat = 头游，等于把进贡定先手的规矩整个绕开了。
     现在传空对象，让 startRound 按上一局名次和进贡结果自己算。 */
  R.startRound(st, {});
  st.intentLog = {};
  sel = {};
  myOrder = []; manualMode = false; myGroups = []; customMode = false;   /* 重新发牌，理牌回到自动排 */
  /* 新一局固定按点数理牌。上一局切到过分组 / 摞叠的话，那套分组是旧牌的分组，
     新牌沿用会看着像「又乱了」，老板 2026-11-07 明确要求新局按点数。 */
  sortMode = 'power';
  paintPrefs();
  pushLog('第 ' + st.roundNo + ' 局开始，本局级牌 ♥' + R.rankLabel(st.level) +
          '（庄家 ' + (R.teamOf(st.levelOwner) === 0 ? '我方' : '对方') + '）' +
          '，' + SEAT_NAME[st.turn] + ' 先出' + (st.tribute ? '；' + st.tribute.note : ''));
  renderAll();
  /* 不再弹 toast：中央的进贡条和手牌下方那行小字已经把贡牌说清了，
     再弹一条会压住顶栏的「难度 / 理牌」按钮（2026-11-06 已经因为这块道过一次歉）。 */
  if(st.turn !== 0) scheduleAi();
}

/* ---------- 交互 ---------- */
function toast(msg){
  var el = $('toast');
  el.textContent = msg;
  el.classList.add('on');
  clearTimeout(el.__t);
  el.__t = setTimeout(function(){ el.classList.remove('on'); }, 1900);
}
function renderAll(){ renderChips(); renderSeats(); renderCenter(); renderHand(); renderPanel(); }

/* ---------- 复盘：界面 ---------- */
var rvTab = 'dec', rvData = null, rvPos = 0, rvTimer = null;
/* rvBuiltKey：回放页当前这套控制条是哪一局建的。同一局重复绘制只换下半块，滑杆不动。
   rvDragging：正按着滑杆拖，气泡临时加深。 */
var rvBuiltKey = '', rvDragging = false;
function reviewData(){
  var live = st && st.moves && st.moves.length;
  /* moves / decisions 都用 slice 取一份长度固定的快照。
     原来直接把 st.moves 交出去，局还在进行时数组会继续变长，
     复盘里的「共 N 手」和滑杆上限跟着涨，正看着的那一手会被冲掉。 */
  if(live && st.moves.length >= 4)
    return {live:true, roundNo:st.roundNo, level:st.level,
            moves:st.moves.slice(), decisions:(st.decisions || []).slice()};
  if(lastReview) return lastReview;
  if(live) return {live:true, roundNo:st.roundNo, level:st.level,
                   moves:st.moves.slice(), decisions:(st.decisions || []).slice()};
  return null;
}
function openReview(){
  var d = reviewData();
  if(!d){ toast('还没有牌可以复盘，先打几手'); return; }
  rvData = d;
  rvStop();
  /* 打开就停止对局，关掉再接着打（closeReview 里恢复） */
  reviewPaused = true;
  clearTimeout(timer);
  rvPos = 0;
  rvTab = (d.decisions && d.decisions.length) ? 'dec' : 'log';
  $('review').classList.add('on');
  paintReview();
  gdLogPaint();          /* 面板一开就把日志状态刷新成最新的 */
}
function closeReview(){
  rvStop();
  $('review').classList.remove('on');
  if(reviewPaused){
    reviewPaused = false;
    /* 关掉之后接着打：还轮到电脑，就把它的计时器重新排上 */
    if(st && st.phase === 'play' && st.turn !== 0) scheduleAi();
  }
}
/* ---------- 四家明牌回放 ---------- */
function rvStop(){ if(rvTimer){ clearInterval(rvTimer); rvTimer = null; } }
function rvGo(p){
  var n = (rvData && rvData.moves || []).length;
  if(!n) return;
  rvPos = Math.max(0, Math.min(n - 1, p));
  paintReview();
}
function rvTogglePlay(){
  if(rvTimer){ rvStop(); paintReview(); return; }
  var n = (rvData && rvData.moves || []).length;
  if(!n) return;
  if(rvPos >= n - 1) rvPos = 0;
  rvTimer = setInterval(function(){
    if(rvPos >= n - 1){ rvStop(); paintReview(); return; }
    rvPos++;
    paintReview();
  }, 850);
  paintReview();
}
/* ---------- 每一步的判断依据（2026-11-06 18:05 老板要求：把 AI 每一步的逻辑整理出来） ----------
   新打的牌局里，tryPlay / tryPass 已经把 reason 写进牌谱，直接读就行。
   老板手上这一局是加字段之前打的，牌谱里没有 reason。
   好在每一手都存了「出牌前四家手牌」快照，可以据此把当时的局面原样重建，
   再让 AI 重算一遍，把理由补出来。要重建的东西：级牌、四家手牌、已经出过的牌、
   本轮打到了哪一张、过了几家、谁已经走完。缺一样重算就会跑偏，
   所以下面全部按牌谱里的真实记录复原，不猜。 */
function rebuildAt(d, idx){
  var moves = d.moves || [], m = moves[idx], i, s;
  if(!m || !m.hands) return null;
  var st2 = R.newGame({firstDeal:true, leadSeat:0, diff:'hard'});
  st2.level = d.level;
  st2.roundNo = d.roundNo;
  st2.phase = 'play';
  st2.hands = [0,1,2,3].map(function(k){ return (m.hands[k] || []).slice(); });
  st2.played = [];
  for(i = 0; i < idx; i++) if(moves[i].type === 'play') st2.played = st2.played.concat(moves[i].cards);
  st2.finished = [];
  for(s = 0; s < 4; s++) if(st2.hands[s].length === 0) st2.finished.push(s);
  st2.trick = null;
  for(i = idx - 1; i >= 0; i--){
    if(moves[i].trickNo !== m.trickNo) break;
    if(moves[i].type === 'play'){
      st2.trick = {seat:moves[i].seat, cards:moves[i].cards, info:moves[i].info};
      break;
    }
  }
  st2.passes = 0;
  for(i = idx - 1; i >= 0; i--){
    if(moves[i].trickNo !== m.trickNo) break;
    if(moves[i].type === 'pass') st2.passes++;
    else break;                       /* 遇到出牌就停，只数紧挨着的这几家 */
  }
  st2.turn = m.seat;
  st2.trickNo = m.trickNo;
  /* 本轮已经出过的牌也要复原：trickHistory 只装本轮的出牌，轮次一换就清空。
     漏了它，AI 读「这一轮别人出过什么」的那几条判断就会失灵。 */
  st2.trickHistory = [];
  for(i = 0; i < idx; i++){
    if(moves[i].trickNo !== m.trickNo) continue;
    if(moves[i].type === 'play')
      st2.trickHistory.push({seat:moves[i].seat, cards:moves[i].cards, info:moves[i].info});
  }
  /* 已经走完的人是谁、最后出的是什么牌，也要复原，残局判断要用 */
  st2.finishMeta = {};
  for(i = 0; i < idx; i++){
    if(moves[i].type === 'play' && moves[i].handLeft === 0)
      st2.finishMeta[moves[i].seat] = {cards:moves[i].cards, info:moves[i].info};
  }
  st2.noLog = true;                   /* 重算不许往牌谱里追加，否则越算越长 */
  st2.decisions = [];
  /* 历史出牌流水必须带上：publicInfo 靠它统计「谁对哪种牌型放过」，
     清空的话「对手不吃什么就接着打什么」这条判断就失灵，重算结果会偏。 */
  st2.moves = moves.slice(0, idx);
  return st2;
}
/** 某一手的判断依据。mismatch 为真＝按当时牌面重算，算法会选别的打法 */
function whyMove(d, idx){
  var m = (d.moves || [])[idx];
  if(!m) return {txt:'', mismatch:false};
  if(m.reason) return {txt:m.reason, mismatch:false};
  if(!m.hands) return {txt:'这一局是旧版打的，没存手牌快照，补不出当时的判断', mismatch:false};
  try{
    var st2 = rebuildAt(d, idx);
    if(!st2) return {txt:'局面重建失败', mismatch:false};
    var act = R.chooseAction(st2, m.seat), same;
    if(act.type !== m.type) same = false;
    else if(act.type === 'pass') same = true;
    else same = act.cards.length === m.cards.length &&
                act.cards.every(function(c){ return m.cards.some(function(x){ return x.id === c.id; }); });
    var calc = act.type === 'pass' ? '不要'
      : R.TYPE_NAME[act.info.type] + ' ' + act.cards.map(function(c){
          return c.joker ? (c.rank === 17 ? '大王' : '小王') : R.rankLabel(c.rank);
        }).join(' ');
    return {txt: act.reason || '', mismatch: !same, calc: calc};
  }catch(e){ return {txt:'重算失败：' + e.message, mismatch:false}; }
}
/* 重算一次要跑整套评分，拖滑块时不能每一帧都算一遍，按「哪一局 + 第几手」缓存住 */
var rvWhyCache = {}, rvWhyFor = null;
function whyMoveCached(d, idx){
  if(rvWhyFor !== d){ rvWhyCache = {}; rvWhyFor = d; }
  var k = 'i' + idx;
  if(!rvWhyCache[k]) rvWhyCache[k] = whyMove(d, idx);
  return rvWhyCache[k];
}
/** 把整局每一手的逻辑拼成纯文本 */
function buildLogicText(d){
  var moves = d.moves || [], lines = [], i, m, who, what, w, prev, pj;
  /* 牌面写成「大王 2 3」这种一眼能读的样子 */
  function face(cs){
    return cs.map(function(c){
      return c.joker ? (c.rank === 17 ? '大王' : '小王') : R.rankLabel(c.rank);
    }).join(' ');
  }
  function one(x){
    return x.type === 'pass' ? '不要' : R.TYPE_NAME[x.info.type] + '　' + face(x.cards);
  }
  lines.push('掼蛋 AI 决策逻辑导出');
  lines.push('第 ' + d.roundNo + ' 局　级牌 ' + R.rankLabel(d.level) + '　共 ' + moves.length + ' 手');
  lines.push('座位口径：你＝自己　下家＝右手对手　对家＝队友　上家＝左手对手');
  lines.push('「台面」是这一手轮到时桌面上正压着的牌，「出」是这一次实际出的。');
  lines.push('标了【重算不一致】的那几手，意思是按当时牌面重算，算法会选别的打法。');
  lines.push('==================================================');
  for(i = 0; i < moves.length; i++){
    m = moves[i];
    who = m.seat === 0 ? '你'
      : SEAT_NAME[m.seat] + (m.seat === 2 ? '（队友）' : '（对手）');
    what = one(m);
    lines.push('');
    lines.push('第 ' + (i + 1) + ' 手　第 ' + (m.trickNo + 1) + ' 轮　' + who +
               '　（手里 ' + (m.handLeft + (m.type === 'play' ? m.cards.length : 0)) + ' 张）');
    /* 台面：同一轮里最近一次出牌是谁、出的什么。没有就是这一轮由他领出 */
    prev = null;
    for(pj = i - 1; pj >= 0; pj--){
      if(moves[pj].trickNo !== m.trickNo) break;
      if(moves[pj].type === 'play'){ prev = moves[pj]; break; }
    }
    lines.push(prev
      ? '　台面：' + SEAT_NAME[prev.seat] + ' 出了 ' + one(prev)
      : '　台面：空，这一轮由他领出');
    lines.push('　出：' + what + '　［出完剩 ' + m.handLeft + ' 张］');
    w = whyMove(d, i);
    lines.push('　判断：' + (w.mismatch ? '【重算不一致，重算会打 ' + w.calc + '】' : '') + w.txt);
  }
  lines.push('');
  lines.push('==================================================');
  lines.push('导出于 ' + new Date().toLocaleString());
