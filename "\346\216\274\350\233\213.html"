/* ---------- 复盘日志自动落盘（2026-11-07 老板要求） ----------
   老板原话：「你把复盘里面的日志直接保存到本地目录，这样方便你总结和回看问题。
             我以后再测试发现问题，会直接告诉你哪一局第几手出了什么问题。」

   为什么要落盘：截图只能看到某一瞬间的盘面，而复盘截图里显示的常常是「出完牌之后」
   的四家手牌，拿它当「出牌之前」来分析，结论从根上就是错的（第 62 手就栽在这儿）。
   引擎里 tryPlay / tryPass 本来就存了 handsSnap(st)，是出牌前抓的四家快照，
   这里把它连同牌型、台面、判断依据一起按「第 N 局第 M 手」写成文件，
   以后只要报局号和手数，就能直接读日志把当时局面还原出来，不用再猜。

   落盘方式：Chrome 的 File System Access API。file:// 打开的本地页面也是安全上下文，
   showDirectoryPicker / createWritable 可用。老板只需要点一次「日志」选目录，
   目录句柄存进 IndexedDB，之后每出一手自动覆盖写两个文件，刷新页面也会接着写。
   没授权之前日志一直存在 localStorage 里，一授权就把历史全量补写进文件，不会丢。
   没开自动落盘时，「导出日志」按钮弹另存为，把 localStorage 里的全量记录写成 md。

   两个文件：
     掼蛋-复盘日志.md     人读，按局分节、逐手列出四家出牌前手牌
     掼蛋-复盘日志.jsonl  机器读，每行一手 JSON，方便按局号手数精确定位
*/
var GD_LOG_KEY = 'gdLogStore_v1';
var GD_LOG_MD = '掼蛋-复盘日志.md';
var GD_LOG_JSONL = '掼蛋-复盘日志.jsonl';
var GD_LOG_MAX_ROUNDS = 20;
var gdLogStore = {v:1, rounds:[]};
var gdLogDir = null, gdLogPerm = 'none', gdLogErr = '', gdLogSession = '',
    gdLogWriting = false, gdLogDirty = false, gdLogLast = '';

function gdLogFace(c, level){
  if(!c) return '';
  if(c.joker) return c.rank === 17 ? '大王' : '小王';
  var s = R.rankLabel(c.rank) + ((R.SUIT_CH || [])[c.suit] || '');
  if(c.rank === level && c.suit === 1) s += '(配)';   /* 红桃级牌＝逢人配 */
  return s;
}
function gdLogHands(snap, level){
  var out = [];
  for(var s = 0; s < 4; s++){
    var hs = (snap && snap[s]) || [];
    out.push(hs.map(function(c){ return gdLogFace(c, level); }).join(' '));
  }
  return out;
}
function gdLogTable(ms, i, level){
  var p, prev = null;
  for(p = i - 1; p >= 0; p--){
    if(ms[p].trickNo !== ms[i].trickNo) break;
    if(ms[p].type === 'play'){ prev = ms[p]; break; }
  }
  if(!prev) return '空，这一轮由 ' + SEAT_NAME[ms[i].seat] + ' 领出';
  return SEAT_NAME[prev.seat] + ' 出了 ' + (R.TYPE_NAME[prev.info.type] || prev.info.type) +
         '　' + prev.cards.map(function(c){ return gdLogFace(c, level); }).join(' ');
}
function gdLogOne(m, i, ms, level){
  var hands = gdLogHands(m.hands, level);
  return {
    n:i + 1, trick:(m.trickNo || 0) + 1, seat:m.seat,
    who:SEAT_NAME[m.seat] + (m.seat === 0 ? '（你）' : m.seat === 2 ? '（队友）' : '（对手）'),
    act:m.type === 'pass' ? '不要' : (R.TYPE_NAME[m.info.type] || m.info.type),
    cards:(m.cards || []).map(function(c){ return gdLogFace(c, level); }).join(' '),
    handLeft:m.handLeft, hands:hands,
    counts:hands.map(function(x){ return x ? x.split(' ').length : 0; }),
    table:gdLogTable(ms, i, level), reason:m.reason || ''
