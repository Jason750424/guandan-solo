          : lv <= 9  ? [3,4,5,6,7]
          : lv >= 10 ? [3,4,5,6,7]
          : [6,7,8,9,10];
  var SEQC = SEQ.map(function(r, i){ return makeCard(r, i % 4); });
  push('逢人配单张 = 单张', [W], 'SINGLE');
  push('逢人配补对子',      [W, makeCard(7,0)], 'PAIR');
  push('两张逢人配 = 对子',  [W, makeCard(lv, 1)], 'PAIR');
  push('逢人配补三张',      [W, makeCard(9,0), makeCard(9,1)], 'TRIPLE');
  push('主牌级牌 4 张 = 炸弹', [T, T2, T3, makeCard(lv, 1)], 'BOMB');
  push('四张逢人配 = 炸弹',   [W, makeCard(lv,1), makeCard(lv,1), makeCard(lv,1)], 'BOMB');
  push('逢人配可补顺子',     SEQC.slice(0,4).concat([W]), 'STRAIGHT');
  push('主牌级牌不能进顺子', [T, SEQC[1], SEQC[2], SEQC[3], SEQC[4]], null);
  /* 2026-11-06 口径修正：逢人配只是「能当任何牌」，不额外加成。
     配牌补出来的牌型，大小一律按它变成的那张牌算，跟天然的同点数牌完全同级。
     旧版这三条要求「配凑的比不配的大」，正是老板抓到的「3 压 A」的同类错误。 */
  push('配凑的级牌炸 与 纯主牌级牌炸 同级，互不压',
       [W, makeCard(lv,1), makeCard(lv,1), makeCard(lv,1)], 'BOMB',
       [T, T2, T3, makeCard(lv, 0)], false);
  push('逢人配单张与主牌级牌同级，互不压', [W], 'SINGLE', [T], false);
  push('大王 > 逢人配单张',   [C(17,0)], 'SINGLE', [W], true);
  push('配凑的级牌炸 压不过 同点数纯级牌炸（配牌不加成）', [T, T2, T3, W], 'BOMB',
       [makeCard(lv,0), makeCard(lv,2), makeCard(lv,3), makeCard(lv,0)], false);
  /* 配牌不当加成，但它变出来的牌该有多大就多大 */
  push('配牌补成的三张 与 天然三张 同级，互不压',
       [W, makeCard(9,0), makeCard(9,1)], 'TRIPLE', [makeCard(9,2), makeCard(9,3), makeCard(9,0)], false);
  push('配牌补成的三张 9 压得过 三张 8',
       [W, makeCard(9,0), makeCard(9,1)], 'TRIPLE', [makeCard(8,0), makeCard(8,1), makeCard(8,2)], true);
  /* 级牌为 2 时主牌本身就是 2（此时 2 是最大牌）；级牌为 A 时 A 本身是级牌。
     这两种情况跳过涉及 2/A 的普通牌序比较。 */
  if(lv !== 2 && lv !== 14){
    push('主牌 > A（主牌比最大普通牌还大）', [T], 'SINGLE', [makeCard(14, 0)], true);
    /* 2 是最小的普通牌 */
    push('A > 2（2 最小）', [makeCard(14,0)], 'SINGLE', [C(2,0)], true);
    push('2 是最小牌，3 > 2', [C(3,0)], 'SINGLE', [C(2,0)], true);
  }
  /* 级牌为 2 时：2 变成主牌，是最大的普通牌 */
  if(lv === 2){
    push('级牌为 2 时 2 是主牌，最大', [T], 'SINGLE', [makeCard(14,0)], true);
  }
