          if(!guard2 || mvB.info.key < guard2.info.key) guard2 = mvB;
        }
      }
      if(guard2) return {move:guard2, code:'L22',
        txt:'下一家（对手）只剩 1 张，我 ' + p15Rounds(e.hand, e.level) + ' 手能走完。先出他接不住的 ' +
            cardsLabel(guard2.cards, e.level) + ' 保住牌权，把 ' + cardsLabel(tiny2.cards, e.level) +
