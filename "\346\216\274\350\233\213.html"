function setVar(px){ document.documentElement.style.setProperty('--hand-card', px + 'px'); }
/* 手牌最终顺序：手动模式按你拖的顺序，其余牌（刚摸到的、悔牌回来的）按当前规则补进去 */
function handOrder(){
  var auto = R.sortHand(st.hands[0], st.level, st.sortMode);
  if(!manualMode || !myOrder.length) return auto;
  var alive = {}, out = [], used = {}, i, c;
  for(i=0;i<st.hands[0].length;i++) alive[st.hands[0][i].id] = st.hands[0][i];
  for(i=0;i<myOrder.length;i++){
    c = alive[myOrder[i]];
    if(c && !used[c.id]){ out.push(c); used[c.id] = 1; }
  }
  for(i=0;i<auto.length;i++) if(!used[auto[i].id]) out.push(auto[i]);
  return out;
}
/* 按牌型拆成一手一手，分组视图和摞叠视图共用这份结果。
   补一组散牌，保证手牌一张不丢；data-hg 是组序号，点组名选整组要用。
   自己分过摞之后（customMode）改用 myGroups，程序不再替老板重新拆。 */
var handGroupsCache = [];
function pruneGroups(){
  if(!customMode) return;
  var alive = {}, i;
  for(i=0;i<st.hands[0].length;i++) alive[st.hands[0][i].id] = 1;
  for(i=0;i<myGroups.length;i++)
    myGroups[i].ids = myGroups[i].ids.filter(function(id){ return alive[id]; });
  myGroups = myGroups.filter(function(g){ return g.ids.length; });
  /* 一摞都不剩也不退出自定义模式：老板可能只是想全拆散重排，
     程序这时若自动拆一遍，就又把他没组的牌拆成连对、对子了。
