}
function gdLogResult(){
  if(!st || !st.roundResult) return '';
  var r = st.roundResult;
  return ((r.order || []).map(function(s, i){
    return ['头游','二游','三游','末游'][i] + ' ' + SEAT_NAME[s];
  }).join('　')) + '　我方升 ' + (r.teams ? r.teams[0] : 0) +
    ' 级　对方升 ' + (r.teams ? r.teams[1] : 0) + ' 级';
}
function gdLogLoad(){
  try{
    var s = JSON.parse(localStorage.getItem(GD_LOG_KEY) || 'null');
    if(s && s.v === 1 && s.rounds && s.rounds.length) gdLogStore = s;
  }catch(e){}
}
function gdLogSave(){
  try{ localStorage.setItem(GD_LOG_KEY, JSON.stringify(gdLogStore)); }
  catch(e){ gdLogErr = '本地暂存写不下：' + e.message; }
}
/* 每 400 毫秒看一眼牌谱有没有长。只认 st.moves，不碰出牌逻辑，
   AI 决策、玩家出牌、悔棋、换局都自然 covered，不用往引擎里塞钩子。 */
function gdLogTick(){
  try{
    if(!st || !st.moves) return;
    var ms = st.moves, n = ms.length, i, cur, changed = false, k, meta;
    cur = gdLogStore.rounds[gdLogStore.rounds.length - 1];
    if(!cur || cur.session !== gdLogSession || cur.roundNo !== st.roundNo || n < (cur.n || 0)){
      cur = {session:gdLogSession, roundNo:st.roundNo, level:st.level,
             leadSeat:st.leadSeat, tribute:(st.tribute ? st.tribute.note : ''),
             startedAt:new Date().toISOString(), result:'', moves:[], n:0, sig:'', marks:[]};
      gdLogStore.rounds.push(cur);
      while(gdLogStore.rounds.length > GD_LOG_MAX_ROUNDS) gdLogStore.rounds.shift();
      changed = true;
    }
    meta = {level:st.level, leadSeat:st.leadSeat,
            tribute:(st.tribute ? st.tribute.note : ''), result:gdLogResult()};
    for(k in meta) if(cur[k] !== meta[k]){ cur[k] = meta[k]; changed = true; }
    /* 长度相同也可能是悔棋后重出了一手，所以再比一下最后一手的签名 */
    var sig = n ? (ms[n-1].seat + '|' +
      (ms[n-1].cards || []).map(function(c){ return c.id; }).join(',') + '|' +
      (ms[n-1].reason || '')) : '';
    if(n !== cur.n || sig !== cur.sig){
      cur.moves = [];
      for(i = 0; i < n; i++) cur.moves.push(gdLogOne(ms[i], i, ms, st.level));
      cur.n = n; cur.sig = sig; changed = true;
    }
    if(changed){ gdLogSave(); gdLogWrite(); }
    gdLogPaint();
  }catch(e){ gdLogErr = e.message; }
}
/* ---------- 标一手（2026-11-09 老板要求：不想手写，点一下就行） ----------
   标记挂在本局记录上，跟日志一起落盘、一起进 md 和 jsonl。
   再点同一手就取消，点错了能撤。 */
function gdLogRound(roundNo){
  var rs = gdLogStore.rounds, i;
  for(i = rs.length - 1; i >= 0; i--) if(rs[i].roundNo === roundNo) return rs[i];
  return null;
}
function gdLogMark(roundNo, n){
  var r = gdLogRound(roundNo);
  if(!r || !n) return null;
  r.marks = r.marks || [];
  var i, k = -1;
  for(i = 0; i < r.marks.length; i++) if(r.marks[i].n === n){ k = i; break; }
  if(k >= 0) r.marks.splice(k, 1);
  else r.marks.push({n:n, at:new Date().toISOString()});
  r.marks.sort(function(a, b){ return a.n - b.n; });
  gdLogSave(); gdLogWrite();
  return {on:k < 0, count:r.marks.length, marks:r.marks.slice()};
}
function gdLogHasMark(roundNo, n){
  var r = gdLogRound(roundNo);
  if(!r || !r.marks) return false;
  for(var i = 0; i < r.marks.length; i++) if(r.marks[i].n === n) return true;
  return false;
}
function gdLogBuildMd(){
  var L = [], rs = gdLogStore.rounds, i, j, s, r, m;
  L.push('# 掼蛋复盘日志');
  L.push('');
  L.push('- 最后更新：' + new Date().toLocaleString());
  L.push('- 记录局数：' + rs.length + '（最多保留最近 ' + GD_LOG_MAX_ROUNDS + ' 局）');
  L.push('- 文件：' + GD_LOG_MD + '（这个）与 ' + GD_LOG_JSONL + '（每行一手，机器读）');
  L.push('- 座位：你 / 下家（对手）/ 对家（队友）/ 上家（对手）');
  L.push('- 手数口径和复盘面板一致：第 N 手就是复盘滑杆上的第 N 手。');
  L.push('- 「出牌前四家手牌」是这一手决策之前抓的快照，包含这一手正要打出去的牌。');
  L.push('');
  for(i = 0; i < rs.length; i++){
    r = rs[i];
    L.push('## 第 ' + r.roundNo + ' 局　级牌 ' + R.rankLabel(r.level) +
           '　先出 ' + SEAT_NAME[r.leadSeat] + (r.tribute ? '　进贡：' + r.tribute : ''));
    L.push('');
    L.push('- 开始：' + r.startedAt + '　共 ' + ((r.moves || []).length) + ' 手');
    if(r.result) L.push('- 结算：' + r.result);
    L.push('');
    for(j = 0; j < (r.moves || []).length; j++){
      m = r.moves[j];
      L.push('### 第 ' + m.n + ' 手　第 ' + m.trick + ' 轮　' + m.who +
             '　' + m.act + (m.cards ? ' ' + m.cards : ''));
      L.push('');
      L.push('- 出牌前四家手牌：');
      for(s = 0; s < 4; s++)
        L.push('  - ' + SEAT_NAME[s] + '（' + (m.counts ? m.counts[s] : 0) + ' 张）：' +
               (m.hands ? m.hands[s] : ''));
      L.push('- 台面：' + m.table);
      L.push('- 出：' + m.act + (m.cards ? '　' + m.cards : '') + '　［出完剩 ' + m.handLeft + ' 张］');
      L.push('- 判断依据：' + (m.reason || '（玩家自己出的，没有 AI 判据）'));
      L.push('');
    }
    if((r.marks || []).length){
      L.push('### ⚑ 老板标记（待核实）');
      L.push('');
      for(j = 0; j < r.marks.length; j++){
        var mk = r.marks[j], row = null, q;
        for(q = 0; q < (r.moves || []).length; q++)
          if(r.moves[q].n === mk.n){ row = r.moves[q]; break; }
        L.push('- 第 ' + mk.n + ' 手' +
               (row ? '　' + row.who + '　' + row.act + (row.cards ? ' ' + row.cards : '') : ''));
      }
      L.push('');
    }
  }
  return L.join('\r\n');
}
function gdLogBuildJsonl(){
  var L = [], rs = gdLogStore.rounds, i, j, r, m;
  for(i = 0; i < rs.length; i++){
    r = rs[i];
    for(j = 0; j < (r.moves || []).length; j++){
      m = r.moves[j];
      L.push(JSON.stringify({
        v:1, session:r.session, round:r.roundNo, level:r.level,
        leadSeat:r.leadSeat, tribute:r.tribute, startedAt:r.startedAt, result:r.result,
        n:m.n, trick:m.trick, seat:m.seat, who:m.who, act:m.act, cards:m.cards,
        handLeft:m.handLeft, counts:m.counts, hands:m.hands,
        table:m.table, reason:m.reason, mark:gdLogHasMark(r.roundNo, m.n) ? 1 : 0
      }));
    }
  }
  return L.length ? L.join('\n') + '\n' : '';
}
function gdLogPut(dir, name, text){
  return dir.getFileHandle(name, {create:true}).then(function(fh){
    return fh.createWritable();
  }).then(function(w){
    return w.write(text).then(function(){ return w.close(); });
  });
}
function gdLogWrite(){
  if(!gdLogDir || gdLogPerm !== 'granted') return;
  gdLogDirty = true;
  if(gdLogWriting) return;
  gdLogWriting = true;
  var run = function(){
    if(!gdLogDirty){ gdLogWriting = false; gdLogPaint(); return; }
    gdLogDirty = false;
    var md = gdLogBuildMd(), js = gdLogBuildJsonl();
    gdLogPut(gdLogDir, GD_LOG_MD, '\ufeff' + md)
      .then(function(){ return gdLogPut(gdLogDir, GD_LOG_JSONL, js); })
      .then(function(){
        gdLogLast = new Date().toLocaleTimeString(); gdLogErr = ''; run();
      })
      .catch(function(e){
        gdLogErr = (e && e.message) || String(e);
        if(e && e.name === 'NotAllowedError') gdLogPerm = 'prompt';
        gdLogWriting = false; gdLogPaint();
