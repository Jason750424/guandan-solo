.empty{font-size:12px;color:var(--dim2);font-style:italic;padding:4px 0}
/* ============ 复盘弹层 ============ */
.rv-mask{position:fixed;inset:0;z-index:200;background:rgba(6,9,13,.74);display:none;align-items:center;justify-content:center;padding:22px}
.rv-mask.on{display:flex}
.rv{width:min(1120px,100%);max-height:94vh;display:flex;flex-direction:column;background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.62);overflow:hidden}
