    var hasCheap = false;
    for(i=0;i<scored.length;i++){
      var cm = scored[i].m;
      if(cm.info.type === 'BOMB' || cm.info.type === 'STRAIGHT_FLUSH' ||
         cm.info.type === 'JOKER_BOMB' || cm.wilds > 0) continue;
      if(cm.info.key < TIER.SMALL && !(cheapOpp && cm.info.key >= TIER.TRUMP)){ hasCheap = true; break; }
    }
    if(costly && !hasCheap)
      return {type:'pass', reason:'对手还剩 ' + oppRemain + ' 张、这手也不是冲刺牌型。' +
        '能压的只有小王和大王，现在打出去等于把收官的本钱提前花掉，先忍一手，' +
        '等他剩 5 张以内或出长牌冲刺时再拦'};
    /* 有便宜牌能用，偏偏让贵牌排在第一，那是余牌结构分把它顶上来的。
       这种情况必须换成便宜牌：能拿 A 压的牌，没有理由动王。
       2026-11-06 20:56 扫描：对手还剩 7 张以上、出的是 10 以下小牌，
       这边仍有 18 次直接甩小王，根子就在这里少了一步「换便宜牌」。 */
    if(costly && hasCheap){
      for(i = 0; i < scored.length; i++){
        var hm = scored[i].m;
        if(hm.info.type === 'BOMB' || hm.info.type === 'STRAIGHT_FLUSH' ||
           hm.info.type === 'JOKER_BOMB' || hm.wilds > 0) continue;
        if(hm.info.key >= TIER.SMALL) continue;
        if(cheapOpp && hm.info.key >= TIER.TRUMP) continue;
        best = hm; break;
      }
    }
  }
  /* 出这一手炸，剩下的牌能一手走完 —— 那就不是"拿炸换牌权"，是"用炸收官"。
     这种局面留炸没有意义：炸留着也是最后一手要出，此刻不用它抢牌权，
     下一手很可能根本轮不到自己出。
     2026-11-08 22:xx 第 1 局第 107 手就是这么烂掉的：手里 7 张，配 + 三 7 + 三 10，
     只够凑一个炸。上面那条「4/5 张炸留着控尾」一直生效，炸始终没出去，
     整局只出过一张配牌当单张，三 7 和三 10 全部烂在手里，末游。 */
  var bombFinishes = isBombFamily(best.info.type) &&
    p15Rounds(restAfter(hand, best.cards), level) <= 1;
  /* 只有 4/5 张炸或同花顺能压时留着控尾；6 张大炸和王炸是顶级牌，该压就压。
     简单档不会留炸，见牌就压。
     2026-11-08 补一道：上面这句「顶级牌该压就压」只管收官段。
     非收官段（对手还 >9 张、我自己还 >8 张）6 张炸和王炸一样要留，
     实测样例是 25 张手牌对面打一张大王，程序甩 6 张炸去压；
     17 张手牌对面开炸，程序直接上王炸。这两种走法真人都是过，
     300 局里这类还有 80 次，全部落在开局段。 */
  var worthKeep = D.keepBomb && isBombFamily(best.info.type) && !bombFinishes &&
    (!bombBidWorth ||
     (best.info.type === 'BOMB' && best.info.len <= 5) ||
     best.info.type === 'STRAIGHT_FLUSH');
  /* 枪不打四：对手正好剩 4 张，很可能本身就是一手炸，炸上去白扔一发。
     但命中 L03 / L07 这类「必须拦」的原则时这条让位，否则就是眼看着对手走完。 */
  if(D.pro && worthKeep && oppRemain === 4 && !fireHit)
    return {type:'pass', reason:'对手正好剩 4 张，很可能本身就是一手炸弹（枪不打四），这发先留着'};
  /* 该炸就炸：剩 5 张多是顺子 / 三带二冲刺，剩 7 张牌型已定，
     对手打出 5 张以上长牌更是明摆着要跑，这时别再捂着炸。
     P15 命中「必须拦」也算该炸；命中「到位了别浪费」则强制留住。 */
  var fire = (D.pro && (oppRemain === 5 || oppRemain === 7 ||
    (st.trick.info.len >= 5 && oppRemain <= 9))) || !!fireHit;
  /* 对手甩的是 5 张以上、点数又到 10 以上的大牌，不能再捂炸：
     这种牌他走完就是一路领出，用一发炸换回牌权值。
     小牌（比如 3 3 3 带两 5）就算了，拿炸去压纯亏。单张小牌同理，不在此列。
     2026-11-08 补：这条原来完全不看对手还剩几张，开局 20 张牌对面出个 A 高顺子
     就丢一发炸。现在要 bombBidWorth（对手 <=9 张或我自己 <=8 张）才放行，
     对手快走完的那一半 fire 已经管了，这里实际补的是「我自己快走完」这个口子。 */
  var bigPlay = (st.trick.info.len >= 5 && st.trick.info.key >= 10 && bombBidWorth);
  if(worthKeep && !fire && !mustBlock(st, oppRemain, D.block) && !bigPlay)
    return {type:'pass', reason:'只有 ' + TYPE_NAME[best.info.type] + '（' + best.info.len + ' 张）能压，先留着控尾'};
  if(D.pro && worthKeep && holdHit && !fireHit)
    return {type:'pass', reason:holdHit.txt + '（依据 ' + holdHit.code + '）这发炸留着'};
  /* ---- 拦不住的时候，别拿最小的散张去凑数（判据见 p15LoneSend） ----
     老板 2026-11-07 第 11 手：对手只剩 5 张，这一手必须拦，但外面还有 47 张能压回来，
     程序仍然挑了手里最小的 8♠。他的判断是「应该打 K」。
     这里只换「拆出来的那张」，原话和实测数据都写在 p15LoneSend 的注释里。
     注意：这个位置只管评分兜底这条路径。老板那一手实际是 L03 命中走规则层，
     所以规则层出口也要接同一道，否则真机上根本不生效。 */
  if(D.pro && !isBombFamily(best.info.type) &&
     (isCutOut(hand, best) || isControlSingle(best, ctx))){
    var lone = p15LoneSend(hand, moves, ctx, level);
    if(lone) best = lone;
  }
  if(oppRemain <= 6)
    return {type:'play', cards:best.cards, info:best.info,
            reason:'对手只剩 ' + oppRemain + ' 张，用最省的方式压住' +
                   /* 「该炸的节点」这句只在真出炸时才说。
                      2026-11-07 第 98 手出的是对小王，文案却挂着「已到该炸的节点」，
                      读起来像在解释一件没发生的事。 */
                   (fire && isBombFamily(best.info.type) ? '（已到该炸的节点，不捂了）' : '') +
                   playNote(ctx, best.info, level)};
  /* ---- 兜底：有天然普通牌能压，就不许拿炸去压 ----
     上面几道关卡只拦住了「必须拦」和「留炸控尾」两种情况，
     走到这一步的评分兜底里，炸弹仍可能靠张数分压过普通牌。
     老板 2026-11-07 第 11 手就是这一类：能拿单 K 压的单 6，被 4 张炸顶掉了。
     只换「天然的」普通牌：拆炸凑出来的那手不算，那个炸拆开就回不来了。
     残局（对手剩 6 张以内）已经在上一条返回，这里只管对手还有余力的局面。 */
  if(isBombFamily(best.info.type)){
    var nat = null, ni, nm;
    for(ni = 0; ni < scored.length; ni++){
      nm = scored[ni].m;
      if(isBombFamily(nm.info.type)) continue;
      if(nm.info.key >= TIER.TRUMP) continue;
      if(breakPenalty(nm, hand, level, ctx) >= 120) continue;
      nat = nm; break;
    }
    if(nat) best = nat;
  }
  var keepTxt = isBombFamily(best.info.type)
    ? ('用了' + TYPE_NAME[best.info.type] + ' ' + best.info.len + ' 张，' +
       (best.wilds ? '搭 1 张逢人配，' : '') + '手里还剩 ' + restAfter(hand, best.cards).length + ' 张')
    : ((best.info.type === 'PAIR' && best.info.key > TIER.SMALL)
        ? '对王打出去换回牌权，剩下 ' + restAfter(hand, best.cards).length + ' 张'
        : '保留炸弹与逢人配');
  return {type:'play', cards:best.cards, info:best.info,
          reason:'按余牌结构挑最省的一手 ' + TYPE_NAME[best.info.type] + ' 压住，' + keepTxt +
                 (ctx.lastOppNext && best.info.type === 'SINGLE' && best.info.key >= TIER.TRUMP
                   ? '。下一家就是那个只剩 1 张的对手，这手得挑他压不住的牌封死，省牌在这儿不成立'
                   : '') +
                 playNote(ctx, best.info, level)};
}

/* ===================== P15 策略层：全局透视思维 =====================
   来源：《老赵和颜路·顶尖掼蛋高手 全局透视思维》10 份 PPT，已结构化成规则
   纪律（三句话）：
     · 只读自己手牌 + 已出牌 + 各家剩几张，绝不读别家手牌，跟「真人打法」口径一致
     · 全部是「如果 A 则 B」的条件判断，不训练、不联网、不调模型；每条都能说出依据
     · 残局原则沿用资料原编号 L01~L22，直接当建议里的依据编号，方便回查原文
   模块对照：M1 牌力评分 / M2 角色定位 / M4 预判 / M5 记牌与上限 / M6 下家防守点位
   注意：PPT 里很多结论是经验概率，不是公理，所以每条推断都带 confidence，
        跟事实冲突时只降低权重、不报错，避免在实战里把自己卡死。
*/

/* ---------- M1 牌力评分：整套方法的度量衡 ----------
   资料明确写的分值：登基牌 +1、4 头炸 +2、5 头炸 +2、同花顺 +3、赘牌 -1、普通牌 0。
   资料没写死、交接包里标了「待确认」的三项，先按下面口径落地（老板一句话就能改）：
     · 6 头炸 +3、7 头炸 +4、8 头炸 +5：越难成越值钱，跟 4/5 头保持单调
     · 天王炸按 4 头炸 +2 计，四个王本身各算一张登基牌 +1，合计 +6
     · 双王就是两张登基牌各 +1，不额外加权
     · 手数不进分数，进角色判定（资料把 8 到 9 手 / 10 到 11 手放在主攻助攻里讲）
   被双下的 -2 分不在本函数里扣，在 selfRole 里按进贡方向扣。 */
function powerDetail(hand, level){
  hand = hand || [];
  var top = 0, bombPts = 0, flushes = 0, burden = 0, bombs = [], cnt = {}, jokers = 0;
  var i, c, r, n;
  for(i = 0; i < hand.length; i++){
    c = hand[i];
    if(c.joker){ jokers++; top++; continue; }        /* 大小王各算一张登基牌 */
    cnt[c.rank] = (cnt[c.rank] || 0) + 1;
    if(c.rank === level) top++;                       /* 级牌（红桃配至少等于级牌，一样算） */
    else if(c.rank === 14) top++;                     /* A 也是登基牌 */
  }
  for(r in cnt){
    if(cnt[r] >= 4){
      n = cnt[r] > 8 ? 8 : cnt[r];
      bombPts += n === 4 ? 2 : n === 5 ? 2 : (n - 3);
      bombs.push({rank:+r, len:n});
    }
  }
  if(jokers >= 4) bombPts += 2;                       /* 天王炸 */
  flushes = flushHands(hand, level).length;
  var groups = decomposeHand(hand, level), g, k;
  for(i = 0; i < groups.length; i++){
    g = groups[i];
    if(g.type !== 'SINGLE') continue;
    for(k = 0; k < g.cards.length; k++){
      c = g.cards[k];
      if(c.joker || c.rank === level || c.rank >= 10) continue;   /* 10 以上算普通牌 0 分 */
      burden++;                                                    /* 拆不掉的孤张小牌 = 赘牌 */
    }
  }
  return {
    score: top + bombPts + flushes * 3 - burden,
    top: top, bombPts: bombPts, bombs: bombs,
    flushes: flushes, flushPts: flushes * 3, burden: burden,
    jokers: jokers, rounds: groups.length
  };
}
function powerScore(hand, level){ return powerDetail(hand, level).score; }
/** 牌型适配：牌型单一、手数少 = 适合主攻；牌型散 = 适合助攻。M2 第 4 条用。 */
function shapeFit(hand, level){
  var groups = decomposeHand(hand, level), kinds = {}, i, t = 0, control = 0;
  for(i = 0; i < groups.length; i++){
    kinds[groups[i].type] = 1;
    if(groups[i].type === 'BOMB') control += 2;
  }
  for(var k in kinds) t++;
  return {kinds:t, rounds:groups.length, control:control};
}
/** 五档牌力分档表（资料原文，照抄）：第一任务 / 第二任务直接给建议文案用。 */
function scoreBand(score){
  if(score >= 8) return {key:'s8', name:'8 分以上，八成是全盘最强牌力',
    first:'自己拿头游', second:'带对家打双上'};
  if(score >= 5) return {key:'s5', name:'5 到 7 分，大概率还有一家也在这一档',
    first:'自己争取头游', second:'不一定拿得到，得看过程'};
  if(score >= 4) return {key:'s4', name:'4 到 5 分，中间位置',
    first:'看对家角色动态定', second:'对家主攻我助攻，对家助攻我主攻'};
  if(score >= 2) return {key:'s2', name:'2 到 4 分，场上大概率还有一家 4 分以下',
    first:'保对家拿头游', second:'自己不被打末游'};
  return {key:'s1', name:'1 分以下，九成情况全场只有你一家这么低',
    first:'拼命保对家头游', second:'自己就是末游定位'};
}
/** 双下修正：本局我方两家都进贡 = 上局被打双下，牌力一律减 2 分再套全局思维。
    资料推导：对手拿到一个登基大牌 +1、处理一个赘牌 -1，相对我方就是 +2。 */
function doubleLoseAdjust(st, seat){
  var tr = st.tribute, items, i;
  if(!tr || !tr.items || !tr.items.length) return 0;
  items = tr.items;
  for(i = 0; i < items.length; i++)
    if(teamOf(items[i].from) === teamOf(seat)) return 2;
  return 0;
}
/** M2 角色定位：牌力分 → 分档 → 主攻 / 助攻。4 到 5 分再按牌型适配细分。
    资料把「4 到 5 分」写成两条独立判断（看对家角色 / 看牌型适配），这里用牌型适配那条，
    因为对家手牌不能读，读了对局就不公平了。 */
function selfRole(st, seat, pd, fit){
  var level = st.level, hand = st.hands[seat] || [];
  pd = pd || powerDetail(hand, level);
  fit = fit || shapeFit(hand, level);
  var cut = doubleLoseAdjust(st, seat);
  var score = pd.score - cut;
  var band = scoreBand(score), role, why;
  if(score >= 5){
    role = 'attack';
    why = '牌力 ' + score + ' 分（' + band.name + '），第一任务' + band.first + '，' +
          '第二任务' + band.second;
  }else if(score >= 4){
    if(fit.kinds <= 2 || fit.rounds <= 9){
      role = 'attack';
      why = '牌力 ' + score + ' 分属中间位置，牌型只有 ' + fit.kinds + ' 种、' +
            fit.rounds + ' 手，整齐，适合自己冲';
    }else{
      role = 'support';
      why = '牌力 ' + score + ' 分属中间位置，牌型散（' + fit.kinds + ' 种 / ' +
            fit.rounds + ' 手），做主攻冲不动，转助攻保对家';
    }
  }else if(score >= 2){
    role = 'support';
    why = '牌力 ' + score + ' 分（' + band.name + '），第一任务' + band.first +
          '，第二任务' + band.second;
  }else{
    role = 'support';
    why = '牌力 ' + score + ' 分（' + band.name + '），定位末游、拼命保对家';
  }
  if(cut) why += '。上局被双下，按资料口径牌力先减 2 分再算，原始分 ' + pd.score + ' → ' + score;
  return {role:role, score:score, raw:pd.score, cut:cut, band:band,
          detail:pd, fit:fit, why:why};
}
/** 领出记录：哪几家领出过什么牌型。M4 预判的原料，只看公开流水。 */
function leadLog(st, seat){
  var out = [], i, mv, firstOfTrick = true, lastTrick = -1;
  for(i = 0; i < st.moves.length; i++){
    mv = st.moves[i];
    if(mv.trickNo !== lastTrick){ lastTrick = mv.trickNo; firstOfTrick = true; }
    if(mv.type === 'play' && mv.info){
      if(firstOfTrick && mv.seat === seat)
        out.push({type:mv.info.type, key:mv.info.key, len:mv.info.len,
                  rank:mv.info.rank || 0, no:mv.trickNo});
      firstOfTrick = false;
    }
  }
  return out;
}
/** 读别人的角色（M2）：只用公开的领出记录和过牌次数，不读手牌。
    主攻信号：领出小牌、领出大牌（说明手里没小牌）、抢自己人的牌权；
    助攻信号：过牌明显多于出牌、领中高单张送对家、从不抢对家的牌。 */
function seatRole(st, s){
  var leads = leadLog(st, s), i, L, atk = 0, sup = 0, why = [];
  var passes = 0, plays = 0, mv, mate = partnerOf(s), tookMate = 0;
  for(i = 0; i < st.moves.length; i++){
    mv = st.moves[i];
    if(mv.seat !== s) continue;
    if(mv.type === 'pass') passes++;
    else if(mv.type === 'play'){
      plays++;
      /* 队友刚出过牌，他立刻压上去 = 抢自己人的牌权，主攻特征 A6 */
      if(i > 0 && st.moves[i-1].seat === mate && st.moves[i-1].type === 'play' &&
         mv.info && st.moves[i-1].info && beats(mv.info, st.moves[i-1].info)) tookMate++;
    }
  }
  for(i = 0; i < leads.length; i++){
    L = leads[i];
    if(L.type === 'SINGLE' && L.rank && L.rank <= 7 && L.rank !== st.level){
      atk += 2; why.push('领出过小单张');
    }else if(L.type === 'SINGLE' && L.rank >= 10){
      atk += 1; why.push('领出过大单张（说明手里没小牌）');
    }else if((L.type === 'PAIR' || L.type === 'TRIPLE_PAIR') && L.key < TIER.TRUMP){
      atk += 1;
    }else if(L.type === 'STRAIGHT' || L.type === 'PAIRS'){
      atk += 1;
    }
  }
  if(tookMate){ atk += 2 * tookMate; why.push('抢过对家的牌权'); }
  if(plays > 0 && passes >= plays * 2 && passes >= 3){ sup += 3; why.push('过牌明显多于出牌'); }
  if(tookMate === 0 && plays >= 4){ sup += 1; }
  var role = atk >= sup + 2 ? 'attack' : (sup >= atk + 2 ? 'support' : 'unknown');
  return {role:role, atk:atk, sup:sup, why:why.join('、') || '出牌太少，还看不出来'};
}
/** M5 记牌：不只记外面还剩几张，还要记「是谁出的」——资料明确要求。
    范围：大小王、逢人配、主牌级牌、A、K，记到 A 就够九成场合用。 */
function bigMemoWho(st, seat){
  var level = st.level, i, j, mv, defs, out = [];
  defs = [
    {label:'大王', total:2, f:function(c){ return c.joker && c.rank === 17; }},
    {label:'小王', total:2, f:function(c){ return c.joker && c.rank === 16; }},
    {label:'逢人配', total:2, f:function(c){ return isWild(c, level); }},
    {label:'主牌级牌', total:6, f:function(c){ return isTrump(c, level); }},
    {label:'A', total:8, f:function(c){ return !c.joker && c.rank === 14 && level !== 14; }},
    {label:'K', total:8, f:function(c){ return !c.joker && c.rank === 13 && level !== 13; }}
  ];
  for(i = 0; i < defs.length; i++){
    var who = [], mine = 0, played = 0, k;
    for(j = 0; j < (st.hands[seat] || []).length; j++) if(defs[i].f(st.hands[seat][j])) mine++;
    for(j = 0; j < st.moves.length; j++){
      mv = st.moves[j];
      if(mv.type !== 'play' || !mv.cards) continue;
      for(k = 0; k < mv.cards.length; k++){
        if(!defs[i].f(mv.cards[k])) continue;
        played++;
        who.push(seatName(mv.seat));
      }
    }
    out.push({label:defs[i].label, total:defs[i].total, mine:mine, played:played,
              unknown:defs[i].total - mine - played, who:who.slice(-6)});
  }
  return out;
}
/** M5 不拆炸弹原理：出过顺子的牌，那个区间里一般没有头炸。
