    best = loneBest || packBest || trumpBest;                             /* 保住对子，先出孤张 */
    usedLone = !!loneBest;
  }
  if(best) return {move:best, code:'L22',
    txt:'下一家（对手）只剩 ' + nr + ' 张，手里没有他接不住的长牌型，' +
        '单张出 ' + cardsLabel(best.cards, e.level) +
        (usedLone ? '，先走孤张，把对子留着收尾' : '，不出小的喂他')};
  return null;
}
/* ---------- L15 判断对手是否到位（先判，因为它决定后面要不要花炸） ----------
   课程原文：先出大牌再出小牌 = 到位（留着摆尾要接）；先出小王留大王 = 没到位。
   到位了挡不住就别浪费炸；没到位要防偷鸡，必须挡。 */
function p15L15(e){
  if(e.isLead || !e.trick) return null;
  if(e.trick.seat === e.partner) return null;
  /* 到位判断是残局的事。扫描抓到的：开局对手 26 张，「先小后大」被判成没到位，
     于是开局就甩炸。加一条只看对手剩牌 10 张以内的局面。 */
  var oppN = (e.st.hands[e.trick.seat] || []).length;
  if(oppN > 6) return null;
  if(p15HasCheap(e)) return null;                    /* 有便宜牌就先按便宜牌走，不到花炸的时候 */
  var home = reachedHome(e.st, e.trick.seat);
  if(!home) return null;
  if(home.ok)
    return {pass:true, code:'L15',
      txt:'对手已经到位：' + home.txt + '。他手里攥的是摆尾要接的牌，这一轮炸上去也拦不住他走完，炸留着后面用'};
  var b = p15SmallBomb(e);
  if(!b) return null;
  return {move:b, code:'L15',
    txt:'对手还没到位：' + home.txt + '。大牌压在小牌前面，这是偷鸡的典型形态，必须拦住，出炸'};
}

/* ---------- L03 末位负责制（课程点名「新手最容易犯的错」之一） ----------
   下家出牌、对家不要、下家是对方主攻 → 我是这轮最后一道防线，必须出炸。 */
function p15L03(e){
  if(e.isLead || !e.trick) return null;
  if(e.trick.seat !== e.next) return null;
  if(!isLastToAct(e.st, e.seat)) return null;
  if(!p15PartnerPassed(e)) return null;
  var rr = e.ctx.readRoles[e.next];
  /* 课程原文说的是「下家是对方主攻」。第一版拿「剩 10 张」当代理，太宽：
     20 局里这条独自下令出炸 35 次，四个人一共就那么几个炸，全被它提前打光。
     现在只认两种：要么角色判定明确是主攻，要么他真的快走完了（6 张以内）。 */
  var attacker = (rr && rr.role === 'attack') || e.nextRemain <= 6;
  if(!attacker) return null;
  var b = p15SmallBomb(e);
  if(!b) return null;
  return {move:b, code:'L03',
    txt:'末位负责制：下家（对手）出的这手、对家已经不要、下家又是奔着头游去的，' +
        '我是这一轮最后一道防线，再放过他就能拿到牌权连着走。出 ' + b.info.len + ' 张炸拦住'};
}

/* ---------- L07 防对家无牌阻挡 ----------
   上家听牌（只剩一手），对家明显挡不住 → 我不能等，必须出炸。 */
function p15L07(e){
  if(e.isLead || !e.trick) return null;
  if(e.trick.seat === e.partner) return null;
  /* 剩 0 张是已经走完了，不是听牌。扫描抓到的：「上家只剩 0 张，已经听牌」是假的。 */
  if(e.prevRemain === 0) return null;
  if(e.prevRemain > 2) return null;
  if(e.trick.info.len >= 5) return null;
  var b = p15SmallBomb(e);
  if(!b) return null;
  return {move:b, code:'L07',
    txt:'上家（对手）只剩 ' + e.prevRemain + ' 张，已经听牌，对家这个位置挡不住他。' +
        '不能等他再拿一次牌权，出炸拦下来'};
}

/* ---------- L12 防对手大炸冲刺 ----------
   对手报 8 张上下、又打出长牌，是大炸冲刺的前兆，不能让他再拿牌权。 */
function p15L12(e){
  if(e.isLead || !e.trick) return null;
  if(e.trick.seat === e.partner) return null;
  var n = (e.st.hands[e.trick.seat] || []).length;
  if(n < 7 || n > 9) return null;
  if(e.trick.info.len < 5) return null;
  var b = p15SmallBomb(e);
  if(!b) return null;
  return {move:b, code:'L12',
    txt:'对手报了 ' + n + ' 张，又打出 ' + e.trick.info.len + ' 张长牌，这是大炸冲刺的前兆。' +
        '不能让他再拿牌权，出 ' + b.info.len + ' 张炸'};
}

/* ---------- L16 打一放一（暂不启用） ----------
   课程原文：我是助攻、对家没机会跑 → 下家的牌不要、上家的小牌也不要，
   用行为告诉对家「打一放一」。
   2026-11-06 20:15 实测：按「助攻 + 对家剩牌 <= 12」实现后，40 局触发 707 次，
   相当于助攻几乎什么都不过问，100 局对打头游率从 55% 掉到 27%、双下从 28% 掉到 12%。
   结论：原文说的是「选择性放一张」，我实现成了「一律放行」，条件没抓准。
   函数保留，等把「放哪一张、留哪一张」的判据想清楚再进规则链。 */

function p15L16(e){
  if(e.isLead || !e.trick) return null;
  if(e.role !== 'support') return null;
  if(e.partnerRemain <= 0) return null;
  if(e.partnerRemain > 12) return null;                 /* 对家自己还一堆牌，放了也接不住 */
  if(e.trick.info.len >= 5) return null;                /* 长牌是冲刺，不能放 */
  if(e.trick.info.key >= TIER.TRUMP) return null;       /* 对手登基牌，放了就是送 */
  if(!p15HasCheap(e)) return null;                      /* 能压的只有炸，本来就该过 */
  return {pass:true, code:'L16',
    txt:'打一放一：我是助攻、对家只剩 ' + e.partnerRemain + ' 张还有机会跑。' +
        '这一手不抢，把牌权让出去，用行为告诉对家「我放你走」'};
}

/* ---------- L01 残局逼炸为先 ----------
   残局、我炸小、手牌接近出完 → 先出对手除炸弹以外压不住的牌，把他的炸逼下来。 */
function p15L01(e){
  if(!e.isLead || !e.endgame) return null;
  if(!e.bombs.length) return null;
  if(e.myRemain > 9) return null;
  if(!e.dengji.length) return null;
  var mv = p15Pick(e.moves, function(m){
    if(m.wilds > 0) return false;              /* 不拿逢人配去试探 */
    if(m.info.type === 'SINGLE' || m.info.type === 'PAIRS') {
      if(m.info.key < TIER.TRUMP) return false;
      /* 逼炸用级牌、A 这些登基牌就够，别拿王去换对手一个炸：
         王换炸是亏的，残局王要用来收官。2026-11-06 20:52 收紧。 */
      if(m.info.type === 'SINGLE' && m.info.key >= TIER.SMALL) return false;
      /* 登基牌本身是炸（比如四张级牌）就不许拆，拆了就没得防了 */
      return breakPenalty(m, e.hand, e.level, e.ctx) < 120;
    }
    return false;
  });
  if(!mv) return null;
  return {move:mv, code:'L01',
    txt:'残局逼炸：我手上还有 ' + e.bombs.length + ' 发炸、剩下 ' + e.myRemain + ' 张，' +
        '先出对手除了炸之外压不住的 ' + TYPE_NAME[mv.info.type] + '，把他的炸逼下来，' +
        '再用自己的炸冲刺'};
}

/* ---------- L21 防炸意识 ----------
   一个登基牌可以先逼一个炸弹，把登基牌分开打，能防更多炸。 */
function p15L21(e){
  if(!e.isLead || !e.late) return null;
  if(e.dengji.length < 2) return null;
  if(!e.bombs.length) return null;
  /* 手里还有 K 以下的孤张就先走它，登基牌留着收牌权。
     「拿登基牌逼炸」只在领出阶段成立不了：领出是我主动，对手接不住可以不要，
     没有一个炸弹会因为一个单张被迫拆（老板 2026-11-07 第 9 手那手单 2 就是这条出来的）。
     所以这条只在「已经没有更便宜的散张可走」时才成立。 */
  if(p15LooseWeak(e.hand, e.level) > 0) return null;
  var mv = p15Pick(e.moves, function(m){
    if(m.info.type !== 'SINGLE') return false;
    if(m.info.key < TIER.TRUMP) return false;
    if(m.info.len !== 1) return false;
    if(m.wilds > 0) return false;              /* 逢人配是全场最金贵的一张，不拿来防一手 */
    /* 只有本来就是孤张的登基牌才配拿出来「防一手」。
       拆对子、拆三张去防一手，等于先自损一张，20:08 修。 */
    if((e.byRank[m.cards[0].rank] || 0) !== 1) return false;
    if(!p15LeadJokerOk(m, e)) return false;    /* 逼炸用级牌、A 就够，不拿王去换对手一个炸 */
    return breakPenalty(m, e.hand, e.level, e.ctx) < 120;   /* 登基牌是炸就不拆 */
  });
  if(!mv) return null;
  return {move:mv, code:'L21',
    txt:'防炸意识：我手上有 ' + e.dengji.length + ' 张登基牌和 ' + e.bombs.length + ' 发炸。' +
        '一个登基牌能逼对手一个炸弹，分开打比一次扔掉防得住更多炸，先出最显眼的一张'};
}

/* ---------- L09 先出明显牌 ----------
   手上散牌全是登基牌时，先出别人容易记住的那几张，别留到最后被算死。 */
function p15L09(e){
  if(!e.isLead) return null;
  if(e.singles.length < 2) return null;
  var i;
  for(i = 0; i < e.singles.length; i++)
    if(e.singles[i] < 13) return null;          /* 还有 K 以下的散牌，就不算「手上全是登基牌」 */
  var mv = p15Pick(e.moves, function(m){
    /* 必须是孤张。原来没这一条，p15Pick 拿的是候选里第一个命中的，
       而 genMoves 按点数从小到大枚举，级牌 rank 是 2（本局打 2 时），
       排在最前面，于是一对 2 被拆开、打出其中一张，还挂着「先出明显牌」的理由
       （老板 2026-11-07 扫描抓到 5 次）。这条规则说的是「散牌全是登基牌」，
       对象本来就该是散张，拆对子属于另一笔账。 */
    if((e.byRank[m.cards[0].rank] || 0) !== 1) return false;
    return m.info.type === 'SINGLE' && m.info.key >= TIER.TRUMP &&
           m.wilds === 0 && p15LeadJokerOk(m, e) &&
           breakPenalty(m, e.hand, e.level, e.ctx) < 120;
  });
  if(!mv) return null;
  return {move:mv, code:'L09',
    txt:'先出明显牌：手上的散牌全是登基牌一档（最小的是 ' + e.singles[0] + '），' +
        '这类牌对手一记就记住，留到最后反而被算死。先出最显眼的那张'};
}

/** 还要几手才能走完（近似）。课程 M1 把「手数少」当作最硬的指标，
 *  shapeScore 会为了「少一个单张」而偏好出单张，跟手数打架，所以这里单算。
 *
 *  2026-11-06 20:52 重写。旧版是「不同点数个数，每碰上一组五连顺子减 4」，
 *  碰上点数少、对子多的一手牌会算出荒谬结果：老板第 40 手那局剩 22 张，
 *  领出单张小王的理由写着「剩下 21 张大约还要 1 手走完」。
 *  9 个点数被两组顺子各减 4，减到只剩 1，于是 L08「手数最少」这一票
 *  全投给了单张，因为单张减得最少。
 *  新算法先按点数估手数（3 张一手，4 至 6 张两手），
 *  再把能并的顺子、连对、钢板一组一组并掉，并掉一组就少几手。
 *  最后兜一条硬底线：一手最多走 6 张，手数不可能少于「总张数 ÷ 6」。
 */
function p15Rounds(hand, level){
  var cnt = {}, wilds = 0, jokers = [], i, c, r, s, j, rounds = 0, okk, changed, guard;
  for(i = 0; i < hand.length; i++){
    c = hand[i];
    if(c.joker){ jokers.push(c); continue; }
    if(isWild(c, level)){ wilds++; continue; }
    cnt[c.rank] = (cnt[c.rank] || 0) + 1;
  }
  /* 王只能单出、对王、天王炸，进不了任何牌型，先单独结算。
     旧写法把王混在点数里按 ceil(n/3) 算，两张同色王算一手（凑巧对），
     一大一小两张王也算一手，但四张王会被算成两手，这里一并修正。 */
  if(jokers.length === 4) rounds += 1;
  else if(jokers.length === 2 && jokers[0].rank === jokers[1].rank) rounds += 1;
  else rounds += jokers.length;
  /* 一、同点起算：4 张以上同点就是炸弹，打出去只占一手。
     旧写法一律 ceil(n/3)，四张炸算两手、六张炸也算两手，从开局就虚高。
     实测（14823 局真人牌局、4137 个决策点，真值＝这个人实际还打了几手）：
     旧算法平均高估 1.21 手、只有 20.3% 估对；只修这一处加三带二合并，
     平均偏差就降到 0.30 手、估对率 31.2%。 */
  for(r in cnt) if(cnt[r] >= 4){ rounds += 1; cnt[r] = 0; }
  for(r in cnt) if(cnt[r] > 0) rounds += Math.ceil(cnt[r] / 3);
  /* 合并算子：从某个点数取走 k 张，返回这次取走让「手数」变化的量。
     旧写法是「五连顺子固定减 4」，隐含假设「每个点数只有 1 张」。
     一旦某点有 2 到 3 张，取走 1 张并不减少它的手数（2 张和 1 张都是一手），
     固定减 4 就减多了。老板 2026-11-06 第 70 手那 11 张，
     人工拆是 5 手（顺子 6 到 10、一对 2、一对 9、一对 7、单 3），
     旧算法给出 3 手，于是冒出「剩 10 张大约还要 2 手走完」这种话。 */
  var takeOne = function(r, k){
    var b = Math.ceil((cnt[r] || 0) / 3);
    var n = (cnt[r] || 0) - k;
    cnt[r] = n > 0 ? n : 0;
    return Math.ceil(cnt[r] / 3) - b;
  };
  /* 二、并钢板：两个连续点数各 3 张 → 两手并一手。合并后不吃亏才真并 */
  guard = 0;
  do{
    changed = false;
    for(s = 2; s + 1 <= 14 && !changed; s++){
      if(!(cnt[s] >= 3) || !(cnt[s+1] >= 3)) continue;
      var dSt = takeOne(s, 3) + takeOne(s+1, 3) + 1;
      if(dSt < 0){ rounds += dSt; changed = true; }
      else { cnt[s] += 3; cnt[s+1] += 3; }
    }
  }while(changed && guard++ < 4);
  /* 三、并连对：三个连续点数各 2 张 → 三手并一手 */
  guard = 0;
  do{
    changed = false;
    for(s = 2; s + 2 <= 14 && !changed; s++){
      if(!(cnt[s] >= 2) || !(cnt[s+1] >= 2) || !(cnt[s+2] >= 2)) continue;
      var dCp = takeOne(s, 2) + takeOne(s+1, 2) + takeOne(s+2, 2) + 1;
      if(dCp < 0){ rounds += dCp; changed = true; }
      else { cnt[s] += 2; cnt[s+1] += 2; cnt[s+2] += 2; }
    }
  }while(changed && guard++ < 4);
  /* 四、并顺子：五个连续点数各 1 张 → 五手并一手。
     放在连对后面，是因为顺子吃单张，连对吃对子，先用对子更划算。 */
  guard = 0;
  do{
    changed = false;
    for(s = 2; s + 4 <= 14 && !changed; s++){
      okk = true;
      for(j = 0; j < 5; j++) if((cnt[s+j] || 0) < 1) okk = false;
      if(!okk) continue;
      var dRn = 1;
      for(j = 0; j < 5; j++) dRn += takeOne(s+j, 1);
      if(dRn < 0){ rounds += dRn; changed = true; }
      else { for(j = 0; j < 5; j++) cnt[s+j] = (cnt[s+j] || 0) + 1; }
    }
  }while(changed && guard++ < 4);
  /* 五、三带二：一个三张带走一个对子，两手并一手。
     这是旧算法最大的单点高估源 —— 手里三张加对子原本各算一手，
     实际上「三 9 带对 2」一手就打出去，走的是一手不是两手。
     带的顺序从最小对子开始：小对子最没用，大对子留着后面还能压人。
     2026-11-08 加：真人数据里 27 张估 11 手、实际 7 手的那些局面，
     大头就压在这一步上。 */
  guard = 0;
  do{
    changed = false;
    var triMin = 0, pairMin = 0;
    for(r in cnt){
      if(cnt[r] >= 3){ if(!triMin || +r < triMin) triMin = +r; }
      else if(cnt[r] === 2){ if(!pairMin || +r < pairMin) pairMin = +r; }
    }
    if(!triMin || !pairMin) break;
    cnt[triMin] -= 3; if(cnt[triMin] <= 0) delete cnt[triMin];
    cnt[pairMin] -= 2; if(cnt[pairMin] <= 0) delete cnt[pairMin];
    rounds -= 1;
    changed = true;
  }while(changed && guard++ < 6);
  if(wilds && rounds > 1) rounds -= 1;   /* 逢人配至少能兜掉一手 */
  /* 硬底线：一次最多出 6 张（钢板、连对），手数不可能比这个更少 */
  var floor = Math.ceil(hand.length / 6);
  if(rounds < floor) rounds = floor;
  return Math.max(1, rounds);
}

/** 还剩几个「散张」：只有一张的点数，加上单独一张的王。
    掼蛋里最难处理的就是散张，每一张都得占一手，还得等牌权。
    P15 第 2 课开局策略第三条原话「先出自己的弱路死牌，留可以顺牌或者可以变化的牌型」，
    散张就是死牌。
    老板 2026-11-06 第 23 手：对家 11 张领出，把三张 A 当柴烧去做三带二 A A A J J，
    出完剩 大王 Q Q J 9 8 7，散张 4 个（J 9 8 7）。要是先出 7、8、9 里的一张，
    出完剩 大王 A A A Q Q J J 9 8，散张只剩 2 个（9 8），三张 A 还完整留着控场。
    手数两条都算 6，全靠散张数分优劣。 */
function p15Loose(hand, level){
  var cnt = {}, wilds = 0, singles = 0, i, c, r;
  for(i = 0; i < hand.length; i++){
    c = hand[i];
    if(isWild(c, level)){ wilds++; continue; }
    if(c.joker){ singles++; continue; }
    cnt[c.rank] = (cnt[c.rank] || 0) + 1;
  }
  for(r in cnt) if(cnt[r] === 1) singles++;
  singles -= Math.min(wilds, singles);    /* 逢人配能带走一张散牌 */
  return Math.max(0, singles);
}
/** 弱路散张：只数「成不了控制牌」的孤张，也就是 K 及以下的单张。
 *  和 p15Loose 的区别就在这一条：p15Loose 把级牌孤张、A 孤张、王都算散张，
 *  于是「出掉级牌能少一个散张」，AI 就学会先把级牌当废牌扔掉。
 *  老板 2026-11-07 第 9 手：下家领出直接打单张 2，本局打 2。
 *  查下来 L08 每一手都在算这个数（lz），级牌孤张被当成累赘，
 *  而出小散张的余牌里，这张级牌孤张反过来又变成 +1 散张，一进一出差 2 个散张，
 *  手数相同时就稳稳地把级牌卖出去了。级牌是控制牌，不是弱路散张，这里分开数。 */
function p15LooseWeak(hand, level){
  var cnt = {}, wilds = 0, singles = 0, i, c, r;
  for(i = 0; i < hand.length; i++){
    c = hand[i];
    if(isWild(c, level)){ wilds++; continue; }
    if(c.joker) continue;                            /* 王是控制牌，不算弱路散张 */
    cnt[c.rank] = (cnt[c.rank] || 0) + 1;
  }
  for(r in cnt) if(cnt[r] === 1 && !isDengjiRank(+r, level)) singles++;
  singles -= Math.min(wilds, singles);               /* 逢人配能带走一张散牌 */
  return Math.max(0, singles);
}
