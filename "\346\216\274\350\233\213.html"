function sameCards(a, b){
  if(!a || !b || a.length !== b.length || !a.length) return false;
  var x = a.map(function(c){ return c.id; }).sort().join(','),
      y = b.map(function(c){ return c.id; }).sort().join(',');
  return x === y;
}
/* verdict：same 照建议打 / diff 换了打法 / overplay 建议过但你出了 / overpass 建议出但你过了 */
function logDecision(adv, actual){
  if(!st.decisions) st.decisions = [];
  var v = 'diff';
  if(!adv) v = 'diff';
  else if(adv.action === 'pass' && actual.type === 'pass') v = 'same';
  else if(adv.action === 'play' && actual.type === 'play') v = sameCards(adv.cards, actual.cards) ? 'same' : 'diff';
  else if(adv.action === 'pass' && actual.type === 'play') v = 'overplay';
  else if(adv.action === 'play' && actual.type === 'pass') v = 'overpass';
  var before = st.hands[0].length + (actual.type === 'play' ? actual.cards.length : 0);
  st.decisions.push({
    moveIdx: st.moves ? st.moves.length - 1 : -1,
    trickNo: st.trickNo, handBefore: before,
    adv: adv, actual: actual, verdict: v
  });
}

