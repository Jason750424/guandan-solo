 * applyLevel 是纯函数，直接喂造好的结算结果，不靠随机牌局，所以每次都必跑、结论稳定。
 */
function runLevelTests(){
  var fails = [];
  function fake(level, lv, leadSeat){ return {level:level, lv:lv.slice(), leadSeat:leadSeat}; }
  function chk(name, cond, detail){ if(!cond) fails.push('【升级】' + name + (detail ? '：' + detail : '')); }
  var r;
  /* ⓪ 升级级数只看名次，且只有头游那一方升（老板 2026-11-07 抓的错：
     我方打出对手双下，结算卡上「我方升 3 级　对方升 1 级」，对方垫底还跟着升）。
     这里把 24 种名次排列全部穷举，一条不漏：
     头游方升几级看搭档名次——搭档二游 3 级、三游 2 级、末游 1 级；输方一律 0 级。 */
  var perms = [];
  (function gen(cur, rest){
    if(!rest.length){ perms.push(cur.slice()); return; }
    for(var i=0;i<rest.length;i++){
      var nx = rest.slice(); nx.splice(i,1);
      gen(cur.concat([rest[i]]), nx);
    }
  })([], [0,1,2,3]);
  for(var pi=0; pi<perms.length; pi++){
    var ord = perms[pi], sr = settleRound({finished:ord.slice()});
    var ft = teamOf(ord[0]);
    var matePlace = ord.indexOf(partnerOf(ord[0])) + 1;
    var want = matePlace === 2 ? 3 : (matePlace === 3 ? 2 : 1);
    if(sr.teams[ft] !== want)
      fails.push('【升级】名次 ' + ord.join('') + ' 头游方应升 ' + want + ' 级，实际 ' + sr.teams[ft]);
    if(sr.teams[1 - ft] !== 0)
      fails.push('【升级】名次 ' + ord.join('') + ' 输方不该升级，实际升 ' + sr.teams[1 - ft]);
  }
  /* ① K 局双下升 3 级 → 停在 A，不许越过 A 回到 2（旧版 wrapLevel 就是在这里出问题） */
  var s1 = fake(13, [13, 5], 0);
  r = applyLevel(s1, {order:[0,2,1,3], teams:[3,0]});
  chk('K 局双下升 3 级应停在 A', s1.lv[0] === 14, '实际 ' + s1.lv[0]);
  chk('升到 A 后下一局级牌应为 A', r.nextLevel === 14, '实际 ' + r.nextLevel);
  chk('K 局不是打 A，不应判通关', r.matchOver === false);
  /* ② 两队级牌各自记，下一局用头游方的级牌 */
  var s2 = fake(5, [5, 2], 1);
  r = applyLevel(s2, {order:[0,2,1,3], teams:[2,0]});
  chk('两队级牌应各自记', s2.lv[0] === 7 && s2.lv[1] === 2, '实际 ' + s2.lv.join('/'));
  chk('下一局级牌取头游方', r.nextLevel === 7, '实际 ' + r.nextLevel);
  /* ③ 打 A 成功：级牌拥有方拿头游 → 通关 */
  var s3 = fake(14, [14, 9], 0);
  r = applyLevel(s3, {order:[0,2,1,3], teams:[3,0]});
  chk('打 A 成功应通关且胜方正确', r.matchOver === true && r.winner === 0);
  /* ③b 打 A 时本方拿头游、但搭档垫底 → 不算过 A（官方口径：搭档不能是末游） */
  var s3b = fake(14, [14, 9], 0);
  r = applyLevel(s3b, {order:[0,1,3,2], teams:[1,0]});
  chk('头游但搭档垫底，不算过 A', r.matchOver === false,
      '搭档名次 4，matchOver=' + r.matchOver);
  /* ④ 打 A 失败：对方拿头游 → 记一次失败，级牌留在 A（满三次才退回 2） */
  var s4 = fake(14, [14, 9], 0);
  r = applyLevel(s4, {order:[1,3,0,2], teams:[0,3]});
  chk('打 A 失败第一次，级牌仍留在 A', s4.lv[0] === 14 && s4.tryA[0] === 1,
      'lv=' + s4.lv[0] + ' 次数=' + s4.tryA[0]);
  chk('打 A 失败不应判通关', r.matchOver === false);
  chk('打 A 失败后下一局打对方级牌', r.nextLevel === s4.lv[1], '实际 ' + r.nextLevel);
  /* ④b 连续三次打 A 不过 → 退回 2 重打 */
  var s4b = fake(14, [14, 9], 0);
  s4b.tryA = [2, 0];
  r = applyLevel(s4b, {order:[1,3,0,2], teams:[0,3]});
  chk('打 A 三次不过应退回 2', s4b.lv[0] === 2 && s4b.tryA[0] === 3,
      'lv=' + s4b.lv[0] + ' 次数=' + s4b.tryA[0]);
  /* ⑤ 对方打 A 成功 */
  var s5 = fake(14, [9, 14], 1);
  r = applyLevel(s5, {order:[1,3,0,2], teams:[0,3]});
  chk('对方打 A 成功应通关且胜方为对方', r.matchOver === true && r.winner === 1);
  /* ⑥ 反复升级不许越界 */
  var s6 = fake(12, [12, 12], 0), k;
  for(k=0;k<20;k++) applyLevel(s6, {order:[0,2,1,3], teams:[3,0]});
  chk('反复升级后级牌不得越界', s6.lv[0] <= 14 && s6.lv[1] <= 14, '实际 ' + s6.lv.join('/'));
  return fails;
}
/** 流程用例：接风、轮转。拿造好的状态直接喂 rotate，不靠随机牌局，所以每次都必跑。 */
function runFlowTests(){
  var fails = [];
  function chk(n, c, d){ if(!c) fails.push('【流程】' + n + (d ? '：' + d : '')); }
  /* 接风：0 号头游已经出完，这一轮其余三家都不要 → 该由他的同伴（2 号）领出 */
  var st = newGame({firstDeal:true, leadSeat:0});
  var one = st.hands[1][0];
  st.hands[0] = [];
  st.finished = [0]; st.finishMeta = {0:{}};
  st.trick = {seat:0, cards:[one], info:identify([one], st.level)};
  st.passes = 2;
  rotate(st, 1);
  chk('接风应交给同伴（对家）领出', st.turn === 2, '实际 ' + st.turn);
  /* 我方两家都走完 = 双下，本局立即收局，不再让剩下两家硬打。
     2026-11-06 21:38 老板第一局第 100 手：「对家出完最后一张牌，我们就把对手打了双下，
     这一局就结束了，后面不需要再出牌」。
     这条用例原来期望的是「同伴也走完 → 顺延到下一位在场玩家」，
     那等于让双下之后再打两轮，期望本身写错了，改成验证立即收局。 */
  var st2 = newGame({firstDeal:true, leadSeat:0});
  var c2 = st2.hands[1][0];
  st2.hands[0] = []; st2.hands[2] = [];
  st2.finished = [0,2]; st2.finishMeta = {0:{},2:{}};
  st2.trick = {seat:0, cards:[c2], info:identify([c2], st2.level)};
  st2.passes = 1;
  rotate(st2, 1);
  chk('我方两家都走完（双下）应立即收局', st2.phase === 'roundEnd' && st2.turn === -1,
      '实际 phase=' + st2.phase + ' turn=' + st2.turn);
  chk('双下收局后名次补齐四家', st2.finished.length === 4, JSON.stringify(st2.finished));
  /* 本轮最大的一家还在场 → 领出权还给他 */
  var st3 = newGame({firstDeal:true, leadSeat:0});
  var c3 = st3.hands[1][0];
  st3.trick = {seat:1, cards:[c3], info:identify([c3], st3.level)};
  st3.passes = 3;
  rotate(st3, 3);
  chk('本轮最大者在场时由他领出', st3.turn === 1, '实际 ' + st3.turn);
  return fails;
}
/** 跑 n 局全 AI 对局：校验牌数守恒、出牌合法、终局完整、教学面板非空 */
function runSelfTest(n, diff){
  n = n || 100;
  var errs = runRuleTests().concat(runLevelTests(), runFlowTests());
  var games = 0, moves = 0, passes = 0, g, guard, seat, act, res;
  for(g=0; g<n; g++){
    try{
      var st = newGame({firstDeal:true, leadSeat:g % 4, diff:diff});
      st.noLog = true;                 /* 自检跑 100 局，不记复盘流水，省内存也省时间 */
      guard = 0;
      while(st.phase === 'play' && guard++ < 400){
        seat = st.turn;
        var total = st.hands[0].length + st.hands[1].length + st.hands[2].length + st.hands[3].length;
        if(total !== 108 - st.played.length){
          errs.push('局' + g + ' 第' + guard + ' 手：牌数不平 ' + total + ' vs ' + (108 - st.played.length));
          break;
        }
        act = chooseAction(st, seat);
        if(act.type === 'play'){
          res = tryPlay(st, seat, act.cards);
          if(!res.ok) errs.push('局' + g + ' 座位' + seat + ' 非法出牌：' + res.why);
          else moves++;
        }else{
          res = tryPass(st, seat);
          if(!res.ok) errs.push('局' + g + ' 座位' + seat + ' 非法过牌：' + res.why);
          else passes++;
        }
        rotate(st, seat);
        /* 教学面板抽检：任一座位都必须给出非空方案 */
        if(guard % 4 === 0){
          for(var ts=0; ts<4; ts++){
            var td = teach(st, ts);
            if(!td.plans || !td.plans.length || !td.plans[0].reason || !td.plans[0].title)
              errs.push('局' + g + ' 教学面板出牌建议为空');
            if(!td.situation || !td.situation.strategy || !td.situation.strategy.t)
              errs.push('局' + g + ' 局势分析为空');
            if(!td.groups || !td.groups.length) errs.push('局' + g + ' 手牌解析为空');
          }
        }
      }
      if(guard >= 400) errs.push('局' + g + ' 死循环未结束');
      if(st.finished.length !== 4) errs.push('局' + g + ' 终局名次异常：' + st.finished.join(','));
      else{
        var uniq = {};
        st.finished.forEach(function(s){ uniq[s] = 1; });
        if(Object.keys(uniq).length !== 4) errs.push('局' + g + ' 名次有重复座位');
        var rr = settleRound(st);
        /* 2026-11-07 规则修正后：只有头游方升，输方 0 级，两队不可能同时升。
           校验从「每队 1~3 级」改成「合计 1~3 级且只有一队非 0」。 */
        var upSum = rr.teams[0] + rr.teams[1];
        if(upSum < 1 || upSum > 3) errs.push('局' + g + ' 升级级数异常：' + rr.teams.join('/'));
        if(rr.teams[0] > 0 && rr.teams[1] > 0)
          errs.push('局' + g + ' 两队同时升级，规则应只升头游方：' + rr.teams.join('/'));
        if(teamOf(st.finished[0]) !== (rr.teams[0] > 0 ? 0 : 1))
          errs.push('局' + g + ' 升级方不是头游方：' + rr.teams.join('/'));
      }
      /* 连续开下一局：进贡还贡 + 重发牌。
         2026-11-07：这里原来写死 leadSeat = 上局头游，正好把「进贡方先出」整条规则屏蔽掉，
         自检等于一直在测一条不会用到真实玩法里的路径。改成不指定，走真实分布。 */
      var prevFirst = st.finished[0];                    /* startRound 会清空 finished，先留一份 */
      var lvRes = applyLevel(st, settleRound(st));
      if(st.lv[0] > 14 || st.lv[1] > 14) errs.push('局' + g + ' 级牌越界：' + st.lv.join('/'));
      if(st.level > 14 || st.level < 2)  errs.push('局' + g + ' 本局级牌越界：' + st.level);
      if(lvRes.matchOver){ games++; continue; }          /* 打 A 通关就不再发下一局 */
      startRound(st, {});
      if(st.turn < 0 || st.turn > 3) errs.push('局' + g + ' 下一局先手异常：' + st.turn);
      if(teamOf(st.levelOwner) !== teamOf(prevFirst))
        errs.push('局' + g + ' 级牌没有跟着头游方走：庄家 ' + st.levelOwner + ' 头游 ' + prevFirst);
      var t2 = st.hands[0].length + st.hands[1].length + st.hands[2].length + st.hands[3].length;
      if(t2 !== 108) errs.push('局' + g + ' 重发牌后总数 ' + t2);
      if(st.hands[0].length !== 27) errs.push('局' + g + ' 重发牌后手牌 ' + st.hands[0].length);
      games++;
    }catch(e){
      errs.push('局' + g + ' 异常：' + (e && e.message ? e.message : e));
    }
  }
  return {
    games:games, moves:moves, passes:passes,
    totalErrors:errs.length, errors:errs.slice(0,20)
  };
}

/* ===================== 导出 ===================== */
return {
