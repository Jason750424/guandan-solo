function runRuleTests(){
  var fails = [], i, j, all = [], cs;
  for(i=0;i<genericCases().length;i++) all.push({c:genericCases()[i], lv:null});
  [2,3,5,10,14].forEach(function(lv){
    var lc = levelCases(lv);
    for(var k=0;k<lc.length;k++) all.push({c:lc[k], lv:lv});
  });
  /* 通用用例也在多个级牌下跑一遍，验证级牌变化不影响非级牌牌型 */
  for(i=0;i<all.length;i++){
    cs = all[i].c;
    var lv = all[i].lv;
    var info = identify(cs.cards, lv === null ? 5 : lv);
    var got = info ? info.type : null;
    var tag = lv === null ? '' : '·级牌' + lv;
    if(got !== cs.expectType){
      fails.push('【牌型' + tag + '】' + cs.name + '：期望 ' + cs.expectType + '，实际 ' + got);
      continue;
    }
    if(cs.against && cs.expectWin !== null){
      var b = identify(cs.against, lv === null ? 5 : lv);
      if(!b){ fails.push('【对照牌型无效' + tag + '】' + cs.name); continue; }
      var win = beats(info, b);
      if(win !== cs.expectWin)
        fails.push('【比较' + tag + '】' + cs.name + '：期望 ' +
          (cs.expectWin ? '能压过' : '压不过') + '，实际' + (win ? '能压过' : '压不过'));
    }
  }
  return fails;
}
