  for(j = 0; j < pairs.length; j++) if(!minPair || pairs[j] < minPair) minPair = pairs[j];
  for(j = 0; j < singles.length; j++){
    if(!minSingle || singles[j] < minSingle) minSingle = singles[j];
    if(singles[j] > maxSingle) maxSingle = singles[j];
