       老板原话：「剩下红配加三个 10 是炸弹，是一手牌并且容易出」。
       上面那条「不拿炸接队友」管的是"出炸"，这条管的是"拆炸"，两种情况是一回事，
       都是把炸弹的完整性让给队友这一轮。 */
    if(breakPenalty(mv, hand, st.level, ctx) >= 120) continue;
    if(mv.info.type !== t.type || mv.info.len !== t.len) continue;
    if(mv.info.key >= TIER.TRUMP) continue;                   /* 不拿级牌、王接队友 */
    if(!best || mv.info.key < best.info.key) best = mv;
  }
  if(!best) return null;
  var after = p15Rounds(restAfter(hand, best.cards), st.level);
  if(after > p15Rounds(hand, st.level)) return null;          /* 接完手数变多，不接 */
  return {type:'play', cards:best.cards, info:best.info,
          reason:'队友出的这手我接得住。他剩 ' + his + ' 张，我只有 ' + mine +
                 ' 张，牌权在我手里才推得动。出 ' + cardsLabel(best.cards, st.level) +
                 ' 接过来，这不是抢队友，是替他往前推'};
}

/* ---------- L22 下一家（对手）只剩几张了，领出不许喂牌 ----------
   P15 第 4 课「下家防守点位」讲的就是这件事：出牌要卡在下家接不住的点上。
   老板 2026-11-06 第 70 手：对家（队友）只剩 2 张，下家（对手）领出先打一张 3，
