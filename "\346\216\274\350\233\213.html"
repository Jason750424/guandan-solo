  p15LooseWeak:p15LooseWeak, p15DengjiSpent:p15DengjiSpent, p15BombSplit:p15BombSplit,
  p15SplitSmallPair:p15SplitSmallPair, p15LateKeepControl:p15LateKeepControl,
