<script>
/* =========================================================================
 *  掼蛋 · 核心逻辑层（无 DOM 依赖，可被 Node 抽出做自检）
 *  Deck / RuleEngine / GameState / AIStrategy / TeachingAdvisor / SelfTest
 * ========================================================================= */
var GD = (function(){
'use strict';

/* ===================== 常量 ===================== */
var SUIT_CH   = ['♠','♥','♣','♦'];
/* 花色配色：黑桃黑、红桃红、梅花绿、方块蓝——四色分明，不靠红黑二分 */
