  if(mine > 10) return null;                    /* 自己牌还多，不抢这一轮 */
  var t = st.trick.info, best = null, i, mv;
  for(i = 0; i < moves.length; i++){
    mv = moves[i];
    if(isBombFamily(mv.info.type)) continue;                  /* 不拿炸接队友 */
    /* 2026-11-08 第 107 手：接这一手要是把自己的炸弹拆了，宁可不接。
       当时手里是「配 + 三 7 + 三 10」，七张牌只够凑一个炸弹（配牌只有一张）。
       两个候选「三 7 带对 10」和「三 10 带对 7」都要从另一个三条里抽两张当对子，
       等于拿一个炸换一手普通牌型。当时选中的那个更亏：出完只剩 配 + 10♣ 一对小 10，
