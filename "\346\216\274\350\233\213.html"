function undo(){
  var keep = (st.undoStack || []).slice();
  if(!keep.length){ toast('没有可悔的步'); return; }
  clearTimeout(timer);
  /* 一路退到「轮到你做决定」的那一刻，中间电脑走的那几步一起撤掉。
     老板 2026-11-06 21:38 第三局第 105 手：点了「不要」点错了，再点悔一步没反应。
     病根：悔一步只弹一次快照，可这中间下家、对家、上家已经各走了一手，
     弹掉的只是最后一步，回到的还是电脑的回合，看着就像没动。
     掼蛋的悔一步，玩家要的是「我上一步撤掉重来」，不是「退一手牌」。
     碰到结算场面（roundEnd）就停在结算前，不要把上一局也退回去。 */
  var back = 0, snap = null, guard = 0;
  while(keep.length && guard++ < 12){
    snap = keep.pop(); back++;
    if(snap.phase === 'play' && snap.turn === 0) break;
    if(snap.phase === 'roundEnd') break;
  }
  if(!snap){ toast('没有可悔的步'); return; }
  st = snap;
  st.undoStack = keep;
  st.intentLog = st.intentLog || {};
  sel = {}; pauseUntil = 0;
  renderAll();
  if(back <= 1) toast('已悔一步');
  else toast('已退回到你上一次出手前（连同电脑的 ' + (back - 1) + ' 步一起撤回）');
  if(st.phase === 'play' && st.turn !== 0) scheduleAi();
}
