    mv = st.moves[i];
    if(mv.seat !== s || mv.type !== 'play' || !mv.info) continue;
    seq.push(mv.info);
  }
  if(seq.length < 2) return null;
  first = seq[0]; last = seq[seq.length - 1];
  firstBig = first.key >= TIER.TRUMP || (first.rank || 0) >= 12;
  lastSmall = (last.rank || 0) > 0 && (last.rank || 0) <= 7;
  if(firstBig && lastSmall) return {ok:true, txt:'先出大牌再出小牌，说明手里留着摆尾要接的牌，已经到位'};
  if(!firstBig && (last.key >= TIER.TRUMP || (last.rank || 0) >= 13))
    return {ok:false, txt:'小牌在前、大牌压后，还没到位，小心他偷鸡'};
  return null;
