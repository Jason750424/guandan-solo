    if(c.joker || isWild(c, level)) continue;
    cnt[c.rank] = (cnt[c.rank] || 0) + 1;
  }
  for(i = 0; i < move.cards.length; i++){
    c = move.cards[i];
    if(c.joker || isWild(c, level)) continue;
    used[c.rank] = (used[c.rank] || 0) + 1;
  }
  for(r in cnt){
    if(cnt[r] < 4) continue;
    u = used[r] || 0;
    if(u > 0 && u < 4) return true;            /* 四拆三、四拆两对 */
