<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>生晟AI工坊 · 掼蛋</title>
<style>
:root{
  --bg:#0e1116; --panel:#171e27; --line:#242c38;
  --fg:#e6edf3; --dim:#8b98a9; --dim2:#5f6b7a;
  --felt:#1d5c40; --felt2:#14432e; --felt3:#0f3222;
  --cream:#f6f1e3; --red:#d64541; --red2:#e85a52;
  --gold:#e0b048; --green:#3fb950;
  --shadow:0 8px 24px rgba(0,0,0,.45);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:var(--bg); color:var(--fg);
  font:14px/1.55 -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  overflow:hidden;
}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
b{font-weight:700}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:#2c3542;border-radius:4px}

/* ============ 布局 ============ */
.wrap{
  width:100%; height:100vh; display:grid;
  grid-template-columns:minmax(0,1fr) 396px;
  grid-template-rows:auto minmax(0,1fr) auto;
  grid-template-areas:"top top" "table panel" "mine panel";
}
body.no-panel .wrap{grid-template-columns:minmax(0,1fr) 0}
body.no-panel #panel{overflow:hidden;border-left-color:transparent}

/* ============ 顶栏 ============ */
.topbar{
  grid-area:top; display:flex; align-items:center; gap:14px;
  padding:9px 16px; background:linear-gradient(180deg,#171e27,#121821);
  border-bottom:1px solid var(--line);
}
.brand{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:700;letter-spacing:.5px;white-space:nowrap;cursor:pointer;user-select:none}.brand .gd-logo{width:27px;height:27px;border-radius:6px;flex:none;display:block;box-shadow:0 0 0 1px rgba(230,237,243,.30),0 1px 5px rgba(0,0,0,.5)}.brand .bd-txt{display:flex;flex-direction:column;line-height:1.15}
.brand small{display:block;font-size:11px;font-weight:400;color:var(--dim2);letter-spacing:0}
.chips{display:flex;gap:8px;flex-wrap:wrap;flex:1;min-width:0}
.chip{
  display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:20px;
  background:#1d2531;border:1px solid var(--line);font-size:12.5px;color:var(--dim);white-space:nowrap
}
.chip b{color:var(--fg);font-weight:600}
.chip.good b{color:var(--green)}
.chip.warn b{color:var(--gold)}
.chip.lv{border-color:#4a3d1c;background:linear-gradient(180deg,#2b2312,#221c10)}
.chip.lv .s{font-size:17px;font-weight:800;color:var(--gold)}
.chip.lv small{color:#b9973f;font-size:11px}
.topacts{display:flex;gap:8px;margin-left:auto;flex-shrink:0}
.btn{
  padding:7px 14px;border-radius:8px;background:#212a36;border:1px solid var(--line);
  font-size:13px;color:var(--fg);transition:.15s;white-space:nowrap
}
.btn:hover{background:#2a3543;border-color:#3a4655}
.btn:disabled{opacity:.35;cursor:not-allowed}
.btn-teach{background:linear-gradient(180deg,#e0b048,#c8963a);color:#241a05;font-weight:700;border-color:#8e6c22}
.btn-teach:hover{background:linear-gradient(180deg,#eec25c,#d3a044)}
.btn-teach.on{background:linear-gradient(180deg,#4a5568,#3d4757);color:#e6edf3;border-color:#3a4655}
.btn-primary{background:linear-gradient(180deg,#3f8f5f,#2f7049);border-color:#255c3c;font-weight:600}
.btn-primary:hover{background:linear-gradient(180deg,#47a06c,#357c52)}
/* 难度 / 理牌这类小开关，比主按钮窄一档 */
.btn-slim{padding:7px 10px;font-size:12.5px;color:var(--dim)}
.btn-slim:hover{color:var(--fg)}
.btn-slim.on{color:var(--gold);border-color:#5a4718;background:#241f12}
.turn-hint.win{background:linear-gradient(180deg,#3a2f10,#2a230c);border-color:var(--gold);color:#f4d98a;font-weight:700}

/* ============ 桌面 ============ */
.table{
  grid-area:table; position:relative; margin:10px 12px 0;
  border-radius:18px; overflow:hidden;
  background:radial-gradient(ellipse at 50% 38%, #24714f 0%, var(--felt) 42%, var(--felt2) 72%, var(--felt3) 100%);
  box-shadow:inset 0 0 0 1px #1a4a35, inset 0 0 90px rgba(0,0,0,.45), var(--shadow);
  display:grid; grid-template-columns:200px minmax(0,1fr) 200px;
  grid-template-rows:auto minmax(0,1fr); gap:8px; padding:10px;
}
.table::after{
  content:""; position:absolute; inset:26px; border:1px solid rgba(255,255,255,.055);
  border-radius:12px; pointer-events:none;
}
.seat{position:relative;z-index:2}
.seat-top{grid-area:1/2/2/3;justify-self:center}
.seat-left{grid-area:2/1/3/2;align-self:center}
.seat-right{grid-area:2/3/3/4;align-self:center;justify-self:end}
.seat-box{
  background:rgba(8,22,16,.5); border:1px solid rgba(255,255,255,.13); border-radius:12px;
  padding:8px 11px; backdrop-filter:blur(3px); min-width:158px;
}
.seat-box .nm{display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:600}
.seat-box .dot{width:9px;height:9px;border-radius:50%;background:#4a5568;flex:none}
.seat-box.acting .dot{background:var(--gold);box-shadow:0 0 9px var(--gold)}
.seat-box.acting{border-color:var(--gold);background:rgba(46,38,12,.55)}
.seat-box.done{opacity:.5}
.seat-box .tag{margin-left:auto;font-size:10.5px;padding:1px 7px;border-radius:9px;background:#2b3542;color:var(--dim);font-weight:400}
.seat-box .tag.team{background:#1e3a5f;color:#7db4f0}
.seat-box .tag.gone{background:#3d2a2a;color:#e08585}
.seat-box .cnt{font-size:26px;font-weight:800;line-height:1.15;letter-spacing:-.5px}
.seat-box .cnt span{font-size:12px;font-weight:400;color:var(--dim2);margin-left:3px}
.seat-box .sub{font-size:11px;color:var(--dim2);margin-top:1px}
.seat-box .int{font-size:11px;color:var(--gold);margin-top:4px;line-height:1.35}
/* 每家「上一手出了什么」直接贴在自己座位框里。
   网上牌桌（腾讯大掼蛋、各类 H5 房卡）都是这个路子：四家最近一手贴在四角，
   中央只留当前要压的那手。比只堆一条竖流水直观，也不跟中央抢高度。 */
.seat-last{margin-top:5px;padding-top:5px;border-top:1px dashed rgba(255,255,255,.12)}
.seat-last.fresh{border-top-color:rgba(224,176,72,.5)}
.seat-last .sl-t{font-size:10px;color:#8fb3a2;margin-bottom:3px;white-space:nowrap}
.seat-last.fresh .sl-t{color:var(--gold)}
.seat-last .sl-c{display:flex;gap:1px;flex-wrap:wrap;align-items:center}
.seat-last .card.mini{width:22px;height:30px;border-radius:3px;box-shadow:0 1px 3px rgba(0,0,0,.4)}
.seat-last .card.mini .rn{font-size:11px}
.seat-last .card.mini .sc{font-size:8px;margin-top:0}
.seat-last .sl-p{font-size:11px;color:#8aa79a;font-style:italic}
.seat-last .sl-more{font-size:10px;color:#9db8ab;align-self:center;margin-left:2px}
/* 已经出完的头游/二游用淡一档，一眼分辨谁还在打 */
.seat-box.done .seat-last{opacity:.62}

/* 中央出牌区（类名须与 HTML 中 class="center" 保持一致） */
.center{
  grid-area:2/2/3/3;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
  gap:7px;min-height:0;padding:6px;position:relative
}
.turn-hint{
  font-size:12.5px;color:#cfe6da;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.12);
  padding:4px 14px;border-radius:18px;white-space:nowrap
}
.turn-hint b{color:var(--gold)}
/* 局末结算卡：一局打完不再自己发牌，等老板选「继续下一局」还是「先复盘」。
   2026-11-07 老板要求：每局结束都要停下来问一句。 */
/* 结算态：牌桌不再裁剪，结算卡整张显示（2026-11-18 老板要求四家摊牌看全）。
   :has 是让子元素状态反选父级牌桌，Chrome/Edge 都支持；不支持的浏览器退回原样也不影响出牌。 */
.table:has(.center.is-result){overflow:visible;z-index:5;background-color:rgba(20,67,46,.92)}
.round-end{
  position:relative;z-index:20; /* 结算时抬到手牌区上方，避免卡片下半被桌沿盖住（2026-11-18） */
  width:100%;max-width:660px;flex:none;display:flex;flex-direction:column;gap:7px;align-items:center;
  padding:13px 20px;border-radius:12px;
  background:linear-gradient(180deg,#4a3c16,#2b230c);border:1px solid var(--gold);
  box-shadow:0 2px 14px rgba(0,0,0,.45)
}
.re-head{font-size:17px;font-weight:700;color:#ffd76b;letter-spacing:1px}
.re-order{font-size:14px;color:#f2e9d0;text-align:center;line-height:1.9}
.re-order b{color:#fff}
.re-acts{display:flex;gap:12px;margin-top:3px}
.re-btn{
  font-size:14px;line-height:1.6;padding:7px 26px;border-radius:10px;cursor:pointer;
  background:#1e3328;border:1px solid rgba(255,255,255,.34);color:#e4f0e9;white-space:nowrap
}
.re-btn:hover{background:#2b4536;border-color:var(--gold);color:#fff}
.re-btn.primary{background:var(--gold);border-color:var(--gold);color:#241d0a;font-weight:700}
.re-btn.primary:hover{filter:brightness(1.1)}
.re-tip{font-size:12px;color:#c9b98a;line-height:1.6;text-align:center}
/* 局末四家剩牌：一局打完把还留在手里的牌全摊开，只在结算卡和通关提示里出现。
   2026-11-11 老板要求：被双下时，我和对家剩下的牌也要看得见。
   只读展示，不挂 data-id；限高自带滚动，别把中央的出牌过程挤没。 */
.re-hands{
  width:100%;max-height:clamp(196px,32vh,300px);overflow-y:auto;overflow-x:hidden;
  border-top:1px dashed rgba(224,176,72,.35);padding-top:6px;
  display:flex;flex-direction:column;gap:4px
}
.re-hands-h{font-size:11.5px;color:#e0c483;text-align:left;letter-spacing:.5px;flex:none}
.re-hands-row{display:flex;align-items:flex-start;gap:8px;min-height:36px;flex:none}
.re-hands-n{
  flex:0 0 84px;text-align:left;font-size:11.5px;color:#cfe6da;
  white-space:nowrap;line-height:36px
}
.re-hands-n b{color:#fff}
.re-hands-c{display:flex;flex-wrap:wrap;gap:2px;align-items:center;min-width:0}
.re-hands-c .card.mini{
  width:26px;height:36px;border-radius:3px;box-shadow:0 1px 3px rgba(0,0,0,.4);
  pointer-events:none;cursor:default
}
.re-hands-c .card.mini .rn{font-size:13px}
.re-hands-c .card.mini .sc{font-size:10px;margin-top:0}
/* 小牌也保留「配 / 主 / 大 / 小」角标，不然级牌和逢人配认不出来 */
.re-hands-c .card.mini .bdg{display:block;font-size:7.5px;padding:0 2px;top:1px;right:1px}
.re-hands-e{font-size:11.5px;color:#8aa79a;line-height:36px;font-style:italic}
/* 通关画面没有结算卡当底板，给摊牌块单独套一个同款卡片框 */
.re-hands-panel{
  width:100%;max-width:560px;flex:none;padding:8px 14px;border-radius:12px;
  background:linear-gradient(180deg,#4a3c16,#2b230c);border:1px solid var(--gold);
  box-shadow:0 2px 14px rgba(0,0,0,.45)
}
/* 开局进贡条：第一圈开打前把「谁贡了什么、谁先出」摆在中央，出过一手就收起 */
.tribute-bar{
  font-size:12px;color:#ffe9a8;background:linear-gradient(180deg,#3d3413,#2a2409);
  border:1px solid rgba(255,215,107,.55);border-radius:10px;padding:5px 12px;
  white-space:normal;line-height:1.6;max-width:92%;text-align:center
}
.tribute-bar b{color:#fff}
/* 出牌过程：常驻一整块，跨轮流水不随每轮结束清空。
   flex:1 之外再加 min-height:112px（能看见 3 行左右）。
   老板 2026-11-06：窗口不高时它会被手牌区挤成一条，只能看见最后一手，
   判断不了「谁出过什么、谁不要」。底下那道底线保证至少三行常显，
   要细看再点右上角【放大看】开浮窗。 */
.trick-list{
  width:100%;flex:1 1 112px;min-height:112px;display:flex;flex-direction:column;
  background:rgba(5,18,12,.46);border:1px solid rgba(255,255,255,.14);
  border-radius:11px;overflow:hidden
}
.trick-head{
  flex:none;display:flex;align-items:center;gap:7px;padding:5px 10px;
  font-size:11px;color:#bcd3c8;background:rgba(0,0,0,.28);
  border-bottom:1px solid rgba(255,255,255,.09);white-space:nowrap
}
.trick-head b{color:var(--gold)}
.trick-head .mid{font-size:10px;color:#9db8ab}
.trick-head .hint{font-size:10px;color:#7ea394}
/* 放大看：小框再高也只能看三行，要认牌还得开浮窗 */
.trick-zoom{
  margin-left:auto;flex:none;font-size:10.5px;line-height:1.5;padding:1px 9px;
  border-radius:9px;background:#1e3328;border:1px solid rgba(224,176,72,.45);
  color:var(--gold);white-space:nowrap
}
.trick-zoom:hover{background:#2b4536;border-color:var(--gold)}
.trick-body{
  flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;
  padding:4px 8px 8px;display:flex;flex-direction:column;gap:3px
}
.trick-row{
  display:flex;align-items:center;gap:6px;padding:2px 7px;border-radius:7px;
  background:rgba(0,0,0,.20);border:1px solid transparent;flex:none;width:100%
}
.trick-row.me{background:rgba(60,48,14,.26)}
.trick-row.top{border-color:var(--gold);background:rgba(60,48,14,.45)}
/* 本轮还没表态的座位：虚线，跟「已经出过牌的流水」区分开 */
.trick-row.pending{background:rgba(0,0,0,.10);border:1px dashed rgba(255,255,255,.13)}
.trick-row.pending .who,.trick-row.pending .left{color:#8aa79a}
.trick-row .who{font-size:11px;color:#bcd3c8;width:30px;flex:none}
.trick-row.me .who,.trick-row.top .who{color:var(--gold);font-weight:700}
.trick-row .tp{font-size:10px;color:#9db8ab;flex:none}
.trick-row .hc{display:flex;gap:1px;flex:none}
.trick-row .left{margin-left:auto;font-size:10px;color:#7ea394;white-space:nowrap;flex:none}
.trick-row .passed{font-size:11px;color:#8aa79a;font-style:italic;padding:3px 2px}
.trick-row .card.tiny{width:22px;height:31px;border-radius:3px}
.trick-row .card.tiny .rn{font-size:10px}
.trick-row .card.tiny .sc{font-size:8px}
.trick-round{
  font-size:10px;color:#7ea394;letter-spacing:.5px;margin:4px 0 0;text-align:center;flex:none
}
.empty-trick{font-size:12px;color:#7ea394;text-align:center;line-height:1.9;padding:12px 0}
/* 当前最大的那一手：单独放大摆在牌桌正中，紧凑一点给过程留地方 */
/* 「轮到谁 · 要压什么」和「当前要压那一手」并成一行。
   原来两行各占 30~50px，矮窗口里正好把出牌过程挤没了（老板 2026-11-06 截图）。 */
.center-top{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:nowrap;width:100%;flex:none;overflow:hidden}
.center-top .turn-hint{flex:0 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.turn-hint .h-short{display:none}
@media (max-width:1300px){
  .center-top .h-full{display:none}
  .center-top .h-short{display:inline}
}
.trick-spot{
  display:flex;flex-direction:row;align-items:center;gap:8px;flex:none;
  padding:3px 11px 4px;border-radius:11px;
  background:rgba(8,22,16,.42);border:1px solid rgba(224,176,72,.42);
  box-shadow:0 6px 20px rgba(0,0,0,.32)
}
.spot-h{font-size:11.5px;color:#cfe6da;white-space:nowrap}
.spot-h b{color:var(--gold)}
.spot-c{display:flex;gap:3px;flex-wrap:wrap;justify-content:center;max-width:100%}
.spot-t{font-size:11px;color:#f0c463;white-space:nowrap}
/* 头游之后把对家的牌亮出来给老板看，只亮队友，不亮两个对手 */
.mate-reveal{
  width:100%;flex:none;display:flex;flex-direction:column;gap:4px;padding:6px 10px;border-radius:10px;
  background:rgba(20,44,32,.55);border:1px dashed rgba(123,211,154,.45)
}
.mate-h{font-size:11.5px;color:#9fe0b6;white-space:nowrap}
.mate-cards{display:flex;gap:2px;overflow-x:auto;padding-bottom:3px;align-items:center}
.spot-c .card.tiny{width:31px;height:43px;border-radius:5px;flex:none}
.spot-c .card.tiny .rn{font-size:14px}
.spot-c .card.tiny .sc{font-size:10px;margin-top:1px}
.mate-cards .card.tiny{width:34px;height:48px;border-radius:5px;flex:none}
.mate-cards .card.tiny .rn{font-size:15px}
.mate-cards .card.tiny .sc{font-size:11px;margin-top:1px}
/* 四家剩牌摘要：读牌用，只报张数和已出张数，不泄露任何具体手牌 */
.seat-strip{width:100%;flex:none;display:flex;gap:5px;justify-content:center;flex-wrap:wrap}
.seat-strip span{
  font-size:10px;color:#9db8ab;background:rgba(0,0,0,.24);
  padding:2px 8px;border-radius:9px;white-space:nowrap
}
.seat-strip span.me{border:1px solid rgba(224,176,72,.45);color:#f0c463}
.seat-strip span.warn{color:#f0c463}
.empty-trick b{color:#cfe6da}
/* 窗口矮的时候（笔记本 125%/150% 缩放很常见）先让不占大用的东西让路，
   把高度留给「出牌过程」：四家剩牌摘要藏掉（左右上三个座位牌和顶部条上本来就写着张数），
   当前要压那一手的牌缩一档。保证过程框还能看见两三行，要细看再点【放大看】。 */
@media (max-height:680px){
  #center .seat-strip{display:none}
  .spot-c .card.tiny{width:26px;height:36px}
  .spot-c .card.tiny .rn{font-size:12px}
  .spot-c .card.tiny .sc{font-size:9px}
  .trick-spot{padding:3px 10px 4px}
  .trick-spot{gap:1px}
}
/* 更矮的窗口（浏览器 100%~110% 缩放、老板截图那台就是 500 出头）：
   上面那条只管中央缩牌，实测 1100×500 时中央只剩 19px，过程整块被牌桌裁掉。
   这里把顶部条、座位框、手牌区一起收紧，把高度还给中间。 */
@media (max-height:700px){
  .topbar{padding:4px 12px;gap:9px}
  .brand{font-size:15px;line-height:1.2}
  .brand small{display:none}
  .btn-slim,.btn{padding:3px 8px;font-size:11.5px}
  /* 座位框：名字和张数并成一行，副标题与 AI 意图让位给「上一手」 */
  .seat-box{padding:5px 8px;min-width:0}
  .seat-box .nm{display:inline-flex;font-size:12px;vertical-align:middle}
  .seat-box .cnt{display:inline-flex;font-size:16px;vertical-align:middle;margin-left:8px}
  .seat-box .cnt span{font-size:10px;margin-left:2px}
  .seat-box .sub,.seat-box .int{display:none}
  .seat-last{margin-top:3px;padding-top:3px}
  .seat-last .sl-t{font-size:9px;margin-bottom:2px}
  .seat-last .card.mini{width:17px;height:23px;border-radius:2px}
  .seat-last .card.mini .rn{font-size:9.5px}
  .seat-last .card.mini .sc{font-size:7px}
  .seat-last .sl-p{font-size:10px}
  .seat-last .sl-more{font-size:9px}
  /* 手牌区收一档，但牌本身不裁（74 + 26 = 100） */
  .mine{padding:3px 12px 6px;gap:3px}
  .hand{height:100px;padding-top:26px}
  /* 这段媒体查询写在手牌基础规则之前，靠 .mine 前缀提特异性才盖得住 */
  /* 200 是折中值：给到 250 时三摞是完整了，中央过程只剩两行，
     反过来又变成「看不见各家出牌」。200 下三摞各差一张，滚一格就到底。 */
  .mine .hand.grouped,.mine .hand.stacked{max-height:clamp(112px,calc(100vh - 420px),230px);padding:4px 8px}
  /* 矮屏手牌区别被 grid 的 auto 行压到 150（三摞只露出组名），给个下限；
     同时手牌块自己别被 flex 压缩，否则 max-height 白设 */
  .mine{min-height:clamp(120px,calc(100vh - 334px),186px)}
  .mine .hand{flex:0 0 auto}
  /* 中央：提示条压小，过程框给足 */
  .center{gap:5px;padding:3px}
  .turn-hint{font-size:11.5px;padding:3px 10px}
  .trick-list{min-height:96px;flex:1 1 96px}
  .trick-row{padding:1px 6px}
  .trick-head{padding:3px 8px;font-size:10.5px}
  .hgroup-lab,.hraw-lab{font-size:10px}
  /* 上面 680 那条把横排间距压到 1px（是给竖排版本留的），这里改回 6px */
  .trick-spot{gap:6px}
  /* 提示条与「当前要压」强制一行，不换行就不多占一行高度 */
  .center-top{flex-wrap:nowrap;gap:5px}
  .spot-c .card.tiny{width:22px;height:30px}
  .spot-c .card.tiny .rn{font-size:11px}
  .spot-c .card.tiny .sc{font-size:8px}
  .spot-h,.spot-t{font-size:10.5px}
  /* 结算卡里的四家剩牌：结算时出牌过程已不重要，优先让四家牌露全（2026-11-18 老板要求）。
     矮屏只把牌缩一档、限高给到四行整高，不再压到 76px 那种只露两家的高度。 */
  .re-hands{max-height:196px}
  .re-hands-c .card.mini{width:22px;height:30px}
  .re-hands-c .card.mini .rn{font-size:11px}
  .re-hands-c .card.mini .sc{font-size:8px}
  .re-hands-n,.re-hands-e,.re-hands-h{line-height:30px}
  .re-hands-row{min-height:30px}
}
/* 极矮窗口（500 上下）：结算卡钉在牌桌顶部并把内部再收一档，
   否则 500 高时卡片底会顶出屏幕（2026-11-18）。 */
@media (max-height:560px){
  .table:has(.center.is-result){align-items:start;overflow:visible}
  /* 极矮窗口信息放不下整屏，让结算区自己能上下滚，保证底部提示不丢 */
  .center.is-result{justify-content:flex-start;overflow-y:auto;max-height:100vh}
  .round-end{gap:4px;padding:9px 16px}
  .re-head{font-size:15px}
  .re-order{font-size:12.5px;line-height:1.6}
  .re-btn{font-size:13px;padding:5px 20px}
  .round-end .re-hands{max-height:150px}
  .round-end .re-hands-row{min-height:26px}
  .round-end .re-hands-n,.round-end .re-hands-e,.round-end .re-hands-h{line-height:26px}
  .round-end .re-hands-c .card.mini{width:20px;height:26px}
}
/* 手牌区背景与桌面衔接 */
.mine{background:linear-gradient(180deg,#0d2418 0%,var(--bg) 46%);border-top:1px solid #1c3b2c}

/* 窄屏（1000~1250 宽的半屏窗口）：两侧座位列由 200 收到 150，
   把宽度还给中央。不收的话中间只剩 240，提示条和「当前要压」并排摆不下，
   提示会被挤出可视区（老板 2026-11-06 那种小窗会碰到）。 */
@media (max-width:1250px){
  .table{grid-template-columns:150px minmax(0,1fr) 150px}
  .seat-box{min-width:0;padding:6px 8px}
  .seat-box .cnt{font-size:21px}
  .seat-box .nm{font-size:12.5px;gap:5px}
  .seat-last .card.mini{width:19px;height:26px}
  .seat-last .card.mini .rn{font-size:10px}
  .brand small{display:none}
  .topacts{gap:5px}
  .topacts .btn{padding:4px 8px;font-size:11.5px}
}
/* ============ 牌 ============ */
.card{
  width:52px;height:74px;border-radius:6px;background:var(--cream);color:#1b1b1b;
  border:1px solid #cfc7b2; box-shadow:0 2px 5px rgba(0,0,0,.4);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  position:relative;flex:none;user-select:none;transition:transform .12s,box-shadow .12s;
  overflow:hidden
}
.card .rn{font-size:19px;font-weight:800;line-height:1;letter-spacing:-.5px}
.card .sc{font-size:14px;line-height:1;margin-top:2px}
/* 手牌叠放时只露左上角，所以点数/花色移到左上角常显位置 */
.card .corner{
  position:absolute;left:3px;top:2px;line-height:1;
  display:flex;flex-direction:column;align-items:center;gap:1px
}
.card .corner .cr{font-size:13px;font-weight:800;letter-spacing:-.5px}
.card .corner .cs{font-size:11px}
.card .bdg{
  position:absolute;top:2px;right:2px;font-size:8px;padding:0 3px;border-radius:3px;
  background:#3b4453;color:#dfe7ef;font-weight:700;line-height:1.4
}
.card.red{color:#bf2f2b}
.card.joker{background:linear-gradient(160deg,#f6f0ff,#e6d9fb);border-color:#b9a2e0}
.card.joker.big{background:linear-gradient(160deg,#fff0f0,#fbd8d8);border-color:#e0a2a2}
.card.wild{background:linear-gradient(160deg,#fffaea,#ffeab4);border-color:#dcb455}
.card.wild .bdg{background:#8a6a12;color:#fff4d4}
.card.trump{background:linear-gradient(160deg,#f0f6ff,#d9e7ff);border-color:#8fb0e8}
.card.trump .bdg{background:#2c4a7d;color:#dbe9ff}
.card.mini{width:32px;height:45px;border-radius:4px}
.card.mini .rn{font-size:13px}
.card.mini .sc{font-size:10px;margin-top:1px}
.card.tiny{width:26px;height:36px;border-radius:3px}
.card.tiny .rn{font-size:11px}
.card.tiny .sc{font-size:9px;margin-top:0}
.card.mini .bdg,.card.tiny .bdg{display:none}

/* 手牌 */
.mine{grid-area:mine;padding:6px 16px 10px;display:flex;flex-direction:column;gap:5px}
.mine-bar{display:flex;align-items:center;gap:12px}
.mine-info{flex:1;min-width:0;font-size:12.5px;color:var(--dim);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mine-info b{color:var(--fg)}
.mine-info .sel{color:var(--red2);font-weight:700}
.mine-info .trib{color:#b9973f}
/* 手牌：叠放时只露左上角，点数在 corner 里。
   --overlap（露出量相关）与 --hand-card（窄屏压缩后的牌宽）均由 JS 按容器宽度动态计算 */
.hand{display:flex;justify-content:center;align-items:flex-end;height:112px;padding-top:34px;position:relative;overflow:hidden;overflow-x:auto}
.hand .card{
  width:var(--hand-card, 52px); height:74px;
  cursor:pointer;margin-left:calc(var(--overlap, 16px) * -1);
  box-shadow:0 2px 6px rgba(0,0,0,.45)
}
.hand .card:first-child{margin-left:0}
.hand .card .rn,.hand .card .sc{display:none}
.hand .card .corner{display:flex}
.hand .card:hover{transform:translateY(-20px);z-index:60!important;box-shadow:0 12px 22px rgba(0,0,0,.55)}
/* 头游后底部摆的是对家的牌，只读：悬停不上浮、鼠标不变手型，
   免得看着像自己还能点选、能替对家出牌 */
.hand.mate-readonly .card{cursor:default}
.hand.mate-readonly .card:hover{transform:none;z-index:auto;box-shadow:0 2px 6px rgba(0,0,0,.45)}
.hand .card.sel{
  transform:translateY(-18px);margin-right:9px;margin-left:calc((var(--overlap, 16px) - 9px) * -1);
  box-shadow:0 0 0 2px var(--red2),0 10px 20px rgba(0,0,0,.5);z-index:55
}
.hand .card.sel:hover{transform:translateY(-24px)}
/* 手动理牌：按住一张左右拖，其余牌实时让位。
   touch-action:none 是为了手机上拖动时页面不跟着横向滚动 */
.hand .card{touch-action:none;-webkit-user-select:none;user-select:none}
.hand .card.drag,
.hand .card.drag:hover,
.hand .card.sel.drag{
  transform:translateY(-36px) scale(1.06);z-index:99;cursor:grabbing;transition:none;
  box-shadow:0 0 0 2px #e8c34a,0 14px 26px rgba(0,0,0,.62)
}
body.hand-dragging{cursor:grabbing}
body.hand-dragging *{-webkit-user-select:none;user-select:none}
/* 按牌型分组分行：一组一块，块内牌全部露出来，不再横向叠压。
   摞叠视图同用网格，只是块内改成上下错开叠放，每张只露顶部点数条。
   这两种都是「看牌」视图，拖动摆牌在横排视图里做，两者用【理牌】按钮切。 */
/* 手牌区高度上限：窗口够高时就是 262（和以前一样，21 张牌不出现内部滚动）；
   只有窗口矮到 730 以下才往下收，把高度让给桌上的出牌过程，下限 150 保住可读。 */
.hand.grouped{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(205px,1fr));
  align-content:start;align-items:start;gap:6px 12px;
  height:auto;max-height:clamp(150px,calc(100vh - 470px),262px);overflow-y:auto;overflow-x:hidden;
  padding:8px 12px;justify-content:normal
}
/* 摞叠视图改成流式排布，不再按「几摞就摊几列」等分整行。
   老板 2026-11-06：三摞就占满一整行、两边全是空白，把未分组那行挤到了看不见的地方。
   现在每摞宽度只按自己那几张牌算，一行能排六七摞，未分组置顶横跨整行。 */
.hand.stacked{
  display:flex;flex-wrap:wrap;align-content:flex-start;align-items:flex-start;
  gap:5px 7px;padding:6px 10px;
  height:auto;max-height:clamp(150px,calc(100vh - 470px),262px);overflow-y:auto;overflow-x:hidden
}
.hand.stacked .hstack{flex:0 0 auto;padding:3px 5px 4px}
.hand.stacked .hraw{flex:1 0 100%;margin-top:1px}
.hgroup,.hstack{
  display:flex;flex-direction:column;gap:3px;padding:4px 6px 6px;
  border:1px solid rgba(255,255,255,.10);border-radius:9px;background:rgba(8,20,14,.28)
}
.hgroup-lab{
  font-size:10.5px;color:var(--dim);white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;cursor:pointer
}
.hgroup-lab:hover{color:var(--gold)}
.hgroup-cards{display:flex;gap:2px;flex-wrap:wrap}
.hand.grouped .card{width:32px;height:46px;margin-left:0;border-radius:4px;flex:none}
.hand.grouped .card .corner .cr{font-size:11px}
.hand.grouped .card .corner .cs{font-size:9px}
.hand.grouped .card:hover{transform:translateY(-5px)}
.hand.grouped .card.sel{transform:translateY(-4px);margin-right:0;box-shadow:0 0 0 2px var(--red2)}
/* 摞叠：一摞就是一手牌，牌自上而下错开 14px，只露顶部那一条点数和花色。
   牌由 52×52 收到 52×48、错开由 16 收到 14，一摞十张也就 174px 高，
   三摞并排只占两百来像素，未分组那行自然露得出来。
   鼠标移到某张牌上，它浮到最上层，整张牌就看清了。 */
.hstack-cards{position:relative;width:52px;margin:1px auto 0}
.hand.stacked .card{
  position:absolute;left:0;width:52px;height:48px;margin-left:0;margin-right:0;
  border-radius:4px 4px 6px 6px;box-shadow:0 2px 5px rgba(0,0,0,.45)
}
.hand.stacked .card .corner{
  flex-direction:row;align-items:center;gap:3px;height:11px;
  overflow:hidden;padding:0 0 0 4px
}
.hand.stacked .card .corner .cr{font-size:11px;line-height:11px}
.hand.stacked .card .corner .cs{font-size:9px;line-height:11px}
.hand.stacked .card .bdg{top:auto;bottom:2px;left:auto;right:2px}
.hand.stacked .card:hover{transform:translateX(3px)}
.hand.stacked .card.sel{transform:translateX(3px);margin-left:0;margin-right:0;box-shadow:0 0 0 2px var(--red2)}
.mine-acts{display:flex;gap:9px;align-items:center}
.hint{font-size:11.5px;color:var(--dim2);white-space:nowrap}
/* 手动组牌工具条：不占额外行高，就摆在手牌信息这一行的中间 */
.group-tools{display:flex;gap:6px;flex:none;align-items:center}
.group-tools .gt{padding:4px 9px;font-size:11.5px;white-space:nowrap;border-radius:7px}
.group-tools .gt:disabled{opacity:.36;cursor:not-allowed}
.group-tools .gt.on{color:var(--gold);border-color:#5a4718;background:#241f12}
/* 把牌拖到别的摞上时高亮目标；拖到空白处提示"新建一摞" */
.hgroup.hg-target,.hstack.hg-target,.hraw.hg-target{
  border-color:#e8c34a;background:rgba(88,70,20,.45);
  box-shadow:0 0 0 1px rgba(232,195,74,.55)
}
/* 未分组：老板自己组过之后，剩下没组的牌横跨整行、按点数摊开摆着。
   程序不再替他拆连对、对子、钢板，等他自己挑或者干脆不组。 */
.hraw{
  grid-column:1/-1;border:1px dashed rgba(232,195,74,.42);border-left:3px solid rgba(232,195,74,.55);
  border-radius:9px;background:rgba(30,34,20,.5);padding:5px 8px 7px
}
.hraw-lab{
  font-size:10.5px;color:#c9b98a;white-space:nowrap;overflow:hidden;
  text-overflow:ellipsis;cursor:default
}
.hraw-lab b{color:var(--gold);font-weight:700}
.hraw-cards{display:flex;gap:2px;flex-wrap:wrap;padding-top:3px;align-items:flex-start}
.hand .hraw .card{
  position:relative;width:32px;height:46px;margin:0;border-radius:4px;flex:none;
  box-shadow:0 2px 5px rgba(0,0,0,.35)
}
.hand .hraw .card .corner{
  flex-direction:column;align-items:center;gap:1px;height:auto;padding:0;overflow:visible
}
.hand .hraw .card .corner .cr{font-size:11px;line-height:normal}
.hand .hraw .card .corner .cs{font-size:9px;line-height:normal}
.hand .hraw .card .bdg{bottom:auto;top:2px;left:auto;right:2px}
.hand .hraw .card:hover{transform:translateY(-5px)}
.hand .hraw .card.sel{transform:translateY(-4px);box-shadow:0 0 0 2px var(--red2)}
.hand .hraw .card.drag{transform:translateY(-12px) scale(1.06);opacity:.9;z-index:99}
.hand.hg-new{background:rgba(232,195,74,.07)}
.hand.grouped .card.drag,.hand.stacked .card.drag{
  transform:translateY(-12px) scale(1.06);opacity:.9;z-index:99
}

/* ============ 教学面板 ============ */
#panel{
  grid-area:panel;background:var(--panel);border-left:1px solid var(--line);
  overflow-y:auto;overflow-x:hidden
}
.p-head{
  position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:8px;
  padding:11px 14px;background:linear-gradient(180deg,#1b2431,#161d26);border-bottom:1px solid var(--line)
}
.p-head h2{font-size:14px;font-weight:700}
.p-head .x{margin-left:auto;color:var(--dim);font-size:17px;line-height:1;padding:2px 6px;border-radius:6px}
.p-head .x:hover{background:#2a3543;color:var(--fg)}
.pause-note{font-size:11px;color:var(--gold);margin-left:auto}
.sec{padding:11px 14px;border-bottom:1px solid #1c242f}
.sec>h3{
  font-size:11.5px;font-weight:700;color:var(--dim);letter-spacing:1.2px;
  margin-bottom:8px;display:flex;align-items:center;gap:7px
}
.sec>h3::before{content:"";width:3px;height:12px;border-radius:2px;background:var(--gold)}
.sec>h3 .n{margin-left:auto;font-weight:400;letter-spacing:0;color:var(--dim2);font-size:11px}
.kv{display:grid;grid-template-columns:auto 1fr;gap:3px 10px;font-size:12.5px}
.kv dt{color:var(--dim2)}
.kv dd{color:var(--fg);text-align:right}
.kv dd.good{color:var(--green)}
.kv dd.warn{color:var(--gold)}
.kv dd.bad{color:var(--red2)}
table.mini{width:100%;border-collapse:collapse;font-size:12px;margin-top:10px}
table.mini th{color:var(--dim2);font-weight:500;text-align:right;padding:2px 0;font-size:11px}
table.mini th:first-child{text-align:left}
table.mini td{padding:2px 0;text-align:right;border-top:1px solid #1a212b}
table.mini td:first-child{text-align:left;color:var(--dim)}
table.mini tr.me td{color:var(--fg);font-weight:600}
.tagline{font-size:12px;color:var(--dim);line-height:1.7}
.strategy{
  margin-top:9px;padding:8px 11px;border-radius:9px;font-size:12.5px;line-height:1.65;
  background:linear-gradient(180deg,#1f2a20,#1a241c);border:1px solid #2c4433;color:#c9e6d2
}
.strategy.atk{background:linear-gradient(180deg,#2a2018,#241b14);border-color:#5a3f26;color:#f0d4b0}
.strategy.def{background:linear-gradient(180deg,#1a2230,#161d29);border-color:#2b3c58;color:#c3d6ee}
.chips-wrap{display:flex;flex-wrap:wrap;gap:5px}
.gchip{font-size:11.5px;padding:3px 8px;border-radius:7px;background:#1c242f;border:1px solid #263041;color:#c6d3e2;cursor:pointer;transition:.13s}
.gchip:hover{border-color:var(--gold);color:#f4d98a;transform:translateY(-1px)}
.gchip.bomb{background:#3a1f22;border-color:#6a3038;color:#f0b3b8}
.gchip.run{background:#17301f;border-color:#2c5236;color:#a9dcb9}
.gchip.tri{background:#2a2417;border-color:#54432a;color:#e8cd9e}
.gchip.pair{background:#1a2436;border-color:#2c3f5c;color:#a8c4e8}
.gchip.one{background:#20242b;border-color:#2f3540;color:#b7bfc9}
.wildcard-box{background:#221c0e;border:1px solid #4b3c14;border-radius:9px;padding:8px 10px;margin-bottom:8px}
.wildcard-box .wc{display:flex;align-items:flex-start;gap:8px;font-size:12px;margin-bottom:6px}
.wildcard-box .wc .card{flex:none;margin-top:2px}
.wildcard-box .wt{color:#f4d98a;font-weight:600}
.wildcard-box .opts{font-size:11px;color:#cbb87a;line-height:1.75;margin-top:1px}
.plan{
  border:1px solid #253040;border-radius:10px;padding:9px 11px;margin-bottom:8px;
  background:linear-gradient(180deg,#1b2330,#181f2a);cursor:pointer;transition:.14s
}
.plan:hover{border-color:var(--gold);transform:translateX(-2px)}
.plan.p1{border-color:#4a3d1c;background:linear-gradient(180deg,#241e12,#1e1a11)}
.plan-h{display:flex;align-items:center;gap:7px;margin-bottom:5px}
.plan-rank{
  width:19px;height:19px;border-radius:5px;background:#2f3947;color:var(--gold);
  font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex:none
}
.plan.p1 .plan-rank{background:var(--gold);color:#241a05}
.plan-t{font-size:13px;font-weight:700}
.plan-act{margin-left:auto;font-size:10.5px;padding:1px 7px;border-radius:9px;background:#2b3542;color:var(--dim);flex:none}
.plan-act.play{background:#1e3a5f;color:#7db4f0}
.plan-act.pass{background:#3d2a2a;color:#e08585}
.plan-r{font-size:11.5px;color:var(--dim);line-height:1.65}
.plan-c{display:flex;gap:2px;margin-top:6px;flex-wrap:wrap;align-items:center}
.ladder{display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:11px;color:var(--dim2);line-height:1.9}
.ladder .st{background:#1c242f;border:1px solid #263041;padding:1px 6px;border-radius:5px;color:#c6d3e2}
.ladder .gt{color:#4d5867}
.ladder .st.topc{border-color:#7a6320;color:#f4d98a;background:#2a2417}
.log-line{font-size:11px;color:var(--dim2);line-height:1.75;border-top:1px dashed #232c38;padding-top:7px;margin-top:7px}
