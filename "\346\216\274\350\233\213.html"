      cnt[c.rank] = (cnt[c.rank] || 0) + 1;
    }
    var wt = wilds.length;
    for(rank in cnt){
      have = cnt[rank];
      if(have + wt >= 4) add('炸弹 ' + rankLabel(+rank) + '×' + Math.min(have + wt, 8));
      if(have + wt >= 3) add('三张 ' + rankLabel(+rank));
      if(have + wt >= 2) add('对 ' + rankLabel(+rank));
    }
    if(wt >= 3) add('三张 2（顶）');
    if(wt >= 2){ add('对 2（顶）'); add('炸弹 逢人配×' + Math.min(wt, 8)); }
    for(m=1;m<=3;m++){
      rs = enumerateRuns(hand, level, m, m === 1 ? 5 : m === 2 ? 3 : 2, null);
      for(i=0;i<rs.length;i++){
        if(rs[i].cards.indexOf(w) < 0) continue;
        add((m === 1 ? '顺子 ' : m === 2 ? '连对 ' : '钢板 ') + rankLabel(rs[i].start) + '-' + rankLabel(rs[i].top));
      }
    }
    for(s=0;s<4;s++){
      rs = enumerateRuns(hand, level, 1, 5, s);
      for(i=0;i<rs.length;i++) if(rs[i].cards.indexOf(w) >= 0)
        add('同花顺 ' + SUIT_CH[s] + rankLabel(rs[i].start) + '-' + rankLabel(rs[i].top));
    }
