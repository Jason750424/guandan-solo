  var bits = [];
  if(minPair) bits.push('他三带二带出过对子，说明 ' + rankLabel(minPair) + ' 是他最小的对子，领对子时出比它小的就能卡住');
  if(minSingle && maxSingle) bits.push('他出过的单张在 ' + rankLabel(minSingle) + ' 到 ' + rankLabel(maxSingle) + ' 之间');
  if(weakTypes.length) bits.push('他放过 ' + weakTypes.join('、') + '，接着打这个牌型最省');
