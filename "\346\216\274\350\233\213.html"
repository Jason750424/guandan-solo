var STACK_STEP = 14, STACK_H = 48;
function stackedHandHTML(hand){
  var html = '';
  handGroupsOf(hand).forEach(function(g, gi){
    var cards = g.cards || [], n = cards.length;
    if(g.raw){
      /* 未分组的牌不摞起来，按点数横摊一整行，方便一张张挑 */
      html += '<div class="hraw"><div class="hraw-lab" data-raw="1" title="这些牌没分组，按点数摆着；点几张再点【组成一摞】，或直接拖进别的摞">' +
        '<b>' + g.label + '</b></div><div class="hraw-cards">' +
        cards.map(function(c){
          return cardHTML(c, st.level, '')
            .replace('class="card ', 'class="card ' + (sel[c.id] ? 'sel ' : ''))
            .replace('<div ', '<div data-id="' + c.id + '" ');
        }).join('') + '</div></div>';
