/* 每一步的判断依据（2026-11-06 18:05）：四家都显示，不只给我自己。
   理由特别长的那几手，由外面 .rv-act 统一接住自己滚，这儿不再单独限高，
   免得出现两层滚动条，老板不知道该拉哪一个。 */
.rv-act-why{font-size:11.5px;line-height:1.7;margin-top:6px;padding:7px 9px;
  border-left:2px solid #4a7fb5;background:rgba(74,127,181,.10);border-radius:0 6px 6px 0;color:var(--dim)}
.rv-act-why b{display:block;color:#9dc4ea;margin-bottom:3px}
.rv-act-why .rv-warn{display:block;color:#e0b050;margin:3px 0 5px}
.rv-act-prev{font-size:11.5px;color:var(--dim);margin:2px 0 6px;padding-left:2px}
.rv-old{font-size:12.5px;color:var(--dim2);text-align:center;padding:30px 0;line-height:2}

.toast{
  position:fixed;left:50%;top:64px;transform:translateX(-50%);z-index:99;
