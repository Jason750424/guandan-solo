      key2 = p15Rounds(aft2, e.level) * 10 + p15Loose(aft2, e.level);
      if(bKey < 0 || key2 < bKey){ bKey = key2; best = mv2; }
    }
  }
  if(best) return {move:best, code:'L22',
    txt:'下一家（对手）只剩 ' + nr + ' 张，出 ' + best.cards.length + ' 张的' +
