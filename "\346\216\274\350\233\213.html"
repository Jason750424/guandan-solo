    toast('这是一条「不要」的建议，直接点下方「不要」按钮');
  }
});
/* 窗口大小一变（拖动窗口、缩放、换屏），过程框的可视高度跟着变，
   但 scrollTop 还停在上一个尺寸的「最底」，新内容会跑到可视区下面看不见。
   这里在尺寸变化后重新跟到底，保证永远看到最新一手。 */
window.addEventListener('resize', function(){
  var tb = document.querySelector('#center .trick-body');
  if(tb) tb.scrollTop = tb.scrollHeight;
});
document.addEventListener('keydown', function(e){
  /* 浮窗开着的时候，回车/空格不许替你出牌，Esc 已经在上面处理过了 */
  if(lwOn()) return;
  if(e.key === 'Escape'){ togglePanel(false); return; }
  if(e.target.tagName === 'INPUT') return;
  if(e.key === 'Enter' && st.turn === 0) playerPlay();
  else if((e.key === 'Backspace' || e.key === ' ') && st.turn === 0){ e.preventDefault(); playerPass(); }
  else if(e.key === 't' || e.key === 'T') togglePanel();
});

loadPrefs();
newGame();
paintPrefs();
/* 开局默认收起教学面板，牌桌铺满整个宽度。
   老板 2026-11-06 21:14 要求：「把界面打开后默认成这个」，给的是收起状态那张图。
   以前这里是 togglePanel(true)，一打开右边就顶出三分之一，牌桌被挤窄。
   想看局势分析点右上角「教学 / 局势分析」，或者按 T 键，随时能开。 */
togglePanel(false);
setTimeout(function(){ if(st.turn !== 0) scheduleAi(); }, 600);
/* 复盘日志：加载后先恢复上次授权的目录，再每 400 毫秒看一眼牌谱有没有长。
   放在开局之后启动，免得第一次写日志跟发牌抢同一帧。 */
gdLogInit();
/* 窗口缩放 / 面板开合都会改变手牌可用宽度，重算重叠量 */
window.addEventListener('resize', function(){ if(st) renderHand(); });
/* 验收脚本用的钩子（2026-11-07）：局末「继续下一局 / 先复盘」和理牌模式都在这层闭包里，
   外面拿不到 st 和 sortMode。这里开一个小口子，只做三件事：把局面摆到局末、切换理牌模式、
   读当前状态。不参与任何玩法判断，也不改变真实对局的结果。 */
window.__gdRound = {
  state: function(){
    return { phase: st.phase, roundNo: st.roundNo, level: st.level, trickNo: st.trickNo,
             turn: st.turn, leadSeat: st.leadSeat,
             tribute: st.tribute ? st.tribute.note : '',
             hand: st.hands[0].length, sortMode: sortMode, btn: $('btnSort').textContent,
             handsLen: st.hands.map(function(h){ return h.length; }),
             moves: (st.moves || []).length,
             card: !!document.querySelector('.round-end'),
             grouped: $('hand').classList.contains('grouped'),
             stacked: $('hand').classList.contains('stacked') };
  },
  /* 把本局直接判成「我方双下」终局，然后走真实的 endRound()。
     不是摆一张假结算卡：结算、升级、复盘快照、渲染全都是真路径。 */
  /* opts 只给验收脚本用：order 定四家名次、keep 定每家还留几张牌。
     不传 opts 时行为和 11-07 老版本一模一样（我方双下、四家空手），老验收脚本不用改；
     传了才能测到「被双下时我和对家还有剩牌」这种真实局面。 */
  simulateFinish: function(opts){
    var c = R.makeCard(5, 0), cs = [c];
    st.moves = [{ seat:0, type:'play', trickNo:0, cards:cs,
                 info:R.identify(cs, st.level), handLeft:26 }];
    st.decisions = [];
    st.finished = ((opts && opts.order) || [0, 2, 1, 3]).slice();
    var keep = (opts && opts.keep) || [0, 0, 0, 0];
    st.hands = [0, 1, 2, 3].map(function(s){
      var arr = [], n = keep[s] || 0, i;
      for(i = 0; i < n; i++) arr.push(R.makeCard(3 + ((i + s * 3) % 13), (i + s) % 4));
      return arr;
    });
    st.phase = 'roundEnd';
    st.roundResult = null;
    endRound();
    /* 卡片底部那行长字，真实对局里由 decisions 统计出来，这里给一句同样长度的，测排版会不会撑破 */
    if(st.roundResult) st.roundResult.reviewTip = '本局你出了 18 手，6 手跟建议不同';
    renderAll();
  },
  /* 通关画面也归「结束」这一档，验收要能摆到这个状态看四家剩牌。
     只切界面状态，不走升级、不改名次、不参与任何玩法判断。 */
  toMatchOver: function(){
    st.phase = 'matchOver'; st.matchWinner = 0;
    renderAll();
  },
  setSort: function(m){ sortMode = m; myOrder = []; manualMode = false; paintPrefs(); renderHand(); },
  /* 验收脚本专用两个小开关。
     hold(true)：把 AI 按住，一手都不走。
     leadTo(seat)：把出牌权和首出座位按到指定那家，并清掉当前这一轮。
     加它们的原因：先出改成随机之后，所有「点一张牌再点出牌」的脚本
     都有四分之三的概率轮到 AI，接着就点不动、出不了，报出来的错
     看着像功能坏了，其实是脚本没把局面按住。2026-11-07 补。 */
  hold: function(on){ window.__gdTestHold = !!on; },
  leadTo: function(seat){
    /* 先把开局那次已经排上号的 AI 定时器撤掉。
       不撤的话，脚本把出牌权按到 0 号位，620ms 后那个旧定时器照样触发，
       AI 会替玩家把牌打出去一张，后面就变成 26 张、也不轮到你了。 */
    clearTimeout(timer);
    st.turn = seat; st.leadSeat = seat; st.trick = null; st.played = [];
    renderAll();
    if(seat !== 0) scheduleAi();
  },
  /* 按引擎建议替玩家走一手，只给浏览器验收脚本用。
     加它的原因：脚本自己瞎点牌，选中了不合法组合时 playerPlay 会拒掉，
     接着脚本每轮都点同一个「出牌」，局面就永远推不动，看着像产品卡死。
     实测一套复盘验收因此只攒到 2 到 5 手，判据根本测不出来。
     这里只做「把建议的牌选上 + 走真实的 playerPlay」，打牌逻辑一行没动。 */
  autoStep: function(){
    if(st.phase !== 'play' || st.turn !== 0) return false;
    var adv = topAdvice();
    if(adv && adv.action === 'play' && adv.cards && adv.cards.length){
      sel = {};
      adv.cards.forEach(function(c){ sel[c.id] = 1; });
      playerPlay();
      return true;
    }
    sel = {};
    playerPass();
    return true;
  },
  closeReview: function(){ closeReview(); }
};
})();
</script>
