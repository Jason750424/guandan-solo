}
/** 不拆炸、不烧逢人配的干净牌型 */
function p15Clean(e, type){
  return p15Pick(e.moves, function(mv){
    if(type && mv.info.type !== type) return false;
    if(isBombFamily(mv.info.type)) return false;
    if(mv.wilds > 0) return false;
    return breakPenalty(mv, e.hand, e.level, e.ctx) < 120;
  });
}
/** 对家在本轮已经明确不要了 */
function p15PartnerPassed(e){
  var i;
  for(i = 0; i < e.trickLog.length; i++)
    if(e.trickLog[i].seat === e.partner && e.trickLog[i].type === 'pass') return true;
  return false;
}
/** 手里还有没有便宜的牌能压（不用炸、不拆炸） */
function p15HasCheap(e){
  var i, mv;
  for(i = 0; i < e.moves.length; i++){
    mv = e.moves[i];
    if(isBombFamily(mv.info.type)) continue;
    if(breakPenalty(mv, e.hand, e.level, e.ctx) >= 120) continue;
    return true;
  }
  return false;
}

/** 队友出的牌，该不该接过来。
