  best = null;
  for(i = 0; i < e.moves.length; i++){
    mv3 = e.moves[i];
    if(mv3.info.type !== 'SINGLE') continue;
    if(mv3.wilds > 0) continue;
    if(mv3.info.key >= TIER.SMALL) continue;                 /* 王不在这儿烧 */
    if(breakPenalty(mv3, e.hand, e.level, e.ctx) >= 120) continue;
    /* 2026-11-19 第4局68手：级牌是残局唯一能压对手大牌的控牌，探路别动它。
       先记到 trumpBest，只要有普通单张就不排它；一个普通单张都没有才降级用级牌。 */
    if(mv3.cards[0].rank === e.level){
      if(!trumpBest || mv3.info.key > trumpBest.info.key) trumpBest = mv3;
      continue;
    }
    if((rkCnt[mv3.cards[0].rank] || 0) <= 1){
      if(!loneBest || mv3.info.key > loneBest.info.key) loneBest = mv3;
    } else {
