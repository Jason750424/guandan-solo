(function(){
'use strict';
var R = GD;
var st = null, panelOpen = false, sel = {}, timer = null, pauseUntil = 0, selfTestResult = '';
/* 复盘弹层开着的时候把对局真的停住。
   原来只是「AI 不主动出牌」都没做到：复盘开着，电脑还在后台一手一手续打，
   牌谱越复盘越长，老板盯着第 41 手看，画面能被后面的手改掉。
   滑杆的拖动也因此被打断（2026-11-07 定位到）。 */
