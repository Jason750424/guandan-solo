/** 公开信息记牌：只算「未见牌」，一张都不读别人的手牌。 */
function publicInfo(st, seat){
  var level = st.level, i, j, k, used = {};
  function keyOf(c){ return c.joker ? 'J' + c.rank : c.rank + '_' + c.suit; }
  var played = st.played || [], mine = st.hands[seat] || [];
  for(i=0;i<played.length;i++){ k = keyOf(played[i]); used[k] = (used[k]||0)+1; }
  for(i=0;i<mine.length;i++){ k = keyOf(mine[i]); used[k] = (used[k]||0)+1; }
  var templates = [], t, r, s;
  for(s=0;s<4;s++) for(r=2;r<=14;r++) templates.push({rank:r, suit:s, joker:false});
  templates.push({rank:17, suit:0, joker:true}, {rank:16, suit:0, joker:true});
  var unseenKeys = [], rankLeft = {}, jokers = {big:0, small:0}, wildsLeft = 0, trumpLeft = 0;
  for(i=0;i<templates.length;i++){
    t = templates[i];
    var left = 2 - (used[keyOf(t)] || 0);
    if(left < 0) left = 0;
    for(j=0;j<left;j++) unseenKeys.push(cardPower(t, level));
