       L08 把「级牌三条带对」剔掉后候选被剔光，落到评分层改出了唯一的大对子。
       那是拿一对控制牌换三条控制牌，还不如让它出三带二。
       残局（手里 10 张以内）手数比留牌重要，这一段让路，跟 L08 自己在 8 张
       以内整体让路、L22 在残局只管封堵，是同一个口径。
       2026-11-08 再改：上面一刀剔掉把第 34 手弄坏了（打 2，出「三 2 带对 9」
       剩 15 张只要 5 手，剔掉之后退成单张 4♠，白多一手）。所以级牌三条不能一刀切，
       按「还要走几手」分两档：
         剩 5 手以上（开局到中盘）控场牌最值钱，别拿级牌三条当三带二；
         剩 4 手以内已经快收尾，手数压倒一切，照出。
       第 34 手是三 2 带对 9 出完 5 手，放行；第 3 局第 1 手是三 7 带对 2 出完 7 手，拦住。
       K、A 的三条维持老口径（第 23 手：出完剩四个散张再也带不走），不掺这条。
       2026-11-08：p15Rounds 修了炸弹和三带二两处高估，整体下移约 0.9 手，
       这个门槛跟着从 6 调到 5，保持「长路才拦」的原意。 */
    if(mv.info.type === 'TRIPLE_PAIR' && e.singles.length){
      var tpTrip = p15TpRanks(mv, e.level).trip;
      if(tpTrip){
        if(tpTrip !== e.level && rankScore(tpTrip, e.level) >= 13) continue;
        if(tpTrip === e.level &&
           p15Rounds(restAfter(e.hand, mv.cards), e.level) >= 5) continue;
      }
    }
    /* 三带二的带牌不许用登基牌，留着防炸 */
    if(mv.info.type === 'TRIPLE_PAIR'){
      var pairsIn = {}, worst = 0, j;
      for(j = 0; j < mv.cards.length; j++){
        var cc = mv.cards[j];
        if(isWild(cc, e.level)) continue;
        pairsIn[cc.rank] = (pairsIn[cc.rank] || 0) + 1;
      }
      for(var rr in pairsIn){
        if(pairsIn[rr] === 2 && isDengjiRank(+rr, e.level)) worst = 1;
      }
      if(worst) continue;
    }
    aft = restAfter(e.hand, mv.cards);
    rd = p15Rounds(aft, e.level);
    lz = p15LooseWeak(aft, e.level);
    cst = p15DengjiSpent(mv, e.level);
    k = shapeScore(aft, e.level);
    /* 比较顺序：手数 → 用掉几张登基牌 → 弱路散张 → 剩几张 → 余牌结构。
       2026-11-07 18:15 把「用掉几张登基牌」提到散张前面。
       原来是 rd*10 + lz 合成一个 key，散张排在登基牌前面，结果两张牌手数一样时，
       「出掉级牌能少一个散张」这一票直接把级牌投出去了（老板第 9 手那手单张 2）。
       登基牌是唯一能收回牌权的东西，它的代价必须压过「少一个散张」这点收益。
       同时散张改用 p15LooseWeak：级牌孤张、A 孤张、王都不算累赘，
       否则出小牌之后那张级牌孤张会反过来被算成 +1 散张，一进一出差 2 个。 */
    /* 手数并列时，「这一手多走 2 张以上」直接胜出。
       2026-11-08 第 34 手：p15Rounds 修准以后，三 2 带对 9（剩 15 张 5 手）、
       连对 QKA（剩 14 张 5 手）、单张 4♠（剩 19 张 5 手）全被判成 5 手，
       手数这一键彻底分不出高下，于是落到第二键「少用登基牌」，
       单张 4♠ 一张登基牌都不用，直接胜出，一次只走 1 张，牌权白送。
       同样剩 5 手，15 张和 19 张不是一回事：走的牌多，剩的牌就少，离终点更近。
       差 1 张不算，因为手数估算本身有 ±1 的误差，那一张很可能只是拆对子的副产品，
       那种情况交给「用掉几张登基牌」这种硬代价来判才稳。
       反向红线：这条只在手数相等时生效，手数一涨照样被第一键拦住，
       所以它不会把「为了多走几张去拆炸、拆顺子」放出来。 */
    gapWin = (rd === bRounds && best) ? (mv.cards.length - bGap >= 2 ? 1
           : (bGap - mv.cards.length >= 2 ? -1 : 0)) : 0;
    if(rd < bRounds ||
       (rd === bRounds && gapWin > 0) ||
       (rd === bRounds && gapWin === 0 && cst < bCost) ||
       (rd === bRounds && gapWin === 0 && cst === bCost && lz < bLoose) ||
       (rd === bRounds && gapWin === 0 && cst === bCost && lz === bLoose && aft.length < bLen) ||
       (rd === bRounds && gapWin === 0 && cst === bCost && lz === bLoose && aft.length === bLen && k > bShape)){
      bRounds = rd; bCost = cst; bLoose = lz; bLen = aft.length; bShape = k; bGap = mv.cards.length; best = mv;
    }
  }
  if(!best) return null;
  /* 三带二：同一主三条有多个带牌方案时，改挑带牌最小的那个。
     老板 2026-11-06 抓的「3 个 3 带两 A」，本质就是带牌挑了贵的。
     这里不设系数，直接换成手里最便宜的那一对。
     2026-11-08 第 34 手补一条：换带牌不许把手数换多。
     上面 p15FixCarry 已经把候选统一成最便宜的带牌，正常走不到这儿；
     但只要 FixCarry 的手数门槛放行了某个方案，这里就不能再按点数把它换掉，
     否则又是一次「为省一对小牌白扔两手」。 */
  if(best.info.type === 'TRIPLE_PAIR'){
    var bR = p15TpRanks(best, e.level), alt = null, k2, m2, r2,
        bRd2 = p15Rounds(restAfter(e.hand, best.cards), e.level);
    for(k2 = 0; k2 < e.moves.length; k2++){
      m2 = e.moves[k2];
      if(m2.info.type !== 'TRIPLE_PAIR') continue;
      r2 = p15TpRanks(m2, e.level);
      if(r2.trip !== bR.trip || r2.pair === 0) continue;
      if(p15Rounds(restAfter(e.hand, m2.cards), e.level) > bRd2) continue;
      if(r2.pair < (bR.pair || 99)) { bR.pair = r2.pair; alt = m2; }
    }
    if(alt) best = alt;
  }
  var whyTxt;
  if(best.info.type !== 'SINGLE'){
    whyTxt = '这手是手上最省的一手，大牌留着防对手抢牌权';
  }else if(p15DengjiSpent(best, e.level) > 0){
    /* 只剩这一路能走才出登基牌，说清是「没得挑」，不能再说「先走弱路散张」，
       否则文案跟实际出的牌自己打架（老板 2026-11-07 抓的那张单 2 就是这句）。 */
    whyTxt = '除了这张没有更便宜的散张能走，先把它换成一手进度，别的登基牌留着收牌权';
  }else{
    whyTxt = '先把弱路散张走掉，三张、对子和大牌留着后面回收';
  }
  var headTxt = e.dengji.length
    ? ('先出可控牌型：我手上有 ' + e.dengji.length + ' 张登基牌能收回来。')
    : '先出可控牌型：手上没有登基牌，靠减少手数和散张来提速。';
  return {move:best, code:'L08',
    txt:headTxt +
        '这手 ' + TYPE_NAME[best.info.type] + '（' + best.cards.length + ' 张）出完，' +
        '剩下 ' + (e.myRemain - best.cards.length) + ' 张大约还要 ' + bRounds + ' 手走完，' +
        whyTxt};
}

/* ---------- L06 保留多牌震慑 ----------
   残局走不掉时，别先把长牌型打光，留 4 张以上让对手不敢轻易冲刺。 */
function p15L06(e){
  if(!e.isLead || !e.late) return null;
  if(e.role !== 'support') return null;
  if(e.myRemain < 12) return null;            /* 手上没几张了就别装了，该甩就甩 */
  var mv = p15Pick(e.moves, function(m){
    if(isBombFamily(m.info.type)) return false;
    if(m.info.len >= 5) return false;           /* 不先把长牌型打光 */
    if(m.wilds > 0) return false;
    return breakPenalty(m, e.hand, e.level, e.ctx) < 120;
  });
  if(!mv) return null;
  return {move:mv, code:'L06',
    txt:'保留多牌震慑：我这个牌力走不掉，先把长牌型留着，出 ' +
        TYPE_NAME[mv.info.type] + '。手上留着 ' + e.myRemain + ' 张' +
        (e.bombs.length ? '加 ' + e.bombs.length + ' 发炸' : '') +
        '，对手不敢轻易冲刺'};
}

/* 规则按优先级排：先保命（必须拦），再谈章法（怎么领出）。
   顺序有讲究，L15 排第一是因为「到位了别浪费炸」能省下后面所有错误的炸。 */
/* L16（打一放一）暂时不进这条链。原因见函数头的说明：按「助攻 + 对家还有牌」
   实现之后，100 局对打头游率从 55% 掉到 27%，等于把「选择性放行」做成了
   「一律放行」，队伍被拖死。函数留着，等把「放哪一张、留哪一张」判准了再启用。 */
var P15_RULE_FNS = [p15L22, p15L15, p15L03, p15L07, p15L12, p15L01, p15L21, p15L09, p15L08, p15L06];

/** 过一遍规则层。命中返回 {move, code, txt} 或 {pass:true, code, txt}，都没中返回 null。 */
function p15RuleDecide(st, seat, moves, ctx){
  var e = p15Env(st, seat, moves, ctx), i, r;
  for(i = 0; i < P15_RULE_FNS.length; i++){
    r = P15_RULE_FNS[i](e);
    if(!r) continue;
    if(r.pass && e.isLead) continue;             /* 领出阶段不许过牌，这条规则在这儿不成立 */
    if(r.move){
      var ok = false, k;
      for(k = 0; k < moves.length; k++) if(moves[k] === r.move){ ok = true; break; }
      if(!ok) continue;                          /* 兜底：规则挑的牌必须真在候选里 */
    }
    return r;
  }
  return null;
}

function chooseAction(st, seat){
  var hand = st.hands[seat], level = st.level, partner = partnerOf(seat), i;
  var moves = legalMoves(st, seat);
  /* 三带二的带牌先统一换最便宜的那一对。放在最前面，后面无论走规则层还是评分兜底，
     带牌都不会再挑大牌（老板抓的「3 个 3 带两 A」「3 个 4 带两 2」都出自这里）。 */
  for(i = 0; i < moves.length; i++) moves[i] = p15FixCarry(moves[i], hand, level);
  var D = diffOf(st);
  var ctx = makeCtx(st, seat);   /* AI 与教学面板共用同一套公开信息上下文 */
  /* 0) 简单档：一定概率不算分，随手甩一手合法牌出去（规则仍然合法，只是不讲章法） */
  var rndPick = st.rng || Math.random;
  if(D.rand && moves.length && rndPick() < D.rand){
    var rnd = moves[Math.floor(rndPick() * moves.length)];
    return {type:'play', cards:rnd.cards, info:rnd.info, reason:'随手出一手（简单档：这一步没细算）'};
  }
  /* 1) 能一把走完就走 */
  for(i=0;i<moves.length;i++){
    if(moves[i].cards.length === hand.length)
      return {type:'play', cards:moves[i].cards, info:moves[i].info, reason:'一把走完，抢头游'};
  }
  /* 1b) 送对家优先于规则层。P15 的 B7「获出牌权后打对家需要的牌型」是助攻的核心动作，
         比「先出可控牌型」更该先判。条件是队友还在（剩牌 > 0）且快走完。
         队友已经走完（剩 0 张）不进这个分支，那是 76 手那个 bug 的根源。 */
  if(!st.trick && ctx.partnerRemain > 0 && ctx.partnerRemain <= D.feed && ctx.partnerRemain <= ctx.minOpp){
    var feed0 = pickFeedPartner(st, seat, moves);
    if(feed0 && feed0.ok)
      return {type:'play', cards:feed0.cards, info:feed0.info, reason:
        '送对家（依据 B7）：他只剩 ' + ctx.partnerRemain + ' 张且领先。按已出的牌算，外面比这张 ' +
        cardsLabel(feed0.cards, level) + ' 大的还有 ' + feed0.bigger + ' 张，摊到他手里大约 ' +
        feed0.expect.toFixed(1) + ' 张，接得住的把握不小。他接过去拿到主动权一口气走完，他头游你稳拿二游'};
  }
  /* 1c) P15 规则层：课程 32 条里能靠公开信息判出来的先过一遍。
         命中就按规则打，理由里带编号，复盘时能直接对上课程第几条。
         一条都不命中才往下走评分兜底。简单档不过这一层，方便对照。 */
  var p15r = D.pro ? p15RuleDecide(st, seat, moves, ctx) : null;
  if(p15r){
    if(p15r.pass)
      return {type:'pass', reason:p15r.txt + '（依据 ' + p15r.code + '）'};
    /* ---- 规则层挑的是炸，但手里有普通牌能压：换成普通牌 ----
       「必须拦」管的是「不能让对手拿牌权」，不是「必须用炸」。
       拦得住的方式里有便宜的，就必须用便宜的那种。
       老板 2026-11-07 第 11 手：对家用 4 张 5 做炸去压上家的单 6，炸完手里剩一张孤 5，
       一手控制牌换成一张散牌；而桌面上单 K 就能把这轮拦下来。
       放在规则层出口统一拦一次，L03 / L07 / L12 / L13 / L15 这几条一起管住，
       不用去五个函数里各写一遍，也不会漏。
       挑哪张：非炸、不用级牌和王，按 followScore 取最高的那张，和后面的评分兜底同一个口径。 */
    if(isBombFamily(p15r.move.info.type) && st.trick){
      var cover = null, coverS = -1e9, ci, cm, cs;
      if(ctx.oppRemain === undefined)
        ctx.oppRemain = (st.hands[st.trick.seat] || []).length;
      for(ci = 0; ci < moves.length; ci++){
        cm = moves[ci];
        if(isBombFamily(cm.info.type)) continue;
        if(cm.info.key >= TIER.TRUMP) continue;
        cs = followScore(cm, hand, level, ctx);
        if(cs > coverS){ coverS = cs; cover = cm; }
      }
      if(cover){
        /* 这一手如果拦不住，别拿最小的散张凑数（判据见 p15LoneSend）。
           老板 2026-11-07 第 11 手走的就是这条路：L03 命中，规则层直接返回，
           所以只改评分兜底那一处，真机上的行为一点没变。 */
        if(isCutOut(hand, cover) || isControlSingle(cover, ctx)){
          var lc = p15LoneSend(hand, moves, ctx, level);
          if(lc) cover = lc;
        }
        return {type:'play', cards:cover.cards, info:cover.info,
                reason:p15r.txt + '（依据 ' + p15r.code + '）。不过手里有 ' +
                       cardsLabel(cover.cards, level) + ' 就能把这轮拦住，用普通牌拦，不动炸弹' +
                       sealNote(ctx, cover.info, level)};
      }
    }
    return {type:'play', cards:p15r.move.cards, info:p15r.move.info,
            reason:p15r.txt + '（依据 ' + p15r.code + '）'};
  }
  /* 2) 领出 */
  if(!st.trick){
    /* 2a) 队友快走完且领先 → 送对家：领一张小牌把主动权让给他。
       挑哪张只按公开信息估，不看队友的具体手牌。领出阶段不能过牌，送不了就退回常规领出。
       2026-11-06 20:05 修一个每局都踩的硬 bug：队友已经走完（剩 0 张）时，旧条件
       「0 <= 7 且 0 <= 对手最少剩牌」百分百成立，于是每次接风都先进送牌分支，
       送不出去就退回「出最小单张」，把 3 个 3 带两 5 这种能一次走 5 张的牌拆掉。
       老板抓的第 76 手就是这个。加一条 partnerRemain > 0。 */
    if(ctx.partnerRemain > 0 && ctx.partnerRemain <= D.feed && ctx.partnerRemain <= ctx.minOpp){
      var feed = pickFeedPartner(st, seat, moves);
      if(feed && feed.ok){
        return {type:'play', cards:feed.cards, info:feed.info, reason:
          '送对家：他只剩 ' + ctx.partnerRemain + ' 张且领先。按已出的牌算，外面比这张 ' +
          cardsLabel(feed.cards, level) + ' 大的还有 ' + feed.bigger + ' 张，摊到他手里大约 ' +
          feed.expect.toFixed(1) + ' 张，接得住的把握不小。他接过去拿到主动权一口气走完，他头游你稳拿二游'};
      }
      /* feed.ok === false：外面能压的大牌已经不多，硬送反而白送一轮，
         领出阶段又不能过牌，所以退回常规领出（挑最省的一张），
         理由写清为什么不送，教学面板才读得出这个判断。*/
      if(feed && !feed.ok){
        var cheapest = null;
        for(i=0;i<moves.length;i++){
          if(moves[i].info.type !== 'SINGLE') continue;
          if(breakPenalty(moves[i], hand, level, ctx) >= 120) continue;   /* 探路也不许拆炸 */
          if(p15SplitSmallPair(moves[i], hand, level)) continue;           /* 探路也不许拆小对子 */
          /* 残局「一对+孤张」：探路别拆那对，先探孤张（2026-11-18 第66手） */
          if(hand.length <= 5 && p15ProbeSplitPair(moves[i], hand, level)) continue;
          if(!cheapest || moves[i].info.key < cheapest.info.key) cheapest = moves[i];
        }
        /* 找不到干净的单张就不在这儿硬出，往下走常规领出：那边会连整发炸一起算。
           剩下的单张只有王，也不从这儿出（2026-11-06 20:56：剩 5 张探路直接甩小王那次）。 */
        if(cheapest && cheapest.info.key < TIER.SMALL) return {type:'play', cards:cheapest.cards, info:cheapest.info, reason:
          '不送对家（外面比最小牌大的只剩 ' + feed.bigger + ' 张，他未必接得住）：' +
          '硬塞小牌等于让他白接一轮、主动权反落到对手手里。改出 ' +
          cardsLabel(cheapest.cards, level) + ' 探路（挑干净的那张，别拆对子留着回手），等他或对手先动。'};
      }
    }
    /* 领出也要守「不许拆炸」这条：先只在「不拆炸」的候选里挑，
       一个都不剩（手上除了拆炸没别的牌型可走）才退回原评分。
       2026-11-06 全局扫描抓到的：手里 4 张 4 还有一堆散牌，领出偏偏走单张 4，
       把 4444 拆成 4 加三张散牌，纯粹是评分里「单张越小越省」压过了拆炸的代价。 */
    /* 领出的兜底层也守同一条：手里还有别的牌能出，就不甩单张王。
       规则层已经拦过一遍，这里管评分兜底那一路。
       2026-11-06 20:56 扫描只剩 1 例：剩 11 张领出小王，理由是「领出最小的一张，保留实力」。 */
    var p15NoWildWaste = false, q0;
    for(q0 = 0; q0 < moves.length; q0++){ if(!moves[q0].wilds){ p15NoWildWaste = true; break; } }
    var leadGate = false, q, qm;
    for(q = 0; q < moves.length; q++){
      qm = moves[q];
      if(qm.info.type === 'SINGLE' && qm.info.key >= TIER.SMALL) continue;
      if(breakPenalty(qm, hand, level, ctx) >= 120) continue;
      leadGate = true; break;
    }
    /* 残局领出（12 张以内）统一用「真实破型成本」这一套口径：
       把 breakPenalty 里重复计的那部分补回来，真拆四张炸的候选直接排除。
       开中盘（13 张以上）一个字不动，仍按原来的严格档 / 放宽档两级走。
