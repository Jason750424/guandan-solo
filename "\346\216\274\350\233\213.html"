     直接 requestPermission，已经在授权状态时会立刻返回 granted，不弹框。 */
  var p = (fromGesture && h.requestPermission) ? h.requestPermission({mode:'readwrite'})
        : (h.queryPermission ? h.queryPermission({mode:'readwrite'}) : Promise.resolve('granted'));
  return Promise.resolve(p).then(function(r){
    gdLogPerm = r; gdLogErr = '';
    if(r === 'granted'){ gdLogSaveHandle(h); gdLogWrite(); }
    gdLogPaint();
    return r;
  }).catch(function(err){
    gdLogErr = (err && err.message) || String(err); gdLogPerm = 'none'; gdLogPaint();
    return 'none';
  });
}
