  publicInfo:publicInfo, shapeScore:shapeScore, makeCtx:makeCtx,
  memoRows:memoRows, bombThreat:bombThreat, raceInfo:raceInfo,
  /* P15 策略层（全局透视思维）：牌力评分 / 角色 / 记牌上限 / 报牌推断 / 残局原则 */
  powerDetail:powerDetail, powerScore:powerScore, shapeFit:shapeFit, scoreBand:scoreBand,
  selfRole:selfRole, doubleLoseAdjust:doubleLoseAdjust, seatRole:seatRole, leadLog:leadLog,
  bigMemoWho:bigMemoWho, ceilingOf:ceilingOf, inferShape:inferShape, defenseInfo:defenseInfo,
  flushVerdict:flushVerdict, lateHits:lateHits, lateLeadTaste:lateLeadTaste, reachedHome:reachedHome,
  teach:teach, runSelfTest:runSelfTest, runRuleTests:runRuleTests, runLevelTests:runLevelTests,
  runFlowTests:runFlowTests
};
})();
if (typeof module !== 'undefined' && module.exports) module.exports = GD;
if (typeof globalThis !== 'undefined') globalThis.GD = GD;
