        .replace('<div ', '<div data-id="' + c.id + '" ');
    }).join('');
    if(g.raw){
      html += '<div class="hraw"><div class="hraw-lab" data-raw="1" title="这些牌没分组，按点数摆着；点几张再点【组成一摞】，或直接拖进别的摞">' +
        '<b>' + g.label + '</b></div><div class="hraw-cards">' + cardsHTML + '</div></div>';
      return;
    }
    html += '<div class="hgroup"><div class="hgroup-lab" data-hg="' + gi +
      '" title="点一下自动选中这一组">' + g.label + '</div>' +
      '<div class="hgroup-cards">' + cardsHTML + '</div></div>';
