  };
  run();
}
/* 目录句柄存 IndexedDB，刷新页面不用重选 */
function gdLogIdb(cb){
  if(!window.indexedDB){ cb(new Error('没有 IndexedDB')); return; }
  try{
    var req = indexedDB.open('gdLogDirDb', 1);
    req.onupgradeneeded = function(){ try{ req.result.createObjectStore('kv'); }catch(e){} };
    req.onsuccess = function(){ cb(null, req.result); };
    req.onerror = function(){ cb(req.error || new Error('IndexedDB 打不开')); };
  }catch(e){ cb(e); }
}
function gdLogSaveHandle(h){
  gdLogIdb(function(e, db){
    if(e || !db) return;
    try{
      var tx = db.transaction('kv', 'readwrite');
      tx.objectStore('kv').put(h, 'dir');
      tx.oncomplete = function(){ db.close(); };
      tx.onerror = function(){ db.close(); };
    }catch(err){ db.close(); }
  });
}
function gdLogRestore(){
  gdLogIdb(function(e, db){
    if(e || !db) return;
    try{
      var tx = db.transaction('kv', 'readonly'), q = tx.objectStore('kv').get('dir');
      q.onsuccess = function(){
        var h = q.result; db.close();
        /* IndexedDB 里可能留着旧版或验收用的坏句柄，先验一下再用，别把状态显示成已落盘 */
        if(h && typeof h.queryPermission === 'function' && typeof h.getFileHandle === 'function')
          gdLogSetHandle(h, false);
      };
      q.onerror = function(){ db.close(); };
    }catch(err){ db.close(); }
  });
}
function gdLogSetHandle(h, fromGesture){
  gdLogDir = h;
