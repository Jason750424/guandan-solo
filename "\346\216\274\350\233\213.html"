      if(mvB.info.type !== 'SINGLE' || mvB.wilds > 0) continue;
      if(mvB.info.key >= TIER.SMALL) continue;
      if(breakPenalty(mvB, e.hand, e.level, e.ctx) >= 120) continue;
      if(rankScore(mvB.cards[0].rank, e.level) > 8) continue;   /* 大单张自己能保权，留给 ② */
      if(!tiny2 || mvB.info.key < tiny2.info.key) tiny2 = mvB;
