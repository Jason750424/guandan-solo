  setVar(HAND.CARD);
  /* 最小牌宽仍装不下 → 横向滚动兜底 */
  hand.style.overflowX = need(HAND.CARD, step) > avail ? 'auto' : 'hidden';
  hand.style.justifyContent = need(HAND.CARD, step) > avail ? 'flex-start' : 'center';
